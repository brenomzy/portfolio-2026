---
import { ABOUT } from "../lib/about";
---

<section class="c-about" id="about" aria-label="About">
	<div class="c-about__inner">
			<h2
				class="c-about__title js-about-title"
				data-reveal
				aria-label={`${ABOUT.home.titleLineOne} ${ABOUT.home.titleLineTwo}`}
			>
				<span class="c-about__title-line js-about-title-line" aria-hidden="true">
					{ABOUT.home.titleLineOne}
				</span>
				<span class="c-about__title-row" aria-hidden="true">
					<span class="c-about__portrait" aria-hidden="true">
						{
							[1, 2, 3, 4].map((option) => (
								<span class="c-about__portrait-frame">
									<img
										class="c-about__portrait-image c-about__portrait-image--light"
										src={`/pixel-images/pixel-sunset-option-${option}-150x86.png`}
										alt=""
										width="150"
										height="86"
										loading="lazy"
									/>
									<img
										class="c-about__portrait-image c-about__portrait-image--dark"
										src={`/pixel-images/night-moon-option-${option}-150x86.png`}
										alt=""
										width="150"
										height="86"
										loading="lazy"
									/>
								</span>
							))
						}
					</span>
					<span class="c-about__title-line js-about-title-line">
						{ABOUT.home.titleLineTwo}
					</span>
				</span>
			</h2>

			<div class="c-about__details js-about-details" data-reveal>
				<p class="c-about__lead">{ABOUT.home.lead}</p>
				<p class="c-about__body">{ABOUT.home.body}</p>

				<a class="c-about__more" href="/about">
					More about me
					<svg class="c-about__arrow" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
						<path d="M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z" />
					</svg>
				</a>
			</div>
	</div>
</section>

<style>
	.c-about {
		width: 100%;
		padding-block: var(--spacing-3xl);
		background: transparent;
		color: var(--text);
		border-top: 1px solid var(--grid-line);
	}
	.c-about__inner {
		max-width: var(--container-content);
		margin-inline: auto;
		padding-inline: var(--home-gutter, var(--spacing-m));
		min-width: 0;
	}
	.c-about__title {
		display: grid;
		font-size: clamp(3.25rem, 7.6vw, 7.5rem);
		font-weight: 600;
		line-height: 0.84;
		letter-spacing: -0.065em;
	}
	.c-about__title-line {
		display: block;
		padding-block: 0.04em 0.08em;
		will-change: transform, opacity, filter;
	}
	.c-about__title-row {
		display: flex;
		align-items: flex-end;
		gap: var(--portrait-gap, 0.16em);
		min-width: 0;
	}
	.c-about__portrait {
		position: relative;
		flex: 0 0 var(--portrait-width, 1.25em);
		width: var(--portrait-width, 1.25em);
		height: 0.72em;
		margin-bottom: 0.08em;
		overflow: hidden;
		border-radius: 0.25rem;
		background: var(--thumb-bg);
		box-shadow: var(--shadow-1);
		will-change: clip-path, opacity;
	}
	.c-about__portrait-frame {
		position: absolute;
		inset: 0;
		border-radius: inherit;
		overflow: hidden;
		opacity: 0;
		animation: portrait-crossfade 16s linear infinite;
	}
	.c-about__portrait-image {
		width: 100%;
		height: 100%;
		border-radius: inherit;
		object-fit: cover;
		image-rendering: pixelated;
		outline: 1px solid rgb(0 0 0 / 0.1);
		outline-offset: -1px;
	}
	.c-about__portrait-frame:nth-child(1) {
		opacity: 1;
	}
	.c-about__portrait-frame:nth-child(2) {
		animation-delay: -12s;
	}
	.c-about__portrait-frame:nth-child(3) {
		animation-delay: -8s;
	}
	.c-about__portrait-frame:nth-child(4) {
		animation-delay: -4s;
	}
	.c-about__portrait-image--dark {
		display: none;
	}
	@keyframes portrait-crossfade {
		0%,
		21.25% {
			opacity: 1;
		}
		25%,
		96.25% {
			opacity: 0;
		}
		100% {
			opacity: 1;
		}
	}
	:global([data-theme="dark"]) .c-about__portrait-image--light {
		display: none;
	}
	:global([data-theme="dark"]) .c-about__portrait-image--dark {
		display: block;
	}
	:global([data-theme="dark"]) .c-about__portrait-image {
		outline-color: rgb(255 255 255 / 0.1);
	}
	@media (prefers-reduced-motion: reduce) {
		.c-about__portrait-frame {
			animation: none;
			opacity: 0;
		}
		.c-about__portrait-frame:first-child {
			opacity: 1;
		}
	}
	.c-about__details {
		display: grid;
		gap: var(--spacing-s);
		max-width: 48rem;
		margin-top: var(--spacing-xl);
	}
	.c-about__lead {
		max-width: 58ch;
		font-weight: 600;
		line-height: 1.45;
	}
	.c-about__body {
		max-width: 62ch;
		color: var(--text-muted);
	}
	.c-about__more {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		width: fit-content;
		font-size: var(--text-step--1);
		font-weight: 560;
		text-decoration: none;
		color: inherit;
	}
	.c-about__arrow {
		width: 1.05em;
		height: 1.05em;
		transition: transform 0.3s var(--ease-out-expo);
	}
	@media (hover: hover) and (prefers-reduced-motion: no-preference) {
		.c-about__more:is(:hover, :focus-visible) {
			color: var(--accent-ink);
		}
		.c-about__more:is(:hover, :focus-visible) .c-about__arrow {
			transform: translateX(0.2em);
		}
	}
	@media (max-width: 52rem) {
		.c-about__title {
			font-size: clamp(3rem, 12.5vw, 6rem);
		}
		.c-about__details {
			margin-top: var(--spacing-l);
		}
	}
	@media (max-width: 30rem) {
		.c-about__title {
			font-size: clamp(2.65rem, 12vw, 4rem);
		}
		.c-about__title-row {
			--portrait-width: 1.18em;
			--portrait-gap: 0.14em;
		}
	}
</style>

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";
	import { SplitText } from "gsap/SplitText";
	import { CustomEase } from "gsap/CustomEase";
	import { whenRevealable } from "../lib/page-reveal";

	gsap.registerPlugin(ScrollTrigger, SplitText, CustomEase);
	const EASE_OUT =
		CustomEase.get("brand-out") ?? CustomEase.create("brand-out", "0.16,1,0.3,1");

	let context: gsap.Context | null = null;
	let generation = 0;
	let titleSplits: SplitText[] = [];

	function cleanup() {
		generation += 1;
		context?.revert();
		context = null;
		titleSplits.forEach((split) => split.revert());
		titleSplits = [];
	}

	async function setup() {
		cleanup();
		const currentGeneration = generation;
		const section = document.querySelector<HTMLElement>(".c-about");
		if (!section) return;

		await whenRevealable();
		if (currentGeneration !== generation || !document.contains(section)) return;
		await Promise.race([
			document.fonts.ready,
			new Promise((resolve) => window.setTimeout(resolve, 1200)),
		]);
		if (currentGeneration !== generation || !document.contains(section)) return;

		context = gsap.context(() => {
			const titleLines = gsap.utils.toArray<HTMLElement>(".js-about-title-line");
			const portrait = section.querySelector<HTMLElement>(".c-about__portrait");
			const titleRow = section.querySelector<HTMLElement>(".c-about__title-row");
			const details = section.querySelector<HTMLElement>(".c-about__details");
			const revealItems = [details].filter(Boolean) as HTMLElement[];
			const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
			titleSplits = titleLines.map((line) =>
				SplitText.create(line, { type: "words" }),
			);
			const words = titleSplits.flatMap((split) => split.words);

			gsap.set([section.querySelector(".c-about__title"), ...revealItems], {
				visibility: "visible",
			});

			if (reduced) {
				gsap.set([...words, portrait, ...revealItems].filter(Boolean), {
					autoAlpha: 1,
					y: 0,
					clipPath: "inset(0% 0% 0% 0%)",
				});
				return;
			}

			gsap.set(words, { autoAlpha: 0, y: 20, filter: "blur(10px)" });
			gsap.set(titleRow, { "--portrait-width": "0em", "--portrait-gap": "0em" });
			gsap.set(portrait, { autoAlpha: 0, clipPath: "inset(0% 100% 0% 0%)" });
			gsap.set(revealItems, { autoAlpha: 0, y: 24, filter: "blur(8px)" });

			const timeline = gsap.timeline({ paused: true });
			timeline
				.to(words, {
					autoAlpha: 1,
					y: 0,
					filter: "blur(0px)",
					duration: 0.9,
					ease: "power2.out",
					stagger: { amount: 0.42 },
				})
				.to(
					titleRow,
					{
						"--portrait-width": () =>
							matchMedia("(max-width: 30rem)").matches ? "1.18em" : "1.25em",
						"--portrait-gap": () =>
							matchMedia("(max-width: 30rem)").matches ? "0.14em" : "0.16em",
						duration: 0.72,
						ease: "power3.inOut",
					},
					0.9,
				)
				.to(
					portrait,
					{
						autoAlpha: 1,
						clipPath: "inset(0% 0% 0% 0%)",
						duration: 0.72,
						ease: EASE_OUT,
					},
					0.94,
				)
				.to(
					revealItems,
					{
						autoAlpha: 1,
						y: 0,
						filter: "blur(0px)",
						duration: 0.7,
						ease: "power2.out",
						stagger: 0.12,
					},
					1.12,
				);

			ScrollTrigger.create({
				trigger: section,
				start: "top 78%",
				once: true,
				onEnter: () => timeline.play(),
			});
		}, section);
		ScrollTrigger.refresh();
	}

	document.addEventListener("astro:page-load", setup);
	document.addEventListener("astro:before-swap", cleanup);
</script>
