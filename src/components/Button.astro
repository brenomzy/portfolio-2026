---
/*
 * c-button — CTA, adapted from Osmo Supply "button-023" then reworked.
 *
 * Renders an <a> when `href` is passed, otherwise a <button>.
 * Colors are wired to our theme tokens via local --btn-* vars, so the button
 * follows light/dark automatically. See Design.md → Buttons for the rationale.
 *
 * A single label sits above a two-panel background. On hover the panels wipe
 * up diagonally — a leading "flash" panel then the fill — and the label color
 * crosses over. One label element (not two): premium > playful.
 *
 * Three tiers (see Design.md → Buttons):
 *   - primary   white → orange flash → black   (= the original Osmo default)
 *   - secondary black → orange flash → white   (the inverse)
 *   - accent    orange → black            (calm, for nav/CTA; no orange flash)
 * Buttons are theme-independent objects (constant paper/ink), each self-defined
 * by a faint border so it stays legible on any background in either theme.
 */
interface Props {
	label: string;
	href?: string;
	variant?: "primary" | "secondary" | "accent" | "solid" | "ghost" | "link";
	type?: "button" | "submit" | "reset";
	/* Append the external-link arrow (Phosphor "arrow-up-right", bold-faked with a
	 * stroke like the theme toggle). Pairs with variant="link" for a tertiary CTA. */
	icon?: boolean;
	class?: string;
	[key: string]: unknown;
}

const {
	label,
	href,
	variant = "primary",
	type = "button",
	icon = false,
	class: className,
	...rest
} = Astro.props;

const Tag = href ? "a" : "button";
---

<Tag
	class:list={["c-button", className]}
	data-variant={variant}
	href={href}
	type={href ? undefined : type}
	{...rest}
>
	<span class="c-button__bg" aria-hidden="true">
		<span style="--index: 0;" class="c-button__bg-layer is--first"></span>
		<span style="--index: 1;" class="c-button__bg-layer is--second"></span>
	</span>
	<span class="c-button__label">
		{label}
		{
			icon && (
				<svg
					class="c-button__icon"
					viewBox="0 0 256 256"
					fill="currentColor"
					stroke="currentColor"
					stroke-width="8"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M200,64V168a8,8,0,0,1-16,0V83.31L69.66,197.66a8,8,0,0,1-11.32-11.32L172.69,72H88a8,8,0,0,1,0-16H192A8,8,0,0,1,200,64Z" />
				</svg>
			)
		}
	</span>
</Tag>

<style>
	.c-button {
		/* Brand constants — warm white + warm near-black, the same in both themes. */
		--btn-paper: hsl(38 44% 97%);
		--btn-ink: hsl(24 15% 11%);

		/* Primary (default): ORANGE rest → theme fill on hover (dark in light /
		 * light in dark). Orange is already the rest colour, so there's no orange
		 * "flash" panel — both panels are the theme fill (--text); the label
		 * crosses warm-white → page-colour. The loud CTA. */
		--btn-bg: var(--accent);
		--btn-text: var(--btn-paper); /* warm white on orange */
		--btn-edge: var(--text); /* no flash — both panels are the theme fill */
		--btn-fill: var(--text);
		--btn-hover-text: var(--bg);
		--btn-focus: var(--text);

		/* Shape & spacing — em-based so it scales with font-size (0.75rem). */
		--btn-padding: 1em 1.65em;
		--btn-radius: var(--radius-sm);
		--btn-focus-inset: -0.25em;

		/* Motion — one smooth ease, no overshoot. Serious, not springy.
		 * cubic-bezier(0.32, 0.72, 0, 1) is the premium iOS/Vercel curve. The
		 * press is asymmetric: snappy scale-down for instant tactile feedback
		 * (~100ms, per the animation-design skill), smooth settle on release. */
		--btn-click-scale: 0.96;
		--btn-ease: cubic-bezier(0.32, 0.72, 0, 1);

		color: var(--btn-text);
		-webkit-user-select: none;
		user-select: none;
		background-color: transparent;
		outline: none;
		border: none;
		padding: 0;
		font: inherit;
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		line-height: 1;
		text-decoration: none;
		cursor: pointer;
		display: inline-grid;
		position: relative;
		-webkit-tap-highlight-color: transparent;
		/* Release settle. The press-in duration is overridden on :active below. */
		transition: scale 0.3s var(--btn-ease);
	}

	/* Focus ring lives on ::after so it sits outside the clipped background.
	 * Overrides the global :focus-visible outline. */
	.c-button::after {
		content: "";
		display: block;
		position: absolute;
		inset: var(--btn-focus-inset);
		border-radius: var(--btn-radius);
		box-shadow: 0 0 0 0 var(--btn-focus);
		transition: box-shadow 0.25s var(--btn-ease);
		pointer-events: none;
		z-index: 2;
	}

	.c-button:active {
		scale: var(--btn-click-scale);
		transition-duration: 0.1s; /* press in fast — instant feedback */
	}

	.c-button:focus-visible {
		outline: none;
	}

	.c-button:focus-visible::after {
		box-shadow: 0 0 0 0.125em var(--btn-focus);
	}

	.c-button__bg {
		pointer-events: none;
		background-color: var(--btn-bg);
		/* Borderless trial — no border at all. (A `1px solid transparent` box
		 * left a 1px ring of page-bg inside the border edge that read as a
		 * hairline on hover, when the fill behind it is dark.) The per-variant
		 * --btn-border vars are dormant; restore `border: 1px solid var(--btn-border)`
		 * to bring the self-defining hairlines back. */
		border: none;
		border-radius: var(--btn-radius);
		grid-area: 1 / 1;
		width: 100%;
		height: 100%;
		display: grid;
		overflow: hidden;
	}

	.c-button__bg-layer {
		grid-area: 1 / 1;
		/* Generously oversized so the ROTATED panel fully covers the button at
		 * full hover with no __bg peeking. With rotate(-10deg) around the
		 * top-right, the top edge slopes DOWN to the left, so the top-LEFT corner
		 * is covered last (the "left sliver"). Width 140% over-covers the left;
		 * height 160% + the -18% hover lift (below) push the lagging top-left
		 * above the top edge. */
		width: 140%;
		height: 160%;
		transform-origin: 100% 0;
		translate: 0 100% 0;
		/* Shallow tilt (was -10deg). The diagonal is what created the visible
		 * left sliver — a steeper tilt makes the top-left lag far behind the rest
		 * of the wipe. -5deg keeps a whisper of diagonal while the lag (and the
		 * sliver) is small; the over-cover above swallows what remains. */
		rotate: -5deg;
		transition:
			translate 0.6s var(--btn-ease),
			rotate 0.5s var(--btn-ease);
		transition-delay: calc(var(--index) * -1 * 0.04s);
	}

	.c-button__bg-layer.is--first {
		background-color: var(--btn-edge);
	}

	.c-button__bg-layer.is--second {
		background-color: var(--btn-fill);
		z-index: 1;
	}

	.c-button__label {
		grid-area: 1 / 1;
		z-index: 1;
		padding: var(--btn-padding);
		text-align: center;
		transition: color 0.4s var(--btn-ease);
		transition-delay: 0.08s;
	}

	/* ── Secondary: WHITE on light / BLACK on dark — the quiet CTA that follows
	 * the page tone (white reads quiet on cream; black reads quiet on the dark
	 * bg). Orange flash → inverts to the opposite tone on hover. ─────────────── */
	.c-button[data-variant="secondary"] {
		--btn-bg: #fff;
		--btn-text: var(--btn-ink);
		--btn-edge: var(--accent);
		--btn-fill: var(--btn-ink);
		--btn-hover-text: #fff;
		--btn-focus: var(--accent);
	}
	/* Dark theme: black rest (a touch darker than the page so it still reads),
	 * white fill on hover. */
	:global([data-theme="dark"]) .c-button[data-variant="secondary"] {
		--btn-bg: hsl(28 10% 6%);
		--btn-text: #fff;
		--btn-fill: #fff;
		--btn-hover-text: hsl(28 10% 6%);
	}

	/* ── Solid: THEME-AWARE dominant CTA. Unlike primary/secondary (which are
	 * fixed paper/ink constants), this follows the theme — text-coloured fill so
	 * it's black-on-light / white-on-dark, always the highest-contrast button on
	 * the page. Hover inverts: orange flash → fills to the page colour, label
	 * crosses to the text colour. ──────────────────────────────────────────── */
	.c-button[data-variant="solid"] {
		--btn-bg: var(--text);
		--btn-text: var(--bg);
		--btn-border: transparent;
		--btn-edge: var(--accent);
		--btn-fill: var(--bg);
		--btn-hover-text: var(--text);
	}

	/* ── Ghost: now a WHITE quiet CTA (was transparent + hairline border — the
	 * borderless trial left it invisible). Pure-white fill so it differentiates
	 * from the cream page and reads as the quiet secondary (white-on-cream is low
	 * contrast); orange flash → ink fill on hover, like primary. Constant (not
	 * theme-aware): in DARK mode it stays a white button — revisit if it competes
	 * with the theme-aware `solid` there. ──────────────────────────────────── */
	.c-button[data-variant="ghost"] {
		--btn-bg: #fff;
		--btn-text: var(--btn-ink);
		--btn-edge: var(--accent);
		--btn-fill: var(--btn-ink);
		--btn-hover-text: var(--btn-paper);
	}

	/* ── Accent: orange CTA (nav). Calm hover — just black wipes in, no flash,
	 * label stays warm white throughout. White-on-orange is intentional. ───── */
	.c-button[data-variant="accent"] {
		--btn-bg: var(--accent);
		--btn-text: var(--btn-paper);
		--btn-border: transparent;
		--btn-edge: var(--btn-ink);
		--btn-fill: var(--btn-ink);
		--btn-hover-text: var(--btn-paper);
		--btn-focus: var(--btn-ink);
	}

	/* ── Link: tertiary text-link CTA — no panel, no padding. Label + external
	 * arrow inline; hover warms the colour and nudges the arrow up-right (the
	 * external-link affordance). Used for the modal's "Live preview". ───────── */
	.c-button[data-variant="link"] {
		--btn-padding: 0;
		--btn-focus: var(--accent);
	}
	.c-button[data-variant="link"] .c-button__bg {
		display: none;
	}
	.c-button[data-variant="link"] .c-button__label {
		display: inline-flex;
		align-items: center;
		gap: 0.55em;
		/* Overridable so the link adapts to its surface — defaults to the theme
		 * text colour (modal), the footer sets it to the footer foreground. */
		color: var(--btn-link-color, var(--text));
		transition: color 0.25s var(--btn-ease);
	}
	.c-button[data-variant="link"] .c-button__icon {
		width: 1.05em;
		height: 1.05em;
		flex: none;
		transition: transform 0.3s var(--btn-ease);
	}
	@media (hover: hover) and (pointer: fine) {
		.c-button[data-variant="link"]:is(:hover, :focus-visible) .c-button__label {
			color: var(--btn-link-hover, var(--accent-ink));
		}
	}
	@media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
		.c-button[data-variant="link"]:is(:hover, :focus-visible) .c-button__icon {
			transform: translate(0.15em, -0.15em);
		}
	}

	/* ── Hover: wipe the panels up, cross the label color over ─────────────── */
	@media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
		.c-button:is(:hover, :focus-visible) .c-button__bg-layer,
		[data-hover]:is(:hover, :focus-visible) .c-button .c-button__bg-layer {
			/* -18% (not 0) lifts the over-tall panel above the top edge so the
			 * lagging top-left corner is covered — no __bg sliver at full hover. */
			translate: 0 -18% 0;
			rotate: 0deg;
			transition-delay: calc(var(--index) * 0.06s + 0.04s);
		}

		.c-button:is(:hover, :focus-visible) .c-button__label,
		[data-hover]:is(:hover, :focus-visible) .c-button .c-button__label {
			color: var(--btn-hover-text);
		}
	}

	/* ── Reduced-motion fallback — instant color swap so hover still reads ──── */
	@media (hover: hover) and (prefers-reduced-motion: reduce) {
		.c-button:is(:hover, :focus-visible) .c-button__bg {
			background-color: var(--btn-fill);
		}
		.c-button:is(:hover, :focus-visible) .c-button__label {
			color: var(--btn-hover-text);
		}
	}
</style>
