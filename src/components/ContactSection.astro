---
/*
 * c-contact — the closing "let's work together" CTA, the last #main section
 * before the footer-reveal wordmark. Centred statement + a single copy-email
 * button + socials. No form (the button copies CONTACT_EMAIL to the clipboard
 * via the global [data-copy-email] handler in Base.astro; the mailto: href is
 * the no-JS fallback, same contract as the hero's "Get in touch").
 *
 * Deliberately contained (not oversized type): the giant BRENO footer wordmark
 * below is the showstopper, so this hands off to it rather than competing.
 *
 * Reveal mirrors AboutSection/WorkSection: [data-reveal] + .js-contact-reveal
 * items park hidden (CSS guard in global.css) and slide up via ScrollTrigger
 * when the section scrolls into view. Always below the fold, so no page-reveal
 * gating is needed.
 */
import Button from "./Button.astro";
import { CONTACT_EMAIL } from "../lib/site";
import { ABOUT } from "../lib/about";
---

<section class="c-contact" id="contact" aria-label="Contact">
	<div class="c-contact__inner">
		<h2 class="c-contact__title js-contact-reveal" data-reveal>
			Let's make something good.
		</h2>
		<p class="c-contact__lead js-contact-reveal" data-reveal>
			Whether you've got a project in mind or just want to say hi, my inbox is
			always open.
		</p>

		<div class="c-contact__cta js-contact-reveal" data-reveal>
			<Button
				label="Get in touch"
				href={`mailto:${CONTACT_EMAIL}`}
				variant="primary"
				data-copy-email={CONTACT_EMAIL}
			/>
		</div>

		<ul
			class="c-contact__socials js-contact-reveal"
			data-reveal
			aria-label="Find me elsewhere"
		>
			{
				ABOUT.socials.map((s) => (
					<li>
						<a
							class="c-contact__social"
							href={s.href}
							target="_blank"
							rel="noopener noreferrer"
							aria-label={s.label}
						>
							{s.icon === "linkedin" ? (
								<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
									<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
								</svg>
							) : (
								<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
									<path d="M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z" />
								</svg>
							)}
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.c-contact {
		max-width: var(--container-content);
		margin-inline: auto;
		padding: var(--spacing-3xl) var(--spacing-m);
	}
	.c-contact__inner {
		display: grid;
		justify-items: center;
		text-align: center;
		gap: var(--spacing-s);
	}
	.c-contact__title {
		font-size: var(--text-step-4);
		max-width: 18ch;
		text-wrap: balance;
	}
	.c-contact__lead {
		color: var(--text-muted);
		font-size: var(--text-step-1);
		max-width: 42ch;
		text-wrap: pretty;
	}
	.c-contact__cta {
		margin-top: var(--spacing-2xs);
	}

	.c-contact__socials {
		display: flex;
		gap: var(--spacing-s);
		list-style: none;
		padding: 0;
		margin-top: var(--spacing-xs);
	}
	.c-contact__social {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		color: var(--text-muted);
		transition:
			color 0.25s var(--ease-out-expo),
			border-color 0.25s var(--ease-out-expo),
			background-color 0.25s var(--ease-out-expo),
			transform 0.25s var(--ease-out-expo);
	}
	.c-contact__social svg {
		width: 1.1rem;
		height: 1.1rem;
	}
	@media (hover: hover) and (prefers-reduced-motion: no-preference) {
		.c-contact__social:is(:hover, :focus-visible) {
			color: var(--accent-ink);
			border-color: var(--accent);
			background-color: var(--surface-raised);
			transform: translateY(-2px);
		}
	}
	.c-contact__social:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
</style>

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";
	import { CustomEase } from "gsap/CustomEase";

	gsap.registerPlugin(ScrollTrigger, CustomEase);

	const reduced = matchMedia("(prefers-reduced-motion: reduce)");
	const EASE_OUT =
		CustomEase.get("brand-out") ?? CustomEase.create("brand-out", "0.16,1,0.3,1");

	let triggers: ScrollTrigger[] = [];

	function killTriggers() {
		triggers.forEach((t) => t.kill());
		triggers = [];
	}

	function setup() {
		const items = gsap.utils.toArray<HTMLElement>(".js-contact-reveal");
		if (!items.length) return;
		killTriggers();

		if (reduced.matches) {
			gsap.set(items, { autoAlpha: 1, y: 0 });
			return;
		}

		gsap.set(items, { autoAlpha: 0, y: 40 });

		// Always below the fold — a batched reveal when the section enters.
		triggers.push(
			...ScrollTrigger.batch(items, {
				start: "top 85%",
				onEnter: (batch) =>
					gsap.to(batch, {
						autoAlpha: 1,
						y: 0,
						duration: 0.8,
						ease: EASE_OUT,
						stagger: 0.08,
						overwrite: true,
					}),
			}),
		);
		ScrollTrigger.refresh();
	}

	document.addEventListener("astro:page-load", setup);
	document.addEventListener("astro:before-swap", killTriggers);
</script>
