---
/*
 * c-footer__bg — the orange backlit-glow gradient behind the footer.
 *
 * A full-screen fragment shader on a <canvas>, no dependencies. Beyond a flat
 * gradient it layers domain-warped fractal noise (organic flowing light) and
 * soft light striations from the hotspot. It drifts slowly so it feels alive —
 * paused off-screen and frozen for prefers-reduced-motion. The footer keeps a
 * deep-orange CSS fallback.
 *
 * Look is driven by `params` (warp / rays / spread / hotspot / speed). In dev,
 * window.__footerGrad lets the settings panel tweak them live.
 *
 * Tuned to the Vizuur reference: luminous orange, bright hotspot high up,
 * deepening (and shifting redder) toward the bottom and corners.
 */
---

<canvas class="c-footer__bg" aria-hidden="true"></canvas>

<style>
	.c-footer__bg {
		position: absolute;
		inset: 0;
		z-index: 0;
		display: block;
		width: 100%;
		height: 100%;
		background-color: #c7400c; /* fallback (matches the shader's mid-deep) */
	}
	:global(html[data-theme="dark"]) .c-footer__bg {
		background-color: #152b5a; /* night-blue fallback */
	}
</style>

<script>
	const VERT = `
		attribute vec2 a_pos;
		varying vec2 v_uv;
		void main() {
			v_uv = a_pos * 0.5 + 0.5; // 0..1, y=1 at the top
			gl_Position = vec4(a_pos, 0.0, 1.0);
		}
	`;

	const FRAG = `
		precision highp float;
		varying vec2 v_uv;
		uniform vec2 u_res;
		uniform float u_time;
		uniform float u_warp;   // organic distortion strength
		uniform float u_rays;   // light-striation strength
		uniform float u_spread; // glow size
		uniform vec2  u_hot;    // hotspot position (uv space)
		uniform vec3  u_cHot;   // palette (theme-aware): hotspot core
		uniform vec3  u_cMid;   // field
		uniform vec3  u_cDeep;  // edges
		uniform vec3  u_cShadow;// corners / bottom

		float hash(vec2 p) {
			return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
		}
		float vnoise(vec2 p) {
			vec2 i = floor(p), f = fract(p);
			float a = hash(i);
			float b = hash(i + vec2(1.0, 0.0));
			float c = hash(i + vec2(0.0, 1.0));
			float d = hash(i + vec2(1.0, 1.0));
			vec2 u = f * f * (3.0 - 2.0 * f);
			return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
		}
		float fbm(vec2 p) {
			float s = 0.0, a = 0.5;
			for (int i = 0; i < 5; i++) {
				s += a * vnoise(p);
				p = p * 2.02 + vec2(7.3, 3.1);
				a *= 0.5;
			}
			return s;
		}

		void main() {
			vec2 uv = v_uv;
			float aspect = u_res.x / max(u_res.y, 1.0);
			vec2 ar = vec2(aspect, 1.0);
			float t = u_time;

			// Domain warp — push coords with slow flowing fbm so the glow breathes
			// and streaks like atmosphere instead of a clean radial.
			vec2 wp = uv * ar * 2.0;
			vec2 warp = vec2(
				fbm(wp + vec2(0.0, t * 0.06)),
				fbm(wp + vec2(5.2, -t * 0.05) + 3.7)
			) - 0.5;
			vec2 quv = uv + warp * u_warp;

			// Hotspot.
			vec2 d = (quv - u_hot) * ar;
			float glow = smoothstep(u_spread, 0.05, length(d));
			float vert = smoothstep(-0.1, 1.0, quv.y);

			// Large-scale organic field variation.
			float big = fbm(quv * ar * 1.6 + vec2(0.0, t * 0.04));
			float field = clamp(glow * 0.82 + vert * 0.32 + (big - 0.5) * 0.24, 0.0, 1.0);

			// Light striations radiating from the hotspot.
			vec2 rd = quv - u_hot; rd.x *= aspect;
			float ang = atan(rd.y, rd.x);
			float rays = fbm(vec2(ang * 3.0, length(rd) * 2.2) + vec2(t * 0.08, 0.0));
			field += (rays - 0.5) * u_rays * glow;

			// Edge + bottom deepening.
			vec2 cc = (uv - 0.5) * ar;
			float vig = smoothstep(0.25, 1.15, length(cc));
			float bottom = smoothstep(0.4, -0.05, uv.y);
			float deepen = clamp(max(vig * 0.9, bottom), 0.0, 1.0);

			vec3 col = mix(u_cDeep, u_cMid, smoothstep(0.20, 0.72, field));
			col = mix(col, u_cHot, smoothstep(0.62, 1.0, field));
			col = mix(col, u_cShadow, deepen * 0.8);

			// Sub-LSB dither — kills banding on the smooth field (not film grain).
			col += (hash(gl_FragCoord.xy) - 0.5) / 255.0;

			gl_FragColor = vec4(col, 1.0);
		}
	`;

	type Params = {
		warp: number;
		rays: number;
		spread: number;
		hotX: number;
		hotY: number;
		speed: number;
	};
	type Gradient = { resize: () => void; render: (t: number) => void; dispose: () => void };

	const params: Params = { warp: 0.3, rays: 0.275, spread: 1.5, hotX: 0.53, hotY: 1.11, speed: 1.5 };

	// Theme-aware palette (brightest -> deepest): warm orange in light, night
	// blue in dark. Fed to the shader as uniforms; swapped on theme change.
	type Palette = { hot: number[]; mid: number[]; deep: number[]; shadow: number[] };
	const PALETTES: Record<"light" | "dark", Palette> = {
		light: {
			hot: [1.0, 0.561, 0.255], // #FF8F41
			mid: [0.949, 0.38, 0.114], // #F26120
			deep: [0.776, 0.251, 0.043], // #C6400B
			shadow: [0.627, 0.184, 0.035], // #A02F09
		},
		dark: {
			hot: [0.31, 0.49, 0.863], // #4F7DDC
			mid: [0.161, 0.306, 0.62], // #294E9E
			deep: [0.082, 0.169, 0.353], // #152B5A
			shadow: [0.039, 0.078, 0.188], // #0A1430
		},
	};
	const pickPalette = (): Palette =>
		document.documentElement.dataset.theme === "dark" ? PALETTES.dark : PALETTES.light;
	let palette: Palette = PALETTES.light;

	function compile(gl: WebGLRenderingContext, type: number, src: string) {
		const s = gl.createShader(type)!;
		gl.shaderSource(s, src);
		gl.compileShader(s);
		if (!gl.getShaderParameter(s, gl.COMPILE_STATUS))
			console.error("[footer-gradient] shader:", gl.getShaderInfoLog(s));
		return s;
	}

	function createGradient(canvas: HTMLCanvasElement): Gradient | null {
		const gl = canvas.getContext("webgl", { alpha: false, antialias: false });
		if (!gl) return null;

		const prog = gl.createProgram()!;
		gl.attachShader(prog, compile(gl, gl.VERTEX_SHADER, VERT));
		gl.attachShader(prog, compile(gl, gl.FRAGMENT_SHADER, FRAG));
		gl.linkProgram(prog);
		gl.useProgram(prog);

		const buf = gl.createBuffer();
		gl.bindBuffer(gl.ARRAY_BUFFER, buf);
		gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
		const aPos = gl.getAttribLocation(prog, "a_pos");
		gl.enableVertexAttribArray(aPos);
		gl.vertexAttribPointer(aPos, 2, gl.FLOAT, false, 0, 0);

		const uRes = gl.getUniformLocation(prog, "u_res");
		const uTime = gl.getUniformLocation(prog, "u_time");
		const uWarp = gl.getUniformLocation(prog, "u_warp");
		const uRays = gl.getUniformLocation(prog, "u_rays");
		const uSpread = gl.getUniformLocation(prog, "u_spread");
		const uHot = gl.getUniformLocation(prog, "u_hot");
		const uCHot = gl.getUniformLocation(prog, "u_cHot");
		const uCMid = gl.getUniformLocation(prog, "u_cMid");
		const uCDeep = gl.getUniformLocation(prog, "u_cDeep");
		const uCShadow = gl.getUniformLocation(prog, "u_cShadow");

		function resize() {
			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			const w = Math.max(1, Math.round(canvas.clientWidth * dpr));
			const h = Math.max(1, Math.round(canvas.clientHeight * dpr));
			if (canvas.width !== w || canvas.height !== h) {
				canvas.width = w;
				canvas.height = h;
			}
			gl.viewport(0, 0, canvas.width, canvas.height);
			gl.uniform2f(uRes, canvas.width, canvas.height);
		}

		function render(t: number) {
			gl.uniform1f(uTime, t * params.speed);
			gl.uniform1f(uWarp, params.warp);
			gl.uniform1f(uRays, params.rays);
			gl.uniform1f(uSpread, params.spread);
			gl.uniform2f(uHot, params.hotX, params.hotY);
			gl.uniform3fv(uCHot, palette.hot);
			gl.uniform3fv(uCMid, palette.mid);
			gl.uniform3fv(uCDeep, palette.deep);
			gl.uniform3fv(uCShadow, palette.shadow);
			gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
		}

		function dispose() {
			gl.getExtension("WEBGL_lose_context")?.loseContext();
		}

		return { resize, render, dispose };
	}

	const reduced = matchMedia("(prefers-reduced-motion: reduce)");
	let grad: Gradient | null = null;
	let ro: ResizeObserver | null = null;
	let io: IntersectionObserver | null = null;
	let themeObs: MutationObserver | null = null;
	let raf = 0;
	let t0 = 0;

	function loop(ts: number) {
		if (!grad) return;
		if (!t0) t0 = ts;
		grad.render((ts - t0) / 1000);
		raf = requestAnimationFrame(loop);
	}
	function play() {
		if (raf || !grad) return;
		if (reduced.matches) {
			grad.render(0);
			return;
		}
		raf = requestAnimationFrame(loop);
	}
	function pause() {
		cancelAnimationFrame(raf);
		raf = 0;
	}

	function init() {
		const canvas = document.querySelector<HTMLCanvasElement>(".c-footer__bg");
		if (!canvas || canvas.dataset.ready === "1") return;

		grad = createGradient(canvas);
		if (!grad) return;
		canvas.dataset.ready = "1";

		palette = pickPalette();
		grad.resize();
		grad.render(0);

		ro = new ResizeObserver(() => {
			grad?.resize();
			if (!raf) grad?.render(0);
		});
		ro.observe(canvas);

		io = new IntersectionObserver(
			(entries) => (entries[0]?.isIntersecting ? play() : pause()),
			{ rootMargin: "200px" },
		);
		io.observe(canvas);

		// Swap palette when the theme flips; repaint at once so the theme
		// view-transition wipe carries the new colour.
		const themeRoot = document.documentElement;
		if (themeRoot instanceof Node) {
			themeObs = new MutationObserver(() => {
				palette = pickPalette();
				grad?.render(performance.now() / 1000);
			});
			try {
				themeObs.observe(themeRoot, {
					attributes: true,
					attributeFilter: ["data-theme"],
				});
			} catch {
				// Theme observation is an enhancement. Keep the static palette if a
				// browser tears down the document root during startup or navigation.
				themeObs.disconnect();
				themeObs = null;
			}
		}

		if (import.meta.env.DEV)
			(window as unknown as { __footerGrad: unknown }).__footerGrad = {
				params,
				set(p: Partial<Params>) {
					Object.assign(params, p);
					grad?.render(performance.now() / 1000);
				},
			};
	}

	function cleanup() {
		pause();
		ro?.disconnect();
		ro = null;
		io?.disconnect();
		io = null;
		themeObs?.disconnect();
		themeObs = null;
		grad?.dispose();
		grad = null;
	}

	init();
	document.addEventListener("astro:page-load", init);
	document.addEventListener("astro:before-swap", cleanup);
</script>
