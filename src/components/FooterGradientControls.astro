---
/*
 * c-grad-controls — DEV-ONLY live tuner for the footer gradient.
 *
 * Non-blocking floating panel (so the gradient updates live while you drag).
 * Drives FooterGradient via window.__footerGrad. "Copy" puts the current values
 * on the clipboard as a JS object literal so they can be pasted back to bake in.
 *
 * Only rendered when import.meta.env.DEV — never ships to production.
 */
---

<div class="c-grad-controls" data-collapsed aria-hidden="true">
	<button class="c-grad-controls__toggle" type="button">
		<span class="c-grad-controls__title">Footer gradient</span>
		<span class="c-grad-controls__chev">▾</span>
	</button>
	<div class="c-grad-controls__body">
		<div class="js-grad-rows"></div>
		<div class="c-grad-controls__actions">
			<button class="c-grad-controls__btn js-grad-copy" type="button">Copy values</button>
			<button class="c-grad-controls__btn js-grad-reset" type="button">Reset</button>
		</div>
	</div>
</div>

<style>
	.c-grad-controls {
		/* Hidden until it binds to a footer gradient (the panel renders on every
		 * page in dev, but only works where the footer/shader exists). */
		display: none;
		position: fixed;
		left: 1rem;
		bottom: 1rem;
		z-index: 2147483000; /* above the page; below devtools overlays */
		width: 16rem;
		font-family: var(--font-mono, ui-monospace, monospace);
		font-size: 11px;
		color: #f4f1ea;
		background: rgba(20, 16, 14, 0.92);
		-webkit-backdrop-filter: blur(8px);
		backdrop-filter: blur(8px);
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 10px;
		overflow: hidden;
		box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4);
		user-select: none;
	}
	.c-grad-controls[data-bound="1"] {
		display: block;
	}

	.c-grad-controls__toggle {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 100%;
		padding: 8px 10px;
		background: transparent;
		border: 0;
		color: inherit;
		font: inherit;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		cursor: pointer;
	}
	.c-grad-controls__chev {
		transition: transform 0.2s ease;
	}
	.c-grad-controls[data-collapsed] .c-grad-controls__chev {
		transform: rotate(-90deg);
	}
	.c-grad-controls[data-collapsed] .c-grad-controls__body {
		display: none;
	}

	.c-grad-controls__body {
		padding: 4px 10px 10px;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
	}

	.c-grad-controls__row {
		display: grid;
		grid-template-columns: 3.2rem 1fr 2.6rem;
		align-items: center;
		gap: 8px;
		padding: 5px 0;
	}
	.c-grad-controls__row label {
		text-transform: uppercase;
		letter-spacing: 0.03em;
		opacity: 0.8;
	}
	.c-grad-controls__row input[type="range"] {
		width: 100%;
		accent-color: #ff6a2a;
		cursor: pointer;
	}
	.c-grad-controls__val {
		text-align: right;
		font-variant-numeric: tabular-nums;
		opacity: 0.95;
	}

	.c-grad-controls__actions {
		display: flex;
		gap: 6px;
		margin-top: 8px;
	}
	.c-grad-controls__btn {
		flex: 1;
		padding: 7px 8px;
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(255, 255, 255, 0.14);
		border-radius: 6px;
		color: inherit;
		font: inherit;
		letter-spacing: 0.03em;
		text-transform: uppercase;
		cursor: pointer;
		transition: background 0.15s ease;
	}
	.c-grad-controls__btn:hover {
		background: rgba(255, 255, 255, 0.16);
	}
	.js-grad-copy.is-copied {
		background: #ff6a2a;
		border-color: #ff6a2a;
		color: #1a0c04;
	}

	@media (prefers-reduced-motion: reduce) {
		.c-grad-controls__chev {
			transition: none;
		}
	}
</style>

<script>
	type Params = Record<string, number>;
	type Hook = { params: Params; set: (p: Params) => void };

	const SCHEMA = [
		{ key: "warp", label: "Warp", min: 0, max: 0.3, step: 0.005 },
		{ key: "rays", label: "Rays", min: 0, max: 0.5, step: 0.005 },
		{ key: "spread", label: "Spread", min: 0.6, max: 2, step: 0.01 },
		{ key: "hotX", label: "Hot X", min: 0, max: 1, step: 0.01 },
		{ key: "hotY", label: "Hot Y", min: 0.5, max: 1.3, step: 0.01 },
		{ key: "speed", label: "Speed", min: 0, max: 2, step: 0.05 },
	];

	const fmt = (n: number) => (Number.isInteger(n) ? String(n) : String(+n.toFixed(3)));

	function setup() {
		const root = document.querySelector<HTMLElement>(".c-grad-controls");
		if (!root || root.dataset.bound === "1") return;

		const hook = (window as unknown as { __footerGrad?: Hook }).__footerGrad;
		// The gradient may not have initialised yet — retry briefly.
		if (!hook) {
			let tries = 0;
			const id = setInterval(() => {
				if ((window as unknown as { __footerGrad?: Hook }).__footerGrad || tries++ > 40) {
					clearInterval(id);
					setup();
				}
			}, 50);
			return;
		}
		root.dataset.bound = "1";
		root.removeAttribute("aria-hidden");

		const defaults: Params = { ...hook.params };
		const rows = root.querySelector<HTMLElement>(".js-grad-rows")!;
		const valEls: Record<string, HTMLElement> = {};
		const inputEls: Record<string, HTMLInputElement> = {};

		for (const f of SCHEMA) {
			const row = document.createElement("div");
			row.className = "c-grad-controls__row";
			row.innerHTML = `
				<label for="grad-${f.key}">${f.label}</label>
				<input id="grad-${f.key}" type="range" min="${f.min}" max="${f.max}" step="${f.step}" />
				<span class="c-grad-controls__val"></span>`;
			rows.appendChild(row);

			const input = row.querySelector("input")!;
			const val = row.querySelector<HTMLElement>(".c-grad-controls__val")!;
			input.value = String(hook.params[f.key] ?? f.min);
			val.textContent = fmt(+input.value);
			inputEls[f.key] = input;
			valEls[f.key] = val;

			input.addEventListener("input", () => {
				const v = +input.value;
				val.textContent = fmt(v);
				hook.set({ [f.key]: v });
			});
		}

		// Collapse toggle.
		root.querySelector(".c-grad-controls__toggle")!.addEventListener("click", () => {
			if (root.hasAttribute("data-collapsed")) root.removeAttribute("data-collapsed");
			else root.setAttribute("data-collapsed", "");
		});

		// Copy — as a JS object literal, ready to paste.
		const copyBtn = root.querySelector<HTMLButtonElement>(".js-grad-copy")!;
		copyBtn.addEventListener("click", async () => {
			const obj = SCHEMA.map((f) => `${f.key}: ${fmt(hook.params[f.key])}`).join(", ");
			const text = `{ ${obj} }`;
			// Always log it too, so the values are retrievable even if the
			// clipboard API is blocked (e.g. no focus / insecure context).
			console.log("[footer-gradient] params:", text);
			try {
				await navigator.clipboard.writeText(text);
			} catch {
				/* clipboard blocked — console.log above is the fallback */
			}
			copyBtn.classList.add("is-copied");
			const prev = copyBtn.textContent;
			copyBtn.textContent = "Copied!";
			setTimeout(() => {
				copyBtn.classList.remove("is-copied");
				copyBtn.textContent = prev;
			}, 1100);
		});

		// Reset to the baked-in defaults.
		root.querySelector(".js-grad-reset")!.addEventListener("click", () => {
			hook.set({ ...defaults });
			for (const f of SCHEMA) {
				inputEls[f.key].value = String(defaults[f.key]);
				valEls[f.key].textContent = fmt(defaults[f.key]);
			}
		});
	}

	setup();
	document.addEventListener("astro:page-load", setup);
</script>
