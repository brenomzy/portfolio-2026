---
/*
 * Landing hero — the editorial intro above the work grid. Extracted from
 * index.astro so the /work/[slug] deep-link page can render the same home shell
 * behind its pre-opened modal (closing the modal reveals this, no page load).
 *
 * Words split + reveal on load (SplitText), then it hands off to Work while the
 * hero's closing beat is still playing via `hero:work-ready`.
 * so WorkSection can sequence its own reveal after this one.
 */
import Button from "./Button.astro";
import { CONTACT_EMAIL } from "../lib/site";
---

<section class="hero">
	<h1 class="hero__title" data-split>
		Webflow Developer.
		<span class="hero__title-secondary">
			<span
				class="hero__title-rotator js-title-rotator"
				data-titles="Product Designer|UI Designer|Designer"
				><span class="hero__title-modifier">Product</span> Designer</span
			>
		</span>
	</h1>
	<p class="hero__lead" data-split>
		I'm Breno, from Brazil. I care about speed, accessibility, and motion
		that earns its place. Currently at BX Studio, previously at Finsweet.
	</p>
	<div class="hero__actions" data-reveal>
		<Button label="View work ↓" href="#work" variant="primary" />
		<Button
			label="Get in touch"
			href={`mailto:${CONTACT_EMAIL}`}
			variant="secondary"
			data-copy-email={CONTACT_EMAIL}
		/>
	</div>
</section>

<style>
	.hero {
		max-width: var(--container-content);
		margin-inline: auto;
		padding: var(--spacing-2xl) var(--content-gutter) var(--spacing-xl);
		display: grid;
		gap: var(--spacing-xs);
	}
	.hero__title {
		/* Fluid down to phone widths so each title (split by the <br>) holds its
		 * own single line instead of wrapping mid-title. Tops out at --text-step-6
		 * (the big desktop size); shrinks on narrow screens where "Webflow
		 * Developer." would otherwise break across two lines. */
		font-size: clamp(1.9rem, 1rem + 4.6vw, var(--text-step-6));
		max-width: 20ch;
		/* Override the global h1 `text-wrap: balance` — it interferes with
		 * SplitText line measurement. (Weight / tracking / line-height inherited.) */
		text-wrap: pretty;
	}
	.hero__title-secondary {
		display: block;
	}
	.hero__title-rotator {
		display: inline-block;
		min-width: 17ch;
		will-change: transform, opacity, filter;
	}
	.hero__title-rotator :global(.hero__title-modifier) {
		opacity: 0.45;
	}
	@media (max-width: 48rem) {
		.hero__title {
			min-width: 0;
			font-size: clamp(1.65rem, 0.9rem + 3.8vw, var(--text-step-6));
		}
		.hero__title-rotator {
			min-width: 0;
		}
	}
	.hero__lead {
		font-size: 1.125rem; /* 18px — trialing a smaller lead per request */
		color: var(--text-muted);
		max-width: 48ch;
	}
	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-2xs);
		margin-top: var(--spacing-2xs);
	}
</style>

<script>
	import gsap from "gsap";
	import { SplitText } from "gsap/SplitText";
	import { whenRevealable } from "../lib/page-reveal";

	gsap.registerPlugin(SplitText);

	const reduced = matchMedia("(prefers-reduced-motion: reduce)");
	const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

	// Hand the choreography to Work once the headline is readable and the lead is
	// underway. Reduced/error paths signal immediately so Work never waits.
	const signalWorkReady = () =>
		document.dispatchEvent(new CustomEvent("hero:work-ready"));

	let active: SplitText[] = [];
	let titleRotation: gsap.core.Tween | null = null;
	let titleRotationTimer: number | null = null;
	let revealRoot: HTMLElement | null = null;

	function show(els: (Element | null)[]) {
		gsap.set(els.filter(Boolean) as Element[], { visibility: "visible" });
	}

	function cleanup() {
		titleRotation?.kill();
		titleRotation = null;
		if (titleRotationTimer) {
			window.clearTimeout(titleRotationTimer);
			titleRotationTimer = null;
		}
		active.forEach((s) => s.revert());
		active = [];
	}

	function startTitleRotation() {
		const rotator =
			document.querySelector<HTMLElement>(".js-title-rotator");
		if (!rotator || reduced.matches) return;

		const titles = rotator.dataset.titles?.split("|").filter(Boolean) ?? [];
		if (titles.length < 2) return;

		let index = Math.max(0, titles.indexOf(rotator.textContent?.trim() ?? ""));

		const renderTitle = (title: string) => {
			const modifier = title.endsWith(" Designer")
				? title.slice(0, -" Designer".length)
				: "";
			rotator.replaceChildren();
			if (modifier) {
				const span = document.createElement("span");
				span.className = "hero__title-modifier";
				span.textContent = modifier;
				rotator.append(span, " ");
			}
			rotator.append("Designer");
		};

		const rotate = () => {
			titleRotation = gsap.to(rotator, {
				autoAlpha: 0,
				y: 10,
				filter: "blur(6px)",
				duration: 0.34,
				ease: "power2.in",
				onComplete: () => {
					index = (index + 1) % titles.length;
					renderTitle(titles[index]);
					titleRotation = gsap.fromTo(
						rotator,
						{ autoAlpha: 0, y: -8, filter: "blur(6px)" },
						{
							autoAlpha: 1,
							y: 0,
							filter: "blur(0px)",
							duration: 0.52,
							ease: "power3.out",
							onComplete: () => {
								titleRotationTimer = window.setTimeout(rotate, 2600);
							},
						},
					);
				},
			});
		};

		titleRotationTimer = window.setTimeout(rotate, 2200);
	}

	async function revealHero() {
		const title = document.querySelector<HTMLElement>(".hero__title");
		const lead = document.querySelector<HTMLElement>(".hero__lead");
		const actions = document.querySelector<HTMLElement>(".hero__actions");
		if (!title || title === revealRoot) return;
		cleanup();
		revealRoot = title;

		const all = [title, lead, actions];

		// Reduced motion: skip the choreography, just reveal.
		if (reduced.matches) {
			show(all);
			signalWorkReady();
			return;
		}

		try {
			// Split once fonts settle so line breaks are right — but cap the wait so
			// the hero can never stay hidden if font loading stalls.
			await Promise.race([document.fonts.ready, wait(1500)]);

			const titleSplit = SplitText.create(title, { type: "words" });
			const leadSplit = lead
				? SplitText.create(lead, { type: "words" })
				: null;
			active = [titleSplit, leadSplit].filter(Boolean) as SplitText[];

			// Hold the choreography until the page-transition wipe has uncovered the
			// page, so the words reveal in the open (not behind the panel).
			await whenRevealable();

			show(all);

			const tl = gsap.timeline({
				// Gentler, slower ease than expo.out (which snaps then crawls).
				defaults: { ease: "power2.out" },
				// Restore normal, reflowable text once the complete hero reveal has played.
				onComplete: () => {
					cleanup();
					startTitleRotation();
				},
			});

			// No clip/mask — words fade + drift up + sharpen from blur (the aritro.xyz
			// feel), the same blur language as the header's blur-in (see
			// SiteHeader.astro). `stagger.amount` spreads ALL words over a fixed time
			// regardless of count. Words are cleaned up by split.revert() in
			// cleanup(); the buttons clear their own filter.
			tl.from(titleSplit.words, {
				autoAlpha: 0,
				y: 20,
				filter: "blur(10px)",
				duration: 0.9,
				stagger: { amount: 0.5 },
			});
			if (leadSplit) {
				tl.from(
					leadSplit.words,
					{
						autoAlpha: 0,
						y: 14,
						filter: "blur(8px)",
						duration: 0.8,
						stagger: { amount: 0.7 },
					},
					"-=0.7",
				);
			}
			if (actions) {
				tl.from(
					actions.children,
					{
						autoAlpha: 0,
						y: 12,
						filter: "blur(8px)",
						duration: 0.6,
						stagger: 0.08,
						// "all" (not just "filter") so GSAP's inline transform props —
						// incl. `scale: none` — are removed, freeing the buttons'
						// :active press scale. Safe here: these children have no
						// [data-reveal] visibility to preserve.
						clearProps: "all",
					},
					"-=0.35",
				);
			}
			// Overlap Work with the lead/buttons instead of serializing both sections.
			tl.call(signalWorkReady, [], 1.3);
		} catch {
			// Never leave the hero hidden if anything goes wrong.
			cleanup();
			show(all);
			signalWorkReady();
		}
	}

	// Direct dev-server loads can evaluate this module after `astro:page-load`.
	// Run immediately and guard by the current title node so later page-load
	// events do not duplicate the entrance animation.
	void revealHero();
	document.addEventListener("astro:page-load", revealHero);
	document.addEventListener("astro:before-swap", () => {
		revealRoot = null;
		cleanup();
	});
</script>
