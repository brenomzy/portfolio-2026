---
/*
 * c-logo — the brand wordmark, inlined.
 *
 * The mark (left glyph) keeps its fixed orange gradient — that's brand identity.
 * The wordmark letters are driven by `currentColor`, so the logo follows the
 * theme automatically: warm ink on the light cream bg, warm white on dark, with
 * no flash and a single source file (no light/dark swap). See Design.md → Logo.
 *
 * Sized by CSS height in the header; viewBox preserves the 123:50 ratio.
 */
interface Props {
	class?: string;
}
const { class: className } = Astro.props;
