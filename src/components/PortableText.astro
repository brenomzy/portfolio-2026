---
import { PortableText } from "astro-portabletext";
import PortableTextImage from "./PortableTextImage.astro";

interface Props {
	value?: unknown;
	class?: string;
}
const { value, class: className } = Astro.props;

const components = {
	type: { image: PortableTextImage },
};
---

{
	value && (
		<div class:list={["c-prose", className]}>
			<PortableText value={value as any} components={components as any} />
		</div>
	)
}

<style>
	.c-prose {
		display: grid;
		gap: var(--spacing-s);
		max-width: 65ch;
	}
	.c-prose :global(h2) {
		font-size: var(--text-step-3);
		margin-top: var(--spacing-m);
	}
	.c-prose :global(h3) {
		font-size: var(--text-step-2);
		margin-top: var(--spacing-s);
	}
	.c-prose :global(a) {
		color: var(--accent-ink);
	}
	.c-prose :global(ul),
	.c-prose :global(ol) {
		display: grid;
		gap: var(--spacing-3xs);
		padding-left: var(--spacing-s);
	}
	.c-prose :global(blockquote) {
		border-left: 3px solid var(--accent);
		padding-left: var(--spacing-s);
		color: var(--text-muted);
	}
</style>
