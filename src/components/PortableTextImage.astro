---
import SanityImage from "./SanityImage.astro";

// Custom renderer for `image` blocks embedded in Portable Text body content.
interface Props {
	node: { asset?: unknown; alt?: string };
}
const { node } = Astro.props;
---

<figure class="c-prose__figure">
	<SanityImage image={node} sizes="(min-width: 65ch) 65ch, 100vw" />
	{node?.alt && <figcaption class="c-prose__caption">{node.alt}</figcaption>}
</figure>

<style>
	.c-prose__figure {
		margin-block: var(--spacing-m);
	}
	.c-prose__figure :global(img) {
		border-radius: var(--radius-md);
	}
	.c-prose__caption {
		margin-top: var(--spacing-2xs);
		font-size: var(--text-step--1);
		color: var(--text-muted);
	}
</style>
