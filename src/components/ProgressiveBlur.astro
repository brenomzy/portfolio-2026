---
/*
 * c-progressive-blur — a fixed, non-interactive overlay pinned to the bottom of
 * the viewport. Five stacked backdrop-filter layers, each blurring more and
 * masked to a lower band, so the blur ramps up toward the bottom edge (content
 * softly dissolves as it scrolls off). Purely decorative; isolated + contained
 * so it doesn't repaint the rest of the page.
 *
 * Blur radii are in `em` (relative to the layer font-size) so the whole ramp
 * scales together if we ever change its base size.
 */
---

<div class="c-progressive-blur" aria-hidden="true">
	<div class="c-progressive-blur__layer is--1"></div>
	<div class="c-progressive-blur__layer is--2"></div>
	<div class="c-progressive-blur__layer is--3"></div>
	<div class="c-progressive-blur__layer is--4"></div>
	<div class="c-progressive-blur__layer is--5"></div>
</div>

<style>
	.c-progressive-blur {
		z-index: 40;
		pointer-events: none;
		isolation: isolate;
		contain: paint;
		width: 100%;
		height: 15em;
		transform-style: preserve-3d;
		position: fixed;
		bottom: 0;
		left: 0;
		overflow: hidden;
		transform: translateZ(0);
	}

	.c-progressive-blur__layer {
		width: 100%;
		height: 100%;
		position: absolute;
	}

	.c-progressive-blur__layer.is--1 {
		-webkit-backdrop-filter: blur(0.09375em);
		backdrop-filter: blur(0.09375em);
		-webkit-mask: linear-gradient(#0000 50%, #000 62.5% 75%, #0000 87.5%);
		mask: linear-gradient(#0000 50%, #000 62.5% 75%, #0000 87.5%);
	}

	.c-progressive-blur__layer.is--2 {
		-webkit-backdrop-filter: blur(0.1875em);
		backdrop-filter: blur(0.1875em);
		-webkit-mask: linear-gradient(#0000 62.5%, #000 75% 87.5%, #0000 100%);
		mask: linear-gradient(#0000 62.5%, #000 75% 87.5%, #0000 100%);
	}

	.c-progressive-blur__layer.is--3 {
		-webkit-backdrop-filter: blur(0.375em);
		backdrop-filter: blur(0.375em);
		-webkit-mask: linear-gradient(#0000 75%, #000 87.5% 100%);
		mask: linear-gradient(#0000 75%, #000 87.5% 100%);
	}

	.c-progressive-blur__layer.is--4 {
		-webkit-backdrop-filter: blur(0.75em);
		backdrop-filter: blur(0.75em);
		-webkit-mask: linear-gradient(#0000 82%, #000 92% 100%);
		mask: linear-gradient(#0000 82%, #000 92% 100%);
	}

	.c-progressive-blur__layer.is--5 {
		-webkit-backdrop-filter: blur(1.5em);
		backdrop-filter: blur(1.5em);
		-webkit-mask: linear-gradient(#0000 88%, #000 100%);
		mask: linear-gradient(#0000 88%, #000 100%);
	}
</style>
