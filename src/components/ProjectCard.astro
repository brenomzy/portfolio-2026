---
import SanityImage from "./SanityImage.astro";

interface Props {
	project: {
		title: string;
		slug: string | null;
		client?: string | null;
		year?: number | null;
		tags?: string[] | null;
		cover?: { asset?: unknown; alt?: string } | null;
	};
}
const { project } = Astro.props;
const meta = [project.client, project.year].filter(Boolean).join(" · ");
---

<a class="c-card" href={`/work/${project.slug}`}>
	<div class="c-card__media">
		<SanityImage
			image={project.cover}
			alt={project.title}
			sizes="(min-width: 48rem) 45vw, 100vw"
		/>
	</div>
	<div class="c-card__body">
		<h3 class="c-card__title">{project.title}</h3>
		{meta && <p class="c-card__meta">{meta}</p>}
		{
			project.tags && project.tags.length > 0 && (
				<ul class="c-card__tags">
					{project.tags.map((tag) => (
						<li class="c-card__tag">{tag}</li>
					))}
				</ul>
			)
		}
	</div>
</a>

<style>
	.c-card {
		display: grid;
		gap: var(--spacing-s);
		text-decoration: none;
		color: inherit;
	}
	.c-card__media {
		overflow: hidden;
		border-radius: var(--radius-lg);
		border: 1px solid var(--border);
		aspect-ratio: 4 / 3;
	}
	.c-card__media :global(img),
	.c-card__media :global(.c-img-placeholder) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s var(--ease-out-expo);
	}
	.c-card:hover .c-card__media :global(img) {
		transform: scale(1.03);
	}
	.c-card__title {
		font-size: var(--text-step-2);
	}
	.c-card__meta {
		color: var(--text-muted);
	}
	.c-card__tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-3xs);
		list-style: none;
		padding: 0;
		margin-top: var(--spacing-2xs);
	}
	.c-card__tag {
		font-size: var(--text-step--1);
		color: var(--text-muted);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		padding: 0.15em 0.6em;
	}
</style>
