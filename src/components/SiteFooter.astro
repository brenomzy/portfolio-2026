---
import { sanityClient } from "../lib/sanity/client";
import { SITE_SETTINGS_QUERY } from "../lib/sanity/queries";
import FooterGradient from "./FooterGradient.astro";
import Button from "./Button.astro";
import { CONTACT_EMAIL } from "../lib/site";

const settings = await sanityClient.fetch(SITE_SETTINGS_QUERY);

// Contact address is the shared site constant for now (see lib/site.ts), not the
// CMS — keeps every CTA pointing at the same place. brand still comes from CMS.
const email = CONTACT_EMAIL;
const brand = settings?.title ?? "Breno";

// Footer socials — hardcoded for now. Wire to Site Settings once those URLs
// exist in Sanity.
const socials = [
	{ platform: "LinkedIn", url: "https://www.linkedin.com/in/breno-daroz/" },
	{ platform: "X", url: "https://twitter.com/brenomzy" },
];
---

<footer class="c-footer">
	<FooterGradient />
	<div class="c-footer__inner">
		<div class="c-footer__top">
			<div class="c-footer__lead">
				<p class="c-footer__eyebrow">Have something in mind?</p>
				<p class="c-footer__headline">Let’s work together</p>
				<Button
					label="Get in touch"
					href={`mailto:${email}`}
					data-copy-email={email}
					class="c-footer__btn"
				/>
			</div>

			<div class="c-footer__meta">
				<ul class="c-footer__socials">
					{
						socials.map((s) => (
							<li>
								<a href={s.url} target="_blank" rel="me noopener noreferrer">
									{s.platform}
								</a>
							</li>
						))
					}
				</ul>
				<p class="c-footer__loc">Based in Brazil · BRT</p>
			</div>
		</div>

		<!-- Wordmark scaled to span the container at natural bold proportions
		     (no tracking). The viewBox is set from the text's measured bounding
		     box in script (fitWordmark), so width:100% scales the glyphs to full
		     width; height follows and is clipped by the footer if it overflows.
		     Initial viewBox is an approximation refined on load. -->
		<svg
			class="c-footer__wordmark"
			viewBox="0 -78 330 84"
			preserveAspectRatio="xMidYMid meet"
			aria-hidden="true"
		>
			<text>{brand}</text>
		</svg>
	</div>
</footer>

<style>
	/* Reveal footer ----------------------------------------------------------
	 * Pinned to the bottom of the viewport, behind #main (z-index:1 + opaque,
	 * set in Base.astro). #main lifts away on scroll to uncover it. Kept SHORTER
	 * than the viewport so it never reaches up behind the translucent header
	 * (see note in Base.astro). overflow:hidden clips the parallax drift + the
	 * oversized wordmark. */
	.c-footer {
		position: sticky;
		bottom: 0;
		z-index: 0;
		min-height: 58svh;
		display: flex;
		overflow: hidden;
		/* Branded orange panel (the WebGL gradient renders on top of this fallback
		 * colour — see FooterGradient.astro). Theme-independent, so text colours
		 * are constants tuned to read on the orange. */
		background-color: #c7400c;
		--footer-fg: #fff4ec;
		color: var(--footer-fg);
		--footer-muted: color-mix(in oklab, var(--footer-fg) 64%, transparent);
		--footer-line: color-mix(in oklab, var(--footer-fg) 26%, transparent);
	}
	:global(html[data-theme="dark"]) .c-footer {
		background-color: #152b5a; /* night-blue fallback under the canvas */
	}

	.c-footer__inner {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-s);
		width: 100%;
		max-width: var(--container-content);
		margin-inline: auto;
		/* Above the gradient canvas (which is position:absolute inside the footer). */
		position: relative;
		z-index: 1;
		/* Generous top padding; no bottom padding so the wordmark reaches the
		 * footer's bottom edge (and its negative margin crops it — see script). */
		padding: var(--spacing-2xl) var(--spacing-m) 0;
		will-change: transform;
	}

	/* Top row: contact card (lead) + meta column, baseline-aligned ----------- */
	.c-footer__top {
		display: flex;
		justify-content: space-between;
		/* Right column sits on the same baseline as the left column's button. */
		align-items: flex-end;
		gap: var(--spacing-l);
		flex-wrap: wrap;
	}

	/* Lead / CTA ------------------------------------------------------------ */
	/* Spacing rhythm: tight gaps (≤ --spacing-s / ~1rem) bind related items;
	 * separate groups get --spacing-m+ (see .c-footer__top gap). */
	.c-footer__eyebrow {
		color: var(--footer-muted);
		font-size: var(--text-step-0);
		margin-bottom: var(--spacing-2xs); /* label hugs the headline */
	}
	.c-footer__headline {
		font-size: var(--text-step-4);
		font-weight: 560;
		letter-spacing: -0.03em;
		line-height: 1.02;
		color: #fff9f4;
		max-width: 14ch;
		/* Single gap to the button — they read as one CTA unit (~1rem). */
		margin-bottom: var(--spacing-s);
	}
	/* The white CTA is the primary Button variant (warm-white bg, ink label);
	 * the component owns its look, the headline's margin owns the spacing. */

	/* Meta column (socials + location) -------------------------------------- */
	.c-footer__meta {
		display: flex;
		flex-direction: column;
		align-items: flex-end; /* hug the right edge, stacked above location */
		gap: var(--spacing-2xs); /* socials ↔ location: related meta */
		font-size: var(--text-step--1);
		text-align: right;
	}
	/* Socials on one line: "LinkedIn / X" — a hairline slash separates them. */
	.c-footer__socials {
		display: flex;
		align-items: center;
		gap: var(--spacing-2xs);
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.c-footer__socials li {
		display: flex;
		align-items: center;
		gap: var(--spacing-2xs);
	}
	.c-footer__socials li + li::before {
		content: "/";
		color: var(--footer-line);
	}
	.c-footer__socials a {
		color: var(--footer-muted);
		text-decoration: none;
		transition: color 0.2s var(--ease-default);
	}
	.c-footer__socials a:hover {
		color: #fff;
	}
	.c-footer__loc {
		color: var(--footer-muted);
		opacity: 0.8;
	}

	/* Narrow viewports: stack the card over the meta, everything left-aligned
	 * (no right-alignment on mobile), and a shorter footer panel. */
	@media (max-width: 40rem) {
		.c-footer {
			min-height: 46svh;
		}
		.c-footer__top {
			flex-direction: column;
			align-items: flex-start;
			gap: var(--spacing-m);
		}
		.c-footer__meta {
			align-items: flex-start;
			text-align: left;
		}
	}

	/* Oversized wordmark — spans the full container width (SVG textLength),
	 * pinned to the footer's bottom edge, softly dissolved by the
	 * progressive-blur overlay. */
	.c-footer__wordmark {
		display: block;
		/* Full-bleed: break out of the centered container to span the whole
		 * viewport width (ignoring the inner's max-width + side padding). The
		 * footer's overflow:hidden clips the sub-pixel 100vw-vs-scrollbar overshoot.
		 * Classic left:50% / -50vw centering, robust against the inner's padding. */
		position: relative;
		left: 50%;
		width: 100vw;
		/* override the global `svg { max-width: 100% }` reset, which would
		 * otherwise clamp 100vw back to the container width. */
		max-width: none;
		margin-left: -50vw;
		height: auto;
		margin-top: auto; /* push to the bottom of the footer */
		/* Bottom crop in vw, not rem — the wordmark is full-bleed (100vw) so its
		 * height scales with viewport width; a vw crop keeps the SAME proportion
		 * cut off at every screen size. A fixed rem would over-crop narrow screens
		 * and under-crop wide ones. */
		margin-bottom: -8vw;
		overflow: visible;
		user-select: none;
	}
	.c-footer__wordmark text {
		/* Archivo Black — single 400 weight (the "Black" is built in). */
		font-family: "Archivo Black", var(--font-sans);
		font-size: 100px; /* arbitrary; the measured viewBox scales it to width */
		font-weight: 400;
		text-transform: uppercase;
		letter-spacing: -0.1em; /* very tight — letters nearly touch at this weight */
		/* Neutral darken — subtle "watermark" wordmark; works on orange + blue. */
		fill: rgba(0, 0, 0, 0.17);
	}
</style>

<script>
	import gsap from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	const reduced = matchMedia("(prefers-reduced-motion: reduce)");
	let st: ScrollTrigger | null = null;
	let ro: ResizeObserver | null = null;

	// Size the wordmark to span the container at natural bold proportions.
	// SVG getBBox() returns the font's LINE box (ascent→descent), which leaves
	// dead space above/below and includes side bearings — so the glyphs don't
	// sit flush. Instead we measure the true INK box via canvas measureText
	// (actualBoundingBox*, font-agnostic) and use THAT as the viewBox: glyphs
	// flush to all four edges, sides aligned to the container. A negative
	// bottom margin then crops the base of the letters (footer clips it).
	let measureCanvas: HTMLCanvasElement | null = null;
	function fitWordmark() {
		const svg = document.querySelector<SVGSVGElement>(".c-footer__wordmark");
		const text = svg?.querySelector("text");
		if (!svg || !text) return;

		const cs = getComputedStyle(text);
		const fs = parseFloat(cs.fontSize) || 100;
		const ls = parseFloat(cs.letterSpacing) || 0;
		const content = (text.textContent || "").trim().toUpperCase();
		if (!content) return;

		measureCanvas ??= document.createElement("canvas");
		const ctx = measureCanvas.getContext("2d");
		if (!ctx) return;
		ctx.font = `${cs.fontWeight} ${fs}px ${cs.fontFamily}`;
		// letterSpacing is supported in Chromium; harmless to skip elsewhere.
		if ("letterSpacing" in ctx) (ctx as unknown as { letterSpacing: string }).letterSpacing = `${ls}px`;

		const m = ctx.measureText(content);
		const x = -m.actualBoundingBoxLeft;
		const y = -m.actualBoundingBoxAscent;
		const w = m.actualBoundingBoxLeft + m.actualBoundingBoxRight;
		const h = m.actualBoundingBoxAscent + m.actualBoundingBoxDescent;
		if (w <= 0 || h <= 0) return;
		svg.setAttribute("viewBox", `${x} ${y} ${w} ${h}`);
		// Bottom crop is now a fixed -8rem in CSS (see .c-footer__wordmark) — no
		// script-driven margin needed.
	}

	// Footer reveal parallax: the inner content drifts UP slower than the page
	// scrolls as #main lifts away, so the footer "rises into place" instead of
	// scrolling 1:1 (the heykuba feel). Driven off #main's bottom edge crossing
	// the viewport — no dependency on the sticky footer's own (awkward) rect.
	function initParallax() {
		st?.kill(); // idempotent: setup() may run twice on the initial load
		st = null;
		const inner = document.querySelector<HTMLElement>(".c-footer__inner");
		if (!inner || reduced.matches) return;

		const tween = gsap.fromTo(
			inner,
			{ y: 64 },
			{
				y: -28,
				ease: "none",
				scrollTrigger: {
					// The footer is 58svh, so at full reveal #main's bottom only rises
					// to ~42% of the viewport — that's as far as the page scrolls. End
					// the drift there so it completes exactly as the footer lands
					// (keep this in sync with the footer's min-height).
					trigger: "#main",
					start: "bottom bottom", // reveal begins
					end: "bottom 40%", // footer essentially full
					scrub: true,
				},
			},
		);
		st = tween.scrollTrigger ?? null;
	}

	// Keep the wordmark fitted to the container width. A ResizeObserver is more
	// reliable than astro:page-load for the FIRST fit — its initial callback runs
	// after layout regardless of script/event ordering. Width-guarded so the
	// SVG's own height change (from a fit) can't re-trigger it into a loop.
	function observeWordmark() {
		const inner = document.querySelector<HTMLElement>(".c-footer__inner");
		if (!inner) return;
		ro?.disconnect();
		let lastW = 0;
		ro = new ResizeObserver(() => {
			const w = inner.clientWidth;
			if (w && w !== lastW) {
				lastW = w;
				fitWordmark();
			}
		});
		ro.observe(inner);
		// Refit once the display face has actually loaded — fallback metrics differ.
		document.fonts?.ready.then(fitWordmark);
		document.fonts?.load('400 1rem "Archivo Black"').then(fitWordmark).catch(() => {});
	}

	function setup() {
		observeWordmark();
		initParallax();
	}

	function cleanup() {
		st?.kill();
		st = null;
		ro?.disconnect();
		ro = null;
		gsap.set(".c-footer__inner", { clearProps: "transform" });
	}

	// Run now (covers the initial load even if astro:page-load already fired) and
	// on every client-side navigation.
	setup();
	document.addEventListener("astro:page-load", setup);
	document.addEventListener("astro:before-swap", cleanup);
</script>
