---
import Logo from "./Logo.astro";
import Button from "./Button.astro";
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="c-header">
	<div class="c-header__inner">
		<a class="c-header__brand" href="/" aria-label="Brone — home" data-reveal>
			<Logo />
		</a>

		<div class="c-header__actions" data-reveal>
			<Button label="Contact me" href="#contact" variant="accent" />
			<ThemeToggle />
		</div>
	</div>
</header>

<style>
	.c-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background-color: color-mix(in srgb, var(--bg) 78%, transparent);
		/* Uniform (non-progressive) blur, em-based to match the progressive-blur
		 * overlay's visual language. See ProgressiveBlur.astro. */
		backdrop-filter: blur(0.85em) saturate(1.3);
		-webkit-backdrop-filter: blur(0.85em) saturate(1.3);
		border-bottom: 1px solid var(--border);
	}
	.c-header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-m);
		max-width: var(--container-content);
		margin-inline: auto;
		padding: var(--spacing-2xs) var(--spacing-m);
		font-size: var(--text-step--1);
	}

	.c-header__brand {
		display: inline-flex;
		color: var(--text);
		border-radius: var(--radius-sm);
	}
	.c-header__brand:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 4px;
	}

	.c-header__actions {
		display: flex;
		align-items: center;
		gap: var(--spacing-xs);
	}
</style>

<script>
	import gsap from "gsap";

	const reduced = matchMedia("(prefers-reduced-motion: reduce)");

	function revealHeader() {
		const brand = document.querySelector<HTMLElement>(".c-header__brand");
		const actions = document.querySelector<HTMLElement>(".c-header__actions");
		if (!brand || !actions) return;

		// Brand, then each action (Contact, toggle) — staggered.
		const items = [brand, ...actions.children] as HTMLElement[];
		gsap.set([brand, actions], { visibility: "visible" });

		if (reduced.matches) return;

		gsap.from(items, {
			autoAlpha: 0,
			filter: "blur(8px)",
			y: -6,
			duration: 0.55,
			stagger: 0.07,
			ease: "expo.out",
			onComplete: () => {
				// Drop the inline blur on everything…
				gsap.set(items, { clearProps: "filter" });
				// …and fully reset the action buttons so GSAP's inline transform
				// props (incl. `scale: none`) don't override their :active press
				// scale. Only the buttons — the brand keeps its [data-reveal]
				// inline visibility.
				gsap.set(Array.from(actions.children), { clearProps: "all" });
			},
		});
	}

	document.addEventListener("astro:page-load", revealHeader);
</script>
