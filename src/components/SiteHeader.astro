---
import { sanityClient } from "../lib/sanity/client";
import { SITE_SETTINGS_QUERY } from "../lib/sanity/queries";
import ThemeToggle from "./ThemeToggle.astro";

const settings = await sanityClient.fetch(SITE_SETTINGS_QUERY);
const nav = settings?.nav ?? [];
const brand = settings?.title ?? "Portfolio";
---

<header class="c-header">
	<div class="c-header__inner">
		<a class="c-header__brand" href="/">{brand}</a>

		<div class="c-header__meta">
			<span class="c-header__status">
				<span class="c-header__dot"></span>Available for work
			</span>
			<time class="c-header__clock js-clock">—</time>
		</div>

		<nav class="c-header__nav" aria-label="Primary">
			{
				nav.map((item) => (
					<a class="c-header__link" href={item.href}>
						{item.label}
					</a>
				))
			}
			<ThemeToggle />
		</nav>
	</div>
</header>

<style>
	.c-header__inner {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: var(--spacing-m);
		max-width: var(--container-content);
		margin-inline: auto;
		padding: var(--spacing-s) var(--spacing-m);
		font-size: var(--text-step--1);
	}
	.c-header__brand {
		justify-self: start;
		font-weight: 600;
		text-decoration: none;
	}
	.c-header__meta {
		display: flex;
		gap: var(--spacing-m);
		font-family: var(--font-mono);
		color: var(--text-muted);
		white-space: nowrap;
	}
	.c-header__status {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
	}
	.c-header__dot {
		width: 0.5em;
		height: 0.5em;
		border-radius: 50%;
		background: #22c55e;
		box-shadow: 0 0 0 0 #22c55e80;
		animation: header-pulse 2s infinite;
	}
	@keyframes header-pulse {
		0% { box-shadow: 0 0 0 0 #22c55e80; }
		70% { box-shadow: 0 0 0 0.5em #22c55e00; }
		100% { box-shadow: 0 0 0 0 #22c55e00; }
	}
	.c-header__nav {
		display: flex;
		align-items: center;
		gap: var(--spacing-s);
		justify-self: end;
	}
	.c-header__link {
		text-decoration: none;
		color: var(--text-muted);
		transition: color 0.2s var(--ease-out-expo);
	}
	.c-header__link:hover {
		color: var(--text);
	}

	/* Collapse the meta row on small screens. */
	@media (max-width: 48rem) {
		.c-header__inner {
			grid-template-columns: 1fr auto;
		}
		.c-header__meta {
			display: none;
		}
	}
</style>

<script>
	function tick() {
		const el = document.querySelector(".js-clock");
		if (!el) return;
		const time = new Intl.DateTimeFormat("en-GB", {
			hour: "2-digit",
			minute: "2-digit",
			timeZone: "America/Sao_Paulo",
		}).format(new Date());
		el.textContent = `São Paulo — ${time}`;
	}
	document.addEventListener("astro:page-load", () => {
		tick();
		setInterval(tick, 30000);
	});
</script>
