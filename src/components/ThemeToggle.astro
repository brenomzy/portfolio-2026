---
/*
 * c-theme-toggle — a segmented light/dark switch. Two cells (☀ sun / 🌙 moon-star,
 * Hugeicons) on a light-grey track, with a theme-aware circular thumb that
 * slides under the active mode. The active icon uses the orange/blue gradient.
 *
 * Flips [data-theme] on <html> and persists to a `theme` cookie (the no-flash init
 * in Base.astro reads it back). On change it runs the diagonal theme-wipe via the
 * View Transitions API (see global.css → is-theme-vt); the thumb-slide plays on the
 * instant / reduced-motion path. Position + active colours are driven off
 * [data-theme] so the control always mirrors the live theme.
 *
 * Keeps the `theme-toggle` view-transition-name so it's lifted out of the page
 * snapshot during the wipe (global.css relies on this name + the class). The track
 * border is a SOLID, theme-INDEPENDENT colour so it never flashes mid-wipe.
 */
import { Moon02Icon, Sun02Icon } from "@hugeicons/core-free-icons";
import HugeIcon from "./HugeIcon.astro";

/*
 * Hugeicons' Moon Star uses the Moon 02 crescent with a four-point sparkle.
 * The free core package does not expose MoonStarIcon yet, so compose that
 * pairing locally until the named export lands.
 */
const MoonStarIcon = [
	...Moon02Icon,
	[
		"path",
		{
			d: "M17.5 2.75C17.79 4.63 18.87 5.71 20.75 6C18.87 6.29 17.79 7.37 17.5 9.25C17.21 7.37 16.13 6.29 14.25 6C16.13 5.71 17.21 4.63 17.5 2.75Z",
			strokeLinecap: "round",
			strokeLinejoin: "round",
		},
	],
] as const;
---

<div class="c-theme-toggle" role="group" aria-label="Colour theme">
	<span class="c-theme-toggle__thumb" aria-hidden="true"></span>

	<button
		type="button"
		class="c-theme-toggle__btn"
		data-theme-set="light"
		aria-label="Light mode"
		aria-pressed="true"
	>
		<HugeIcon
			icon={Sun02Icon}
			class="c-theme-toggle__icon"
			strokeWidth={1.75}
			aria-hidden="true"
		>
			<defs>
				<linearGradient id="theme-light-gradient" x1="4" y1="3" x2="20" y2="21" gradientUnits="userSpaceOnUse">
					<stop stop-color="var(--logo-grad-1)"></stop>
					<stop offset="1" stop-color="var(--logo-grad-2)"></stop>
				</linearGradient>
			</defs>
		</HugeIcon>
	</button>

	<button
		type="button"
		class="c-theme-toggle__btn"
		data-theme-set="dark"
		aria-label="Dark mode"
		aria-pressed="false"
	>
		<HugeIcon
			icon={MoonStarIcon}
			class="c-theme-toggle__icon"
			strokeWidth={1.75}
			aria-hidden="true"
		>
			<defs>
				<linearGradient id="theme-dark-gradient" x1="5" y1="3" x2="21" y2="21" gradientUnits="userSpaceOnUse">
					<stop stop-color="#82adff"></stop>
					<stop offset="1" stop-color="#4779e8"></stop>
				</linearGradient>
			</defs>
		</HugeIcon>
	</button>
</div>

<style>
	.c-theme-toggle {
		--cell-size: 2.25rem;
		--pad: 0.125rem;
		position: relative;
		display: inline-grid;
		grid-template-columns: 1fr 1fr;
		padding: var(--pad);
		border-radius: 999px;
		background: hsl(30 4% 93%);
		font-size: 0.8rem;
		/* Deliberately no view-transition-name: the track should change with the
		 * page wipe while the named thumb and buttons animate above it. */
	}
	:global([data-theme="dark"]) .c-theme-toggle {
		background: hsl(30 3% 18%);
	}

	.c-theme-toggle__thumb {
		position: absolute;
		top: var(--pad);
		left: var(--pad);
		width: var(--cell-size);
		height: var(--cell-size);
		border-radius: 50%;
		background: #fff;
		box-shadow:
			0 1px 2px hsl(0 0% 0% / 0.08),
			0 2px 6px hsl(0 0% 0% / 0.06);
		/* Spring slide between modes (same micro-interaction as the consulting
		 * language toggle). Plays directly on the instant / reduced-motion path. */
		transition: transform 0.45s var(--ease-spring);
		/* Its OWN view-transition snapshot so the slide also plays DURING the theme
		 * wipe: the API tweens the thumb's old→new position (a real slide) instead
		 * of the live CSS transition being skipped (the live DOM isn't painted mid
		 * view-transition). Only the thumb is named — the track keeps riding the page
		 * wipe, so its theme-aware border still never flashes. Timing is set on the
		 * group below. */
		view-transition-name: theme-thumb;
	}
	:global([data-theme="dark"]) .c-theme-toggle__thumb {
		background: #000;
		box-shadow:
			0 0 0 1px hsl(0 0% 100% / 0.04),
			0 1px 2px hsl(0 0% 0% / 0.18),
			0 2px 6px hsl(0 0% 0% / 0.14);
		transform: translateX(100%);
	}

	.c-theme-toggle__btn {
		position: relative;
		z-index: 1;
		display: inline-grid;
		place-items: center;
		width: var(--cell-size);
		height: var(--cell-size);
		padding: 0;
		background: transparent;
		border: none;
		border-radius: 50%;
		cursor: pointer;
		/* Inactive icon — muted ink on the surface track. */
		color: var(--text-muted);
		-webkit-tap-highlight-color: transparent;
		transition: color 0.25s var(--ease-out-expo);
	}
	.c-theme-toggle__icon {
		width: 1.125rem;
		height: 1.125rem;
	}

	/* Each button gets its OWN view-transition snapshot too. Without this, the
	 * named thumb is lifted to the top layer and briefly covers the active icon
	 * (which otherwise rides in the root snapshot, below the thumb). Lifting the
	 * buttons — they come after the thumb in DOM order, so their groups paint
	 * above it — keeps the icons visible on top while the thumb slides under. */
	.c-theme-toggle__btn[data-theme-set="light"] {
		view-transition-name: theme-btn-light;
	}
	.c-theme-toggle__btn[data-theme-set="dark"] {
		view-transition-name: theme-btn-dark;
	}

	/* The active icon picks up the theme's orange or blue brand gradient. */
	:global([data-theme="light"]) .c-theme-toggle__btn[data-theme-set="light"] .c-theme-toggle__icon {
		stroke: url(#theme-light-gradient);
	}
	:global([data-theme="dark"]) .c-theme-toggle__btn[data-theme-set="dark"] .c-theme-toggle__icon {
		stroke: url(#theme-dark-gradient);
	}

	.c-theme-toggle__btn:active {
		scale: 0.96;
	}
	.c-theme-toggle__btn:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	@media (prefers-reduced-motion: reduce) {
		.c-theme-toggle__thumb {
			transition: none;
		}
	}
</style>

<style is:global>
	/* The thumb has its own view-transition snapshot (theme-thumb) so its slide
	 * plays during the theme wipe. Retime the API's default group tween to the
	 * toggle's spring so the in-wipe slide matches the instant-path one, and match
	 * the old/new colour crossfade (orange↔blue) to the same duration. Only applies
	 * to theme changes (.is-theme-vt), never page navigations. Reduced-motion skips
	 * the whole view transition in JS, so this never runs there. */
	:root.is-theme-vt::view-transition-group(theme-thumb) {
		animation-duration: 0.45s;
		animation-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1);
	}
	:root.is-theme-vt::view-transition-old(theme-thumb),
	:root.is-theme-vt::view-transition-new(theme-thumb) {
		animation-duration: 0.45s;
	}
	/* Icons are lifted too (so they stay above the sliding thumb); match their
	 * muted↔white crossfade to the same duration so nothing pops out of sync. */
	:root.is-theme-vt::view-transition-old(theme-btn-light),
	:root.is-theme-vt::view-transition-new(theme-btn-light),
	:root.is-theme-vt::view-transition-old(theme-btn-dark),
	:root.is-theme-vt::view-transition-new(theme-btn-dark) {
		animation-duration: 0.45s;
	}
</style>

<script>
	/* ── Theme persistence + view-transition wipe ─────────────────────────────── */
	type ViewTransitionDoc = Document & {
		startViewTransition?: (cb: () => void) => { finished: Promise<void> };
	};
	const reduced = matchMedia("(prefers-reduced-motion: reduce)");

	function readTheme(): "light" | "dark" {
		const m = document.cookie.match(/(?:^|;\s*)theme=(dark|light)/);
		if (m) return m[1] as "light" | "dark";
		return matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
	}

	// Re-INSERT the favicon link (not just mutate href) so Chrome repaints the tab
	// icon and skips its sticky favicon cache.
	function syncFavicon(theme: string) {
		const old = document.querySelector<HTMLLinkElement>('link[rel="icon"][type="image/svg+xml"]');
		if (!old) return;
		const fresh = old.cloneNode() as HTMLLinkElement;
		fresh.href = `/favicon-${theme}.svg`;
		old.replaceWith(fresh);
	}

	// aria-pressed reflects the active mode on both buttons.
	function syncAria(theme: string) {
		document.querySelectorAll<HTMLButtonElement>(".c-theme-toggle__btn").forEach((b) => {
			b.setAttribute("aria-pressed", String(b.dataset.themeSet === theme));
		});
	}

	function setTheme(next: "light" | "dark") {
		document.documentElement.dataset.theme = next;
		// 1-year cookie; Lax so it rides top-level navigations but not cross-site.
		document.cookie = `theme=${next}; path=/; max-age=31536000; samesite=lax`;
		syncFavicon(next);
		syncAria(next);
	}

	function applyTheme(next: "light" | "dark") {
		const root = document.documentElement;
		if (root.dataset.theme === next) return; // already active — no-op
		const doc = document as ViewTransitionDoc;

		// No View Transitions / reduced-motion → swap instantly (the thumb slides).
		if (!doc.startViewTransition || reduced.matches) {
			setTheme(next);
			return;
		}

		// `is-theme-vt` scopes the clip-path wipe (global.css) to theme changes only.
		root.classList.add("is-theme-vt");
		const transition = doc.startViewTransition(() => setTheme(next));
		transition.finished.finally(() => root.classList.remove("is-theme-vt"));
	}

	document.addEventListener("astro:page-load", () => {
		syncAria(readTheme());
		document.querySelectorAll<HTMLButtonElement>(".c-theme-toggle__btn").forEach((b) => {
			b.addEventListener("click", () => applyTheme(b.dataset.themeSet as "light" | "dark"));
		});
	});

	// A view-transition swap brings in the new page's static <html> (no data-theme),
	// so re-apply theme + favicon + aria from the cookie before paint.
	document.addEventListener("astro:after-swap", () => {
		const theme = readTheme();
		document.documentElement.dataset.theme = theme;
		syncFavicon(theme);
		syncAria(theme);
	});
</script>
