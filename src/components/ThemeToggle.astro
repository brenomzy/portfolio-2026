---
/*
 * c-theme-toggle — icon-only square that flips [data-theme] on <html> and
 * persists to a `theme` cookie (the no-flash init in Base.astro reads it back).
 *
 * Square sized to match the CTA Button's height (3em) so it reads as a sibling.
 * Shows the TARGET mode: moon in light (click → go dark), sun in dark (→ go light).
 * On toggle the icons run a vertical rotate-and-slide swap inside a clipped window,
 * on --ease-default.
 */
---

<button
	type="button"
	class="c-theme-toggle js-theme-toggle"
	data-theme-toggle
	aria-label="Toggle colour theme"
>
	<span class="c-theme-toggle__icon" aria-hidden="true">
		<span class="c-theme-toggle__icon-box">
			<!-- Moon — shown in light mode (click → go dark). Phosphor "moon-stars". -->
			<!-- stroke-width 8 on the filled paths ≈ Phosphor's bold cut (16→24 units). -->
			<svg viewBox="0 0 256 256" width="100%" fill="currentColor" stroke="currentColor" stroke-width="8" stroke-linejoin="round">
				<path d="M240,96a8,8,0,0,1-8,8H216v16a8,8,0,0,1-16,0V104H184a8,8,0,0,1,0-16h16V72a8,8,0,0,1,16,0V88h16A8,8,0,0,1,240,96ZM144,56h8v8a8,8,0,0,0,16,0V56h8a8,8,0,0,0,0-16h-8V32a8,8,0,0,0-16,0v8h-8a8,8,0,0,0,0,16Zm72.77,97a8,8,0,0,1,1.43,8A96,96,0,1,1,95.07,37.8a8,8,0,0,1,10.6,9.06A88.07,88.07,0,0,0,209.14,150.33,8,8,0,0,1,216.77,153Zm-19.39,14.88c-1.79.09-3.59.14-5.38.14A104.11,104.11,0,0,1,88,64c0-1.79,0-3.59.14-5.38A80,80,0,1,0,197.38,167.86Z"></path>
			</svg>
		</span>
		<span class="c-theme-toggle__icon-box is--absolute">
			<!-- Sun — shown in dark mode (click → go light). Phosphor "sun". -->
			<svg viewBox="0 0 256 256" width="100%" fill="currentColor" stroke="currentColor" stroke-width="8" stroke-linejoin="round">
				<path d="M120,40V32a8,8,0,0,1,16,0v8a8,8,0,0,1-16,0Zm72,88a64,64,0,1,1-64-64A64.07,64.07,0,0,1,192,128Zm-16,0a48,48,0,1,0-48,48A48.05,48.05,0,0,0,176,128ZM58.34,69.66A8,8,0,0,0,69.66,58.34l-8-8A8,8,0,0,0,50.34,61.66Zm0,116.68-8,8a8,8,0,0,0,11.32,11.32l8-8a8,8,0,0,0-11.32-11.32ZM192,72a8,8,0,0,0,5.66-2.34l8-8a8,8,0,0,0-11.32-11.32l-8,8A8,8,0,0,0,192,72Zm5.66,114.34a8,8,0,0,0-11.32,11.32l8,8a8,8,0,0,0,11.32-11.32ZM40,120H32a8,8,0,0,0,0,16h8a8,8,0,0,0,0-16Zm88,88a8,8,0,0,0-8,8v8a8,8,0,0,0,16,0v-8A8,8,0,0,0,128,208Zm96-88h-8a8,8,0,0,0,0,16h8a8,8,0,0,0,0-16Z"></path>
			</svg>
		</span>
	</span>
</button>

<style>
	.c-theme-toggle {
		/* Square, sized to the CTA Button's 3em height so they align as siblings. */
		display: inline-grid;
		place-items: center;
		width: 3em;
		height: 3em;
		font-size: 0.75rem;
		/* Theme-INDEPENDENT, fully OPAQUE border. The toggle has its own
		 * view-transition-name, so its old/new snapshots cross-fade on a theme
		 * change. A per-theme colour blends light→dark mid-fade; a *translucent*
		 * constant colour still shifts because it composites over the background,
		 * which itself crossfades (the residual flash on switch-to-dark). A solid
		 * colour is identical in both snapshots — nothing to blend, no flash. */
		border: 1px solid #857e74;
		/* Circle — a deliberate counterpoint to the squared Buttons. */
		border-radius: 50%;
		background-color: var(--surface);
		color: var(--text);
		cursor: pointer;
		position: relative;
		overflow: hidden;
		-webkit-tap-highlight-color: transparent;
		/* Lifts the toggle out of the theme-wipe's page snapshot so its icon
		 * animation plays live during the wipe (see global.css → is-theme-vt). */
		view-transition-name: theme-toggle;
		/* No hover state — just a tactile press, matching the Buttons. The press
		 * scale-down is snappy (override on :active), settle is smooth. */
		transition:
			background-color 0.2s var(--ease-default),
			scale 0.3s var(--ease-default);
	}

	.c-theme-toggle:active {
		scale: 0.92;
		transition-duration: 0.1s;
	}

	.c-theme-toggle:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	/* ── Icon — vertical rotate-and-slide conveyor inside a clipped window ───── */
	.c-theme-toggle__icon {
		position: relative;
		width: 1.5em;
		height: 1.5em;
		overflow: hidden;
	}
	.c-theme-toggle__icon-box {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		transition:
			transform 0.45s var(--ease-default),
			opacity 0.45s var(--ease-default);
	}

	/* Light (base): sun in view, moon parked below and pre-rotated. */
	.c-theme-toggle__icon-box {
		transform: translateY(0) rotate(0deg);
		opacity: 1;
	}
	.c-theme-toggle__icon-box.is--absolute {
		transform: translateY(120%) rotate(90deg);
		opacity: 0;
	}

	/* Dark: sun exits upward, moon rises into place. */
	:global([data-theme="dark"]) .c-theme-toggle__icon-box {
		transform: translateY(-120%) rotate(-90deg);
		opacity: 0;
	}
	:global([data-theme="dark"]) .c-theme-toggle__icon-box.is--absolute {
		transform: translateY(0) rotate(0deg);
		opacity: 1;
	}

	/* Respect reduced-motion: keep the swap, drop the travel. */
	@media (prefers-reduced-motion: reduce) {
		.c-theme-toggle__icon-box {
			transition: opacity 0.2s linear;
			transform: none !important;
		}
		.c-theme-toggle__icon-box.is--absolute {
			opacity: 0;
		}
		:global([data-theme="dark"]) .c-theme-toggle__icon-box {
			opacity: 0;
		}
		:global([data-theme="dark"]) .c-theme-toggle__icon-box.is--absolute {
			opacity: 1;
		}
	}
</style>

<script>
	type ViewTransitionDoc = Document & {
		startViewTransition?: (cb: () => void) => { finished: Promise<void> };
	};

	const reduced = matchMedia("(prefers-reduced-motion: reduce)");

	// Tab icon follows the site theme: orange mark on light, blue on dark.
	// (Initial load is handled by the no-flash script in Base.astro.)
	// Re-INSERTING the link (not just mutating href) is what reliably makes
	// Chrome repaint the tab icon and skip its sticky favicon cache.
	function syncFavicon(theme: string) {
		const old = document.querySelector<HTMLLinkElement>(
			'link[rel="icon"][type="image/svg+xml"]',
		);
		if (!old) return;
		const fresh = old.cloneNode() as HTMLLinkElement;
		fresh.href = `/favicon-${theme}.svg`;
		old.replaceWith(fresh);
	}

	function setTheme(next: "light" | "dark") {
		document.documentElement.dataset.theme = next;
		// 1-year cookie; Lax so it rides top-level navigations but not cross-site.
		document.cookie = `theme=${next}; path=/; max-age=31536000; samesite=lax`;
		syncFavicon(next);
	}

	function toggleTheme() {
		const root = document.documentElement;
		const next = root.dataset.theme === "dark" ? "light" : "dark";
		const doc = document as ViewTransitionDoc;

		// No View Transitions support / reduced-motion → swap instantly.
		if (!doc.startViewTransition || reduced.matches) {
			setTheme(next);
			return;
		}

		// `is-theme-vt` scopes the clip-path wipe (see global.css) so it only runs
		// for theme changes, never for page navigations (which also transition root).
		root.classList.add("is-theme-vt");
		const transition = doc.startViewTransition(() => setTheme(next));
		transition.finished.finally(() => root.classList.remove("is-theme-vt"));
	}

	// Bind on every navigation so the button works after View Transitions.
	document.addEventListener("astro:page-load", () => {
		const btn = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
		btn?.addEventListener("click", toggleTheme);
	});

	// View-transition head swaps replace the favicon <link> with the new page's
	// static (light) default — re-sync it to the active theme after each swap.
	document.addEventListener("astro:after-swap", () => {
		syncFavicon(document.documentElement.dataset.theme ?? "light");
	});
</script>
