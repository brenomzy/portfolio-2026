---
/*
 * c-work — the Work section (the "editorial grid" direction, chosen from the
 * /lab prototypes). Two columns, the right column riding low for an
 * asymmetric rhythm; 16:9 thumbnails; cards reveal on scroll.
 *
 * Clicking a card opens ProjectModal (mounted in index.astro outside #main):
 * the thumbnail flies into the modal hero via GSAP Flip. Cards keep a real
 * /work/[slug] href as the no-JS fallback; data-astro-reload keeps Astro's
 * ClientRouter from intercepting the click before the modal's preventDefault.
 */
import type { WorkProject } from "../lib/work-projects";

interface Props {
	projects: WorkProject[];
}
const { projects } = Astro.props;
---

<section class="c-work" id="work" aria-label="Selected work">
	<h2 class="c-work__heading js-work-reveal" data-reveal>Selected work</h2>

	<div class="c-work__grid">
		{
			projects.map((p) => (
				<a
					class="c-work__card js-work-card js-work-reveal"
					href={`/work/${p.slug}`}
					data-work-project={p.id}
					data-astro-reload
					data-reveal
				>
					<span class="c-work__frame">
						<span class="c-work__media">
							<img src={p.cover} alt={p.title} loading="lazy" />
							<span class="c-work__scrim" aria-hidden="true"></span>
							<span class="c-work__description">{p.summary}</span>
						</span>
					</span>
					<span class="c-work__meta">
						<span class="c-work__title">{p.title}</span>
						<span class="c-work__tag">{p.category}</span>
					</span>
				</a>
			))
		}
	</div>
</section>

<style>
	.c-work {
		max-width: var(--container-content);
		margin-inline: auto;
		/* Tighter top so the section sits up under the hero; generous bottom. */
		padding: var(--spacing-l) var(--content-gutter) var(--spacing-3xl);
	}
	.c-work__heading {
		font-size: var(--text-step-3);
		margin-bottom: var(--spacing-m);
	}

	.c-work__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		/* Row gap trimmed (was 2xl) so the second row peeks into view on load —
		 * the big 16:9 thumbnails are tall, so the 2xl rhythm only fit one row. */
		gap: var(--spacing-xl) var(--spacing-m);
	}
	.c-work__card {
		text-decoration: none;
		color: var(--text);
	}
	/* Frame = the hover-scale target + carrier for the gradient border. No
	 * overflow clip here so the border can sit just outside the tile. */
	.c-work__frame {
		position: relative;
		--preview-shell-radius: var(--radius-lg);
		display: block;
	}
	/* 1px border ring, behind the opaque tile (square — no radius). TWO layers on
	 * it: ::before is the faint hairline that's always on; ::after is the brand
	 * glow whose centre tracks the cursor (--card-mouse-x/y, set by the script
	 * below) and which FADES IN on hover. */
	.c-work__frame::before,
	.c-work__frame::after {
		content: "";
		position: absolute;
		inset: -1px;
		z-index: 0;
		/* Concentric with the capped preview shell plus the 1px ring offset. */
		border-radius: calc(var(--preview-shell-radius) + 1px);
	}
	.c-work__frame::before {
		background: var(--card-border-base);
	}
	/* Stripe-style glow: a bright hot core (--card-glow-hot) → brand gradient
	 * (logo/footer palette: orange in light, blue in dark) → transparent. */
	.c-work__frame::after {
		background: radial-gradient(
			340px circle at var(--card-mouse-x, -400px) var(--card-mouse-y, -400px),
			var(--card-glow-core) 0%,
			var(--card-glow-hot) 18%,
			var(--logo-grad-1) 34%,
			var(--card-glow-edge) 58%,
			transparent 82%
		);
		opacity: 0;
		transition: opacity 0.4s var(--ease-out-expo);
	}
	.c-work__media {
		position: relative;
		z-index: 1;
		display: block;
		overflow: hidden;
		border-radius: var(--preview-shell-radius);
		/* Theme-aware fallback behind the real first-frame poster. Opaque, so it
		 * masks all but the 1px gradient-border ring behind it. */
		background: var(--thumb-bg);
	}
	.c-work__media img {
		display: block;
		position: relative;
		width: 100%;
		height: auto;
		min-width: 0;
		aspect-ratio: 1918 / 944;
		object-fit: cover;
		/* will-change below promotes this img to its own GPU layer, which Chromium
		 * then won't clip to .c-work__media's rounded corners — so round the layer
		 * itself (inherits the media's --radius-md) to keep the corners crisp. */
		border-radius: inherit;
		outline: 1px solid rgb(0 0 0 / 0.1);
		outline-offset: -1px;
		box-shadow: var(--shadow-3);
		/* Inner zoom on hover. will-change keeps the GPU layer warm (no shimmer);
		 * only the image scales, never the card. */
		transition: transform 0.45s var(--ease-out-expo);
		will-change: transform;
	}
	.c-work__scrim {
		position: absolute;
		z-index: 2;
		inset: 35% 0 0;
		background: linear-gradient(to bottom, transparent, rgb(8 7 6 / 0.88));
		opacity: 0;
		transition: opacity 0.45s var(--ease-out-expo);
	}
	.c-work__description {
		position: absolute;
		z-index: 3;
		left: clamp(1rem, 2vw, 1.5rem);
		right: clamp(1rem, 2vw, 1.5rem);
		bottom: clamp(1rem, 2vw, 1.5rem);
		max-width: 32rem;
		color: #fff;
		font-size: var(--text-step-0);
		font-weight: 500;
		line-height: 1.35;
		text-wrap: pretty;
		opacity: 0;
		transition: opacity 0.2s ease-out;
	}
	[data-theme="dark"] .c-work__media img {
		outline-color: rgb(255 255 255 / 0.1);
	}
	@media (hover: hover) and (pointer: fine) {
		/* Scoped to the FRAME, not the whole card — hovering the title/meta text
		 * below shouldn't touch the thumbnail. Only the image zooms (inside its
		 * clipped media box); the cursor glow fades in. The card itself never
		 * scales. */
		.c-work__frame:hover::after {
			opacity: 1;
		}
		.c-work__frame:hover .c-work__media img {
			transform: scale(1.025);
		}
		.c-work__frame:hover .c-work__scrim,
		.c-work__frame:hover .c-work__description {
			opacity: 1;
		}
	}
	/* Keyboard parity — same zoom + glow on focus (works on touch/no-hover too). */
	.c-work__card:focus-visible .c-work__frame::after {
		opacity: 1;
	}
	.c-work__card:focus-visible .c-work__media img {
		transform: scale(1.025);
	}
	.c-work__card:focus-visible .c-work__scrim,
	.c-work__card:focus-visible .c-work__description {
		opacity: 1;
	}
	.c-work__meta {
		display: grid;
		gap: 0.05rem;
		padding-top: var(--spacing-xs);
		font-size: var(--text-step--1);
		line-height: 1.3;
	}
	.c-work__title {
		font-weight: 560;
	}
	.c-work__tag {
		color: var(--text-muted);
		/* Small editorial caps. font-size in rem (0.625rem = 10px); letter-spacing
		 * stays in em so the tracking scales with the type. */
		font-size: 0.75rem;
	}

	@media (max-width: 40rem) {
		.c-work__grid {
			grid-template-columns: 1fr;
			gap: var(--spacing-l);
		}
	}
	@media (max-width: 48rem), (hover: none), (pointer: coarse) {
		.c-work__scrim,
		.c-work__description {
			display: none;
		}
	}
</style>

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";
	import { CustomEase } from "gsap/CustomEase";
	import { SplitText } from "gsap/SplitText";
	import { whenRevealable } from "../lib/page-reveal";

	gsap.registerPlugin(ScrollTrigger, CustomEase, SplitText);

	const reduced = matchMedia("(prefers-reduced-motion: reduce)");
	// Same premium ease-out as the modal (shared CustomEase registry).
	const EASE_OUT =
		CustomEase.get("brand-out") ?? CustomEase.create("brand-out", "0.16,1,0.3,1");

	let started = false;
	let triggers: ScrollTrigger[] = [];
	let descriptionCleanups: Array<() => void> = [];
	let descriptionGeneration = 0;
	let setupRoot: HTMLElement | null = null;

	function cleanupDescriptions() {
		descriptionGeneration += 1;
		descriptionCleanups.forEach((cleanup) => cleanup());
		descriptionCleanups = [];
	}

	async function setupDescriptions() {
		cleanupDescriptions();
		const generation = descriptionGeneration;
		await Promise.race([
			document.fonts.ready,
			new Promise((resolve) => window.setTimeout(resolve, 1200)),
		]);
		if (generation !== descriptionGeneration) return;

		const staticDescriptions = matchMedia(
			"(max-width: 40rem), (hover: none), (pointer: coarse), (prefers-reduced-motion: reduce)",
		).matches;

		document.querySelectorAll<HTMLElement>(".c-work__frame").forEach((frame) => {
			const description = frame.querySelector<HTMLElement>(
				".c-work__description",
			);
			const card = frame.closest<HTMLElement>(".c-work__card");
			if (!description || !card) return;

			if (staticDescriptions) {
				gsap.set(description, { autoAlpha: 0 });
				return;
			}

			const split = SplitText.create(description, {
				type: "lines",
				linesClass: "c-work__description-line",
			});
			const lines = split.lines;
			gsap.set(lines, { autoAlpha: 0, y: 12, filter: "blur(8px)" });

			const showLines = () =>
				gsap.to(lines, {
					autoAlpha: 1,
					y: 0,
					filter: "blur(0px)",
					duration: 0.58,
					ease: "power3.out",
					stagger: 0.08,
					overwrite: true,
				});
			const hideLines = () =>
				gsap.to(lines, {
					autoAlpha: 0,
					y: 8,
					filter: "blur(6px)",
					duration: 0.24,
					ease: "power2.in",
					stagger: 0.035,
					overwrite: true,
				});

			frame.addEventListener("pointerenter", showLines);
			frame.addEventListener("pointerleave", hideLines);
			card.addEventListener("focusin", showLines);
			card.addEventListener("focusout", hideLines);

			descriptionCleanups.push(() => {
				gsap.killTweensOf(lines);
				frame.removeEventListener("pointerenter", showLines);
				frame.removeEventListener("pointerleave", hideLines);
				card.removeEventListener("focusin", showLines);
				card.removeEventListener("focusout", hideLines);
				split.revert();
			});
		});
	}

	function killTriggers() {
		triggers.forEach((t) => t.kill());
		triggers = [];
	}

	// Reveal heading + cards as a slide-up. A ScrollTrigger.batch staggers items
	// that enter together: those in the first viewport fire as soon as this runs
	// (i.e. after the hero), the rest as they scroll into view.
	function reveal() {
		if (started || reduced.matches) return;
		started = true;
		const items = gsap.utils.toArray<HTMLElement>(".js-work-reveal");
		if (!items.length) return;
		triggers = ScrollTrigger.batch(items, {
			// Fire the moment an element's top enters the viewport (top at the bottom
			// edge). The asymmetric grid lets the second row PEEK on load (tops at
			// ~95–99vh on shorter desktops); "top 92%" left those peeking cards
			// hidden, so only the first row revealed. "top bottom" reveals anything
			// even partially in view as part of the initial stagger.
			start: "top bottom",
			once: true,
			onEnter: (batch) =>
				gsap.to(batch, {
					autoAlpha: 1,
					y: 0,
					duration: 0.8,
					ease: EASE_OUT,
					stagger: 0.1,
					overwrite: true,
				}),
		});
		ScrollTrigger.refresh();
	}

	function setup() {
		const root = document.querySelector<HTMLElement>(".c-work");
		if (!root || root === setupRoot) return;
		setupRoot = root;
		const items = gsap.utils.toArray<HTMLElement>(".js-work-reveal");
		if (!items.length) return;
		killTriggers();
		void setupDescriptions();
		started = false;
		if (reduced.matches) {
			gsap.set(items, { autoAlpha: 1, y: 0 });
			return;
		}
		// Park hidden + down (the data-reveal CSS guard prevents a pre-JS flash).
		gsap.set(items, { autoAlpha: 0, y: 40 });
		// On a page transition, don't even start waiting for the hero (or the
		// fallback timer) until the wipe has uncovered — otherwise the gated hero
		// fires late and this 2.4s backstop wins, revealing the cards BEFORE the
		// hero ("projects shows first"). Resolves immediately on a normal load.
		whenRevealable().then(() => {
			// Sequence the reveal AFTER the hero intro; a timeout backstops the case
			// where the hero signal never arrives (e.g. reduced motion / other entry).
			document.addEventListener("hero:work-ready", reveal, { once: true });
			window.setTimeout(reveal, 2200);
		});
	}

	setup();
	document.addEventListener("astro:page-load", setup);
	document.addEventListener("astro:before-swap", () => {
		setupRoot = null;
		killTriggers();
		cleanupDescriptions();
	});
</script>

<script>
	// Cursor-tracked gradient border (Stripe-bento style). Writes the pointer's
	// position within a card to --card-mouse-x/y on its .c-work__frame; the
	// frame's ::before centres a brand-gradient blob there, so the 1px border
	// glows under the cursor. Off-pointer the vars are cleared and the CSS
	// default parks the blob far off-card, leaving just the hairline base.
	let glowRoot: HTMLElement | null = null;

	function bindCardGlow() {
		if (!matchMedia("(hover: hover) and (pointer: fine)").matches) return;
		const grid = document.querySelector<HTMLElement>(".c-work__grid");
		if (!grid || grid === glowRoot) return;
		glowRoot = grid;

		// Set the vars directly in the handler — pointermove is already paced by
		// the browser, and writing two custom props is cheap (no layout). (rAF
		// batching would stall while the tab is backgrounded.)
		grid.addEventListener("pointermove", (e) => {
			const f = (e.target as Element).closest<HTMLElement>(".c-work__frame");
			if (!f) return;
			const r = f.getBoundingClientRect();
			f.style.setProperty("--card-mouse-x", `${e.clientX - r.left}px`);
			f.style.setProperty("--card-mouse-y", `${e.clientY - r.top}px`);
		});
		// No pointer-out reset: the glow disappears via its opacity fade (gated on
		// :hover), so the position can stay put and fade cleanly in place rather
		// than jumping the blob off-card mid-fade.
	}

	bindCardGlow();
	document.addEventListener("astro:page-load", bindCardGlow);
	document.addEventListener("astro:before-swap", () => {
		glowRoot = null;
	});
</script>
