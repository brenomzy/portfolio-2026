---
import { ClientRouter } from "astro:transitions";
import ProgressiveBlur from "../components/ProgressiveBlur.astro";
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
// Display face for the footer wordmark only (single 400 weight — the "Black").
import "@fontsource/archivo-black";
import "../styles/global.css";

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = "Portfolio of Breno — designer & developer building fast, accessible websites.",
} = Astro.props;

const siteName = "Breno";
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="canonical" href={canonical} />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta name="twitter:card" content="summary_large_image" />

		<!-- No-flash theme init: runs before paint, before <body> renders.
			 Preference is persisted in a `theme` cookie (see ThemeToggle.astro). -->
		<script is:inline>
			(() => {
				const root = document.documentElement;
				// Marks JS as available, so CSS can hide reveal targets pre-animation
				// without ever hiding them for no-JS / crawlers.
				root.classList.add("js");
				const m = document.cookie.match(/(?:^|;\s*)theme=(dark|light)/);
				const theme =
					(m && m[1]) ??
					(matchMedia("(prefers-color-scheme: dark)").matches
						? "dark"
						: "light");
				root.dataset.theme = theme;
			})();
		</script>

		<ClientRouter />
	</head>

	<body>
		<a class="c-skip-link" href="#main">Skip to content</a>
		<slot name="header" />
		<main id="main">
			<slot />
		</main>
		<slot name="footer" />
		<ProgressiveBlur />

		<style>
			/* Footer reveal: #main sits above the footer (which is sticky to the
			 * viewport bottom — see SiteFooter.astro) and must be opaque so it hides
			 * the footer until the page scrolls past it.
			 *
			 * NOTE: the footer is kept SHORTER than the viewport on purpose. A full
			 * 100svh footer would, while pinned at the bottom, also reach up behind
			 * the translucent header — whose backdrop-filter would then sample the
			 * dark footer and tint the nav. Keeping the footer < viewport height
			 * leaves the header backdrop on #main only. */
			#main {
				position: relative;
				z-index: 1;
				background-color: var(--bg);
			}

			.c-skip-link {
				position: absolute;
				left: var(--spacing-s);
				top: var(--spacing-s);
				z-index: 100;
				padding: var(--spacing-2xs) var(--spacing-s);
				background-color: var(--accent);
				color: var(--accent-contrast);
				border-radius: var(--radius-md);
				transform: translateY(-150%);
				transition: transform 0.2s var(--ease-out-expo);
			}

			.c-skip-link:focus-visible {
				transform: translateY(0);
			}
		</style>
	</body>
</html>
