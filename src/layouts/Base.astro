---
import { ClientRouter } from "astro:transitions";
import ProgressiveBlur from "../components/ProgressiveBlur.astro";
import PageTransition from "../components/PageTransition.astro";
import "@fontsource-variable/geist";
// Manrope (variable) — headings only; Geist stays the body face.
import "@fontsource-variable/manrope";
// Display face for the footer wordmark only (single 400 weight — the "Black").
import "@fontsource/archivo-black";
import "../styles/global.css";

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = "Portfolio of Breno Daroz — design engineer & Webflow developer building fast, accessible websites.",
} = Astro.props;

const siteName = "Breno";
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
// Absolute URL so social crawlers (LinkedIn, Slack, X) can fetch the card image.
const ogImage = new URL("/og.png", Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!-- Favicons. SVG is theme-aware: the no-flash script below (and the theme
		     toggle) swaps light/dark variants to track the site theme. Safari
		     ignores SVG favicons and falls back to the ICO (static orange mark,
		     16/32/48); iOS home screens take the apple-touch PNG. -->
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href="/favicon-light.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="canonical" href={canonical} />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={ogImage} />

		<!-- No-flash theme init: runs before paint, before <body> renders.
			 Preference is persisted in a `theme` cookie (see ThemeToggle.astro). -->
		<script is:inline>
			(() => {
				const root = document.documentElement;
				// Marks JS as available, so CSS can hide reveal targets pre-animation
				// without ever hiding them for no-JS / crawlers.
				root.classList.add("js");
				const m = document.cookie.match(/(?:^|;\s*)theme=(dark|light)/);
				const theme =
					(m && m[1]) ??
					(matchMedia("(prefers-color-scheme: dark)").matches
						? "dark"
						: "light");
				root.dataset.theme = theme;
				// Favicon tracks the site theme (orange mark on light, blue on dark).
				const fav = document.querySelector(
					'link[rel="icon"][type="image/svg+xml"]',
				);
				if (fav) fav.href = `/favicon-${theme}.svg`;
			})();
		</script>

		<ClientRouter />
	</head>

	<body>
		<a class="c-skip-link" href="#main">Skip to content</a>
		<slot name="header" />
		<div class="c-page-shell" data-page-shell>
			<main id="main">
				<slot />
			</main>
			<slot name="footer" />
		</div>
		<slot name="modal" />
		<ProgressiveBlur />
		<PageTransition />

		<!-- Global copy-confirmation popover. Positioned from the clicked CTA so
		     the feedback feels attached to the action while staying outside clipped
		     button/section stacking contexts. -->
		<div class="c-copy-popover" role="status" aria-live="polite" data-copy-popover>
			<span class="c-copy-popover__text"></span>
		</div>

		<style>
			/* Dayy/Vaul-style page wrapper: current scrollY is the transform origin,
			 * so the visible content holds its place at any scroll position. */
			.c-page-shell {
				position: relative;
				background-color: var(--bg);
				transform-origin: 50% var(--pmodal-scroll-y, 0px);
				clip-path: inset(0 0 0 0 round 0);
				transition:
					transform 0.5s cubic-bezier(0.32, 0.72, 0, 1),
					border-radius 0.5s cubic-bezier(0.32, 0.72, 0, 1),
					clip-path 0.5s cubic-bezier(0.32, 0.72, 0, 1);
			}
			:global(.c-header) {
				transition: transform 0.5s cubic-bezier(0.32, 0.72, 0, 1);
			}
			:global(body) {
				transition: background-color 0.5s cubic-bezier(0.32, 0.72, 0, 1);
			}
			:global(body.is-project-open) {
				background-color: var(--pmodal-stage-bg);
			}
			.c-page-shell::after {
				content: "";
				position: absolute;
				inset: 0;
				z-index: 90;
				background-color: rgb(14 10 7 / 0.5);
				backdrop-filter: blur(0.5em);
				-webkit-backdrop-filter: blur(0.5em);
				opacity: 0;
				pointer-events: none;
				transition: opacity 0.5s cubic-bezier(0.32, 0.72, 0, 1);
			}
			body.is-project-open .c-page-shell {
				transform: scale(var(--pmodal-page-scale, 0.98)) translate3d(0, 14px, 0);
				border-radius: 1rem 1rem 0 0;
				clip-path: inset(
					var(--pmodal-scroll-y, 0px) 0 0 0 round 1rem 1rem 0 0
				);
				overflow: clip;
			}
			body.is-project-open .c-page-shell::after {
				opacity: 1;
			}
			body.is-project-open :global(.c-header) {
				transform: translateY(-100%);
			}

			/* The header lives outside the transforming page shell, so mobile keeps
			 * the stacked-card depth effect without pulling navigation off-screen. */
			@media (max-width: 40rem) {
				body.is-project-open :global(.c-header) {
					transform: none;
				}
			}

			/* Footer reveal: #main sits above the footer (which is sticky to the
			 * viewport bottom — see SiteFooter.astro) and must be opaque so it hides
			 * the footer until the page scrolls past it.
			 *
			 * NOTE: the footer is kept SHORTER than the viewport on purpose. A full
			 * 100svh footer would, while pinned at the bottom, also reach up behind
			 * the translucent header — whose backdrop-filter would then sample the
			 * dark footer and tint the nav. Keeping the footer < viewport height
			 * leaves the header backdrop on #main only. */
			#main {
				position: relative;
				z-index: 1;
				background-color: var(--bg);
				/* Page-end breathing room before the footer reveal — mirrors the
				 * nav→hero gap so content is framed symmetrically top & bottom. Lives
				 * on #main (not a last-section margin, which would collapse through to
				 * #main's negative bottom margin and create no visible space). */
				/* Foreground panel over the reveal footer. Rounded bottom corners so it
				 * reads as a card lifting away to uncover the footer (no shadow seam). */
				border-bottom-left-radius: 1rem;
				border-bottom-right-radius: 1rem;
				/* Pull the footer up behind #main's last 1.5rem so the rounded corners
				 * always have the footer behind them — otherwise at max scroll #main's
				 * bottom meets the footer's top exactly and the corners reveal the page
				 * background (same colour), making the radius vanish. */
				margin-bottom: -1.5rem;
			}

			.c-skip-link {
				position: absolute;
				left: var(--spacing-s);
				top: var(--spacing-s);
				z-index: 100;
				padding: var(--spacing-2xs) var(--spacing-s);
				background-color: var(--accent);
				color: var(--accent-contrast);
				border-radius: var(--radius-md);
				transform: translateY(-150%);
				transition: transform 0.2s var(--ease-out-expo);
			}

			.c-skip-link:focus-visible {
				transform: translateY(0);
			}

			@media (prefers-reduced-motion: reduce) {
				.c-page-shell,
				:global(.c-header),
				:global(body) {
					transition: none;
				}
				body.is-project-open .c-page-shell {
					transform: none;
				}
				body.is-project-open :global(.c-header) {
					transform: none;
				}
				.c-page-shell::after {
					transition: none;
				}
			}

			/* Copy feedback — a pill that emerges from behind the clicked CTA.
			 * JS writes --copy-x/y from the button rect; only transform/opacity/filter
			 * animate, keeping the motion cheap and anchored. */
			.c-copy-popover {
				position: fixed;
				left: 0;
				top: 0;
				z-index: 300;
				display: flex;
				align-items: center;
				padding: var(--spacing-2xs) var(--spacing-s);
				background-color: var(--text);
				color: var(--bg);
				border-radius: var(--radius-md);
				font-size: var(--text-step--1);
				box-shadow: 0 0.5rem 1.875rem rgba(0, 0, 0, 0.18);
				opacity: 0;
				pointer-events: none;
				transform: translate3d(var(--copy-x, 0px), var(--copy-y, 0px), 0)
					translate(-50%, 0);
				will-change: transform, opacity, filter;
			}
			@media (prefers-reduced-motion: reduce) {
				.c-copy-popover {
					will-change: auto;
				}
			}
		</style>

		<script>
			// Global copy-to-clipboard for any [data-copy-email] trigger (nav, hero,
			// footer CTAs). Delegated on document so it survives Astro view-transition
			// swaps and covers elements added later. Runs once — module scripts aren't
			// re-executed on client-side navigation.
			let hideTimer: ReturnType<typeof setTimeout> | undefined;
			let copyAnimation: Animation | undefined;

			function showCopyPopover(message: string, trigger: HTMLElement) {
				const popover =
					document.querySelector<HTMLElement>("[data-copy-popover]");
				const text = popover?.querySelector<HTMLElement>(".c-copy-popover__text");
				if (!popover || !text) return;

				text.textContent = message;
				clearTimeout(hideTimer);
				copyAnimation?.cancel();

				const triggerRect = trigger.getBoundingClientRect();
				const popoverRect = popover.getBoundingClientRect();
				const targetX = Math.min(
					Math.max(
						triggerRect.left + triggerRect.width / 2,
						popoverRect.width / 2 + 12,
					),
					window.innerWidth - popoverRect.width / 2 - 12,
				);
				const targetY = Math.max(triggerRect.top - popoverRect.height - 10, 12);
				const startY = Math.max(triggerRect.top + triggerRect.height * 0.25, 12);
				const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

				popover.style.setProperty("--copy-x", `${targetX}px`);
				popover.style.setProperty("--copy-y", `${targetY}px`);

				copyAnimation = popover.animate(
					reduce
						? [{ opacity: 0 }, { opacity: 1 }]
						: [
								{
									opacity: 0,
									filter: "blur(6px)",
									transform: `translate3d(${targetX}px, ${startY}px, 0) translate(-50%, 0) scale(0.96)`,
								},
								{
									opacity: 1,
									filter: "blur(0px)",
									transform: `translate3d(${targetX}px, ${targetY}px, 0) translate(-50%, 0) scale(1)`,
								},
							],
					{
						duration: reduce ? 120 : 360,
						easing: "cubic-bezier(0.16, 1, 0.3, 1)",
						fill: "forwards",
					},
				);

				hideTimer = setTimeout(() => {
					copyAnimation?.cancel();
					copyAnimation = popover.animate(
						reduce
							? [{ opacity: 1 }, { opacity: 0 }]
							: [
									{ opacity: 1, filter: "blur(0px)" },
									{
										opacity: 0,
										filter: "blur(4px)",
										transform: `translate3d(${targetX}px, ${targetY - 6}px, 0) translate(-50%, 0) scale(0.98)`,
									},
								],
						{
							duration: reduce ? 120 : 180,
							easing: "cubic-bezier(0.4, 0, 1, 1)",
							fill: "forwards",
						},
					);
				}, 1800);
			}

			// Legacy fallback: a transient offscreen textarea + execCommand. Works on
			// the click gesture without the clipboard-write permission, which embedded
			// previews / permission-denied browsers reject the async API with.
			function legacyCopy(value: string): boolean {
				const ta = document.createElement("textarea");
				ta.value = value;
				ta.readOnly = true;
				ta.className = "u-copy-source";
				document.body.appendChild(ta);
				ta.select();
				let ok = false;
				try {
					ok = document.execCommand("copy");
				} catch {
					ok = false;
				}
				ta.remove();
				return ok;
			}

			async function copyEmail(value: string, trigger: HTMLElement) {
				try {
					await navigator.clipboard.writeText(value);
					showCopyPopover(`Copied ${value}`, trigger);
					return;
				} catch {
					/* fall through to the legacy path */
				}
				if (legacyCopy(value)) {
					showCopyPopover(`Copied ${value}`, trigger);
				} else {
					// Copy genuinely blocked — still surface the address so the click
					// isn't a dead end.
					showCopyPopover(value, trigger);
				}
			}

			document.addEventListener("click", (e) => {
				const trigger = (e.target as Element | null)?.closest<HTMLElement>(
					"[data-copy-email]",
				);
				if (!trigger) return;
				e.preventDefault(); // suppress the mailto: fallback when JS is live
				copyEmail(trigger.dataset.copyEmail ?? "", trigger);
			});
		</script>
	</body>
</html>
