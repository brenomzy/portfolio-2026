---
import { ClientRouter } from "astro:transitions";
import ProgressiveBlur from "../components/ProgressiveBlur.astro";
import PageTransition from "../components/PageTransition.astro";
import "@fontsource-variable/geist";
// Manrope (variable) — headings only; Geist stays the body face.
import "@fontsource-variable/manrope";
// Display face for the footer wordmark only (single 400 weight — the "Black").
import "@fontsource/archivo-black";
import "../styles/global.css";

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = "Portfolio of Breno — designer & developer building fast, accessible websites.",
} = Astro.props;

const siteName = "Breno";
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!-- Favicons. SVG is theme-aware: the no-flash script below (and the theme
		     toggle) swaps light/dark variants to track the site theme. Safari
		     ignores SVG favicons and falls back to the ICO (static orange mark,
		     16/32/48); iOS home screens take the apple-touch PNG. -->
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href="/favicon-light.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="canonical" href={canonical} />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta name="twitter:card" content="summary_large_image" />

		<!-- No-flash theme init: runs before paint, before <body> renders.
			 Preference is persisted in a `theme` cookie (see ThemeToggle.astro). -->
		<script is:inline>
			(() => {
				const root = document.documentElement;
				// Marks JS as available, so CSS can hide reveal targets pre-animation
				// without ever hiding them for no-JS / crawlers.
				root.classList.add("js");
				const m = document.cookie.match(/(?:^|;\s*)theme=(dark|light)/);
				const theme =
					(m && m[1]) ??
					(matchMedia("(prefers-color-scheme: dark)").matches
						? "dark"
						: "light");
				root.dataset.theme = theme;
				// Favicon tracks the site theme (orange mark on light, blue on dark).
				const fav = document.querySelector(
					'link[rel="icon"][type="image/svg+xml"]',
				);
				if (fav) fav.href = `/favicon-${theme}.svg`;
			})();
		</script>

		<ClientRouter />
	</head>

	<body>
		<a class="c-skip-link" href="#main">Skip to content</a>
		<slot name="header" />
		<main id="main">
			<slot />
		</main>
		<slot name="footer" />
		<ProgressiveBlur />
		<PageTransition />

		<!-- Global copy-confirmation toast. A single instance for the whole app;
		     the delegated handler below populates + reveals it. aria-live so the
		     confirmation is announced to assistive tech. -->
		<div class="c-toast" role="status" aria-live="polite" data-toast>
			<span class="c-toast__text"></span>
		</div>

		<style>
			/* Footer reveal: #main sits above the footer (which is sticky to the
			 * viewport bottom — see SiteFooter.astro) and must be opaque so it hides
			 * the footer until the page scrolls past it.
			 *
			 * NOTE: the footer is kept SHORTER than the viewport on purpose. A full
			 * 100svh footer would, while pinned at the bottom, also reach up behind
			 * the translucent header — whose backdrop-filter would then sample the
			 * dark footer and tint the nav. Keeping the footer < viewport height
			 * leaves the header backdrop on #main only. */
			#main {
				position: relative;
				z-index: 1;
				background-color: var(--bg);
				/* Page-end breathing room before the footer reveal — mirrors the
				 * nav→hero gap so content is framed symmetrically top & bottom. Lives
				 * on #main (not a last-section margin, which would collapse through to
				 * #main's negative bottom margin and create no visible space). */
				padding-bottom: var(--spacing-2xl);
				/* Foreground panel over the reveal footer. Rounded bottom corners so it
				 * reads as a card lifting away to uncover the footer (no shadow seam). */
				border-bottom-left-radius: 1rem;
				border-bottom-right-radius: 1rem;
				/* Pull the footer up behind #main's last 1.5rem so the rounded corners
				 * always have the footer behind them — otherwise at max scroll #main's
				 * bottom meets the footer's top exactly and the corners reveal the page
				 * background (same colour), making the radius vanish. */
				margin-bottom: -1.5rem;
			}

			.c-skip-link {
				position: absolute;
				left: var(--spacing-s);
				top: var(--spacing-s);
				z-index: 100;
				padding: var(--spacing-2xs) var(--spacing-s);
				background-color: var(--accent);
				color: var(--accent-contrast);
				border-radius: var(--radius-md);
				transform: translateY(-150%);
				transition: transform 0.2s var(--ease-out-expo);
			}

			.c-skip-link:focus-visible {
				transform: translateY(0);
			}

			/* Copy toast — pill pinned bottom-centre, above everything. Uses theme
			 * tokens so it inverts correctly in dark mode (text bg on bg-coloured
			 * text). Hidden + lifted by default; .is-visible drops it into view. */
			.c-toast {
				position: fixed;
				left: 50%;
				bottom: var(--spacing-l);
				z-index: 200;
				display: flex;
				align-items: center;
				padding: var(--spacing-2xs) var(--spacing-s);
				background-color: var(--text);
				color: var(--bg);
				border-radius: var(--radius-md);
				font-size: var(--text-step--1);
				box-shadow: 0 0.5rem 1.875rem rgba(0, 0, 0, 0.18);
				opacity: 0;
				translate: -50% 0.75rem;
				pointer-events: none;
				transition:
					opacity 0.3s var(--ease-out-expo),
					translate 0.3s var(--ease-out-expo);
			}
			.c-toast.is-visible {
				opacity: 1;
				translate: -50% 0;
			}
			@media (prefers-reduced-motion: reduce) {
				.c-toast {
					translate: -50% 0;
					transition: opacity 0.2s linear;
				}
			}
		</style>

		<script>
			// Global copy-to-clipboard for any [data-copy-email] trigger (nav, hero,
			// footer CTAs). Delegated on document so it survives Astro view-transition
			// swaps and covers elements added later. Runs once — module scripts aren't
			// re-executed on client-side navigation.
			let hideTimer: ReturnType<typeof setTimeout> | undefined;

			function showToast(message: string) {
				const toast = document.querySelector<HTMLElement>("[data-toast]");
				const text = toast?.querySelector<HTMLElement>(".c-toast__text");
				if (!toast || !text) return;
				text.textContent = message;
				toast.classList.add("is-visible");
				clearTimeout(hideTimer);
				hideTimer = setTimeout(() => toast.classList.remove("is-visible"), 2200);
			}

			// Legacy fallback: a transient offscreen textarea + execCommand. Works on
			// the click gesture without the clipboard-write permission, which embedded
			// previews / permission-denied browsers reject the async API with.
			function legacyCopy(value: string): boolean {
				const ta = document.createElement("textarea");
				ta.value = value;
				ta.readOnly = true;
				ta.className = "u-copy-source";
				document.body.appendChild(ta);
				ta.select();
				let ok = false;
				try {
					ok = document.execCommand("copy");
				} catch {
					ok = false;
				}
				ta.remove();
				return ok;
			}

			async function copyEmail(value: string) {
				try {
					await navigator.clipboard.writeText(value);
					showToast(`Copied ${value}`);
					return;
				} catch {
					/* fall through to the legacy path */
				}
				if (legacyCopy(value)) {
					showToast(`Copied ${value}`);
				} else {
					// Copy genuinely blocked — still surface the address so the click
					// isn't a dead end.
					showToast(value);
				}
			}

			document.addEventListener("click", (e) => {
				const trigger = (e.target as Element | null)?.closest<HTMLElement>(
					"[data-copy-email]",
				);
				if (!trigger) return;
				e.preventDefault(); // suppress the mailto: fallback when JS is live
				copyEmail(trigger.dataset.copyEmail ?? "");
			});
		</script>
	</body>
</html>
