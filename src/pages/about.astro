			gap: var(--spacing-2xl);
		}
		.about__title {
			font-size: clamp(2.05rem, 1.9rem + 0.8vw, 2.25rem);
			max-width: 20ch;
		}
		.about__background-lead {
			font-size: clamp(1.85rem, 1.7rem + 0.8vw, 2.05rem);
		}
		:global(html[data-about-layout="monograph"]) .about__title,
		:global(html[data-about-layout="index"]) .about__title {
