---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { SITE_NAME } from "../lib/site";

// TODO: placeholder About content — real bio/photo to come. Edit these locals.
const bio: string[] = [
	"I'm Breno — a developer from Brazil who bridges design and code to build fast, accessible, hand-built websites. Currently at BX Studio, open to select freelance work.",
	"I care about the details: motion that earns its place, layouts that hold up under real content, and front-ends that stay fast.",
];
const skills = [
	"Vanilla JS",
	"GSAP",
	"CSS",
	"Webflow",
	"Astro",
	"Accessibility",
];
---

<Base title={`About — ${SITE_NAME}`} description="About me, my skills and tools.">
	<SiteHeader slot="header" />

	<section class="about">
		<h1 class="about__title">About</h1>

		<div class="about__grid">
			<div class="about__content">
				{bio.map((para) => <p>{para}</p>)}

				{
					skills.length > 0 && (
						<div class="about__skills">
							<h2 class="about__subhead">Skills &amp; tools</h2>
							<ul class="about__tags">
								{skills.map((skill) => (
									<li class="about__tag">{skill}</li>
								))}
							</ul>
						</div>
					)
				}
			</div>
		</div>
	</section>

	<SiteFooter slot="footer" />
</Base>

<style>
	.about {
		max-width: var(--container-content);
		margin-inline: auto;
		padding: var(--spacing-2xl) var(--spacing-m);
	}
	.about__title {
		font-size: var(--text-step-5);
		margin-bottom: var(--spacing-l);
	}
	.about__grid {
		display: grid;
		gap: var(--spacing-xl);
		grid-template-columns: 1fr;
	}
	.about__content {
		display: grid;
		gap: var(--spacing-l);
		/* Comfortable reading measure now that the page is a single column. */
		max-width: 60ch;
	}
	.about__subhead {
		font-size: var(--text-step-1);
		margin-bottom: var(--spacing-s);
	}
	.about__tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-2xs);
		list-style: none;
		padding: 0;
	}
	.about__tag {
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		padding: 0.2em 0.7em;
		font-size: var(--text-step--1);
		color: var(--text-muted);
	}
</style>
