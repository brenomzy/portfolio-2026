		:global(html[data-about-layout="profile"]) :global(.about__gallery),
		:global(html[data-about-layout="profile"]) .about__intro,
		:global(html[data-about-layout="monograph"]) :global(.about__gallery),
		:global(html[data-about-layout="monograph"]) .about__intro {
