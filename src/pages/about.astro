</style>

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";
	import { CustomEase } from "gsap/CustomEase";
	import { whenRevealable } from "../lib/page-reveal";

	gsap.registerPlugin(ScrollTrigger, CustomEase);

	const reduced = matchMedia("(prefers-reduced-motion: reduce)");
	const finePointer = matchMedia("(hover: hover) and (pointer: fine)");
	const EASE_OUT =
		CustomEase.get("brand-out") ?? CustomEase.create("brand-out", "0.16,1,0.3,1");

	let triggers: ScrollTrigger[] = [];
	let previewCleanups: (() => void)[] = [];
	let timelineCleanup: (() => void) | undefined;

	function killTriggers() {
		triggers.forEach((t) => t.kill());
		triggers = [];
	}
	function killForumPreviews() {
		previewCleanups.forEach((cleanup) => cleanup());
		previewCleanups = [];
	}
	function killTimeline() {
		timelineCleanup?.();
		timelineCleanup = undefined;
	}

	const reveal = (els: HTMLElement | HTMLElement[], delay = 0) =>
		gsap.to(els, {
			autoAlpha: 1,
			y: 0,
			duration: 0.8,
			delay,
			ease: EASE_OUT,
			stagger: 0.08,
			overwrite: true,
			clearProps: "transform",
		});

	function setup() {
		const items = gsap.utils.toArray<HTMLElement>(".js-about-reveal");
		if (!items.length) return;
		killTriggers();
		setupForumPreviews();
		setupStepTimeline();

		if (reduced.matches) {
			gsap.set(items, { autoAlpha: 1, y: 0, clearProps: "transform" });
			return;
		}

		gsap.set(items, { autoAlpha: 0, y: 40 });

		// ScrollTrigger.batch won't fire onEnter for items ALREADY above the start
		// line at load (the page's intro is in view immediately) — so split the
		// work: reveal what's on-screen now, scroll-reveal the rest per item.
		const threshold = window.innerHeight * 0.9;
		const onLoad: HTMLElement[] = [];
		items.forEach((el) => {
			if (el.getBoundingClientRect().top < threshold) onLoad.push(el);
			else
				triggers.push(
					ScrollTrigger.create({
						trigger: el,
						start: "top 88%",
						once: true,
						onEnter: () => reveal(el),
					}),
				);
		});
		// Hold the in-view reveals AND the layout-heavy ScrollTrigger.refresh until
		// the cross-fade has settled, so neither competes with the transition (the
		// navigation freeze). Below-fold items keep their own scroll triggers (set up
		// above). Resolves immediately on a fresh load, so that path is unchanged.
		whenRevealable().then(() => {
			if (onLoad.length) {
				const gallery = onLoad.filter((item) =>
					item.classList.contains("about__gallery"),
				);
				const introItems = onLoad.filter(
					(item) => !item.classList.contains("about__gallery"),
				);
				if (introItems.length) reveal(introItems);
				// The portrait stack is the hero's closing beat. Let the copy establish
				// itself first, matching the calmer staging of the deployed site.
				if (gallery.length) reveal(gallery, 1);
			}
			ScrollTrigger.refresh();
		});
	}

	function setupStepTimeline() {
		killTimeline();

		const root = document.querySelector<HTMLElement>("[data-step-timeline-init]");
		if (!root) return;

		const line = root.querySelector<HTMLElement>("[data-step-timeline-line]");
		const fill = root.querySelector<HTMLElement>("[data-step-timeline-fill]");
		const items = gsap.utils.toArray<HTMLElement>(
			root.querySelectorAll("[data-step-timeline-item]"),
		);
		if (!line || !fill || !items.length) return;

		const anchors = items.map(
			(item) =>
				item.querySelector<HTMLElement>("[data-step-timeline-marker]") ?? item,
		);
		const activationInput = Number.parseFloat(
			root.dataset.stepTimelineActivation ?? "0.5",
		);
		const activation = Number.isNaN(activationInput)
			? 0.5
			: Math.min(Math.max(activationInput, 0), 1);
		const activationPercent = activation * 100;
		const lastIndex = items.length - 1;
		let anchorFractions = [0];
		let currentIndex = -2;

		const measureLine = () => {
			if (items.length < 2) {
				line.style.height = "0px";
				anchorFractions = [0];
				return;
			}

			const base = line.parentElement?.getBoundingClientRect().top ?? 0;
			const centers = anchors.map((anchor) => {
				const box = anchor.getBoundingClientRect();
				return box.top + box.height / 2 - base;
			});
			const firstCenter = centers[0];
			const span = centers[lastIndex] - firstCenter;
			line.style.top = `${firstCenter}px`;
			line.style.height = `${span}px`;
			anchorFractions = centers.map((center) =>
				span > 0 ? (center - firstCenter) / span : 0,
			);
		};

		const setCurrentIndex = (index: number) => {
			if (index === currentIndex) return;
			currentIndex = index;
			items.forEach((item, itemIndex) => {
				item.dataset.status =
					index >= 0 && itemIndex <= index ? "active" : "inactive";
				item.toggleAttribute("data-current", itemIndex === index);
				item.toggleAttribute("data-previous", itemIndex === index - 1);
				item.toggleAttribute("data-next", itemIndex === index + 1);
			});
		};

		const updateFromScroll = (self: ScrollTrigger) => {
			const reached = self.isActive || self.progress >= 1;
			let index = reached ? 0 : -1;
			if (reached) {
				anchorFractions.forEach((fraction, itemIndex) => {
					if (self.progress + 0.0001 >= fraction) index = itemIndex;
				});
			}
			setCurrentIndex(index);
		};

		setCurrentIndex(-1);
		gsap.set(fill, { transformOrigin: "top", scaleY: 0 });

		const media = gsap.matchMedia();
		media.add("(prefers-reduced-motion: no-preference)", () => {
			measureLine();
			ScrollTrigger.addEventListener("refreshInit", measureLine);

			const tween =
				items.length > 1
					? gsap.fromTo(
							fill,
							{ scaleY: 0 },
							{
								scaleY: 1,
								ease: "none",
								scrollTrigger: {
									trigger: line,
									start: `top ${activationPercent}%`,
									end: `bottom ${activationPercent}%`,
									scrub: true,
									onUpdate: updateFromScroll,
									onToggle: updateFromScroll,
									onRefresh: updateFromScroll,
								},
							},
						)
					: undefined;
			if (items.length === 1) setCurrentIndex(0);

			const refresh = () => ScrollTrigger.refresh();
			window.addEventListener("load", refresh);
			document.fonts?.ready.then(refresh);

			return () => {
				window.removeEventListener("load", refresh);
				ScrollTrigger.removeEventListener("refreshInit", measureLine);
				tween?.kill();
			};
		});

		media.add("(prefers-reduced-motion: reduce)", () => {
			measureLine();
			gsap.set(fill, { scaleY: 1 });
			setCurrentIndex(lastIndex);
		});

		timelineCleanup = () => media.revert();
	}

	function setupForumPreviews() {
		killForumPreviews();

		const previews = gsap.utils.toArray<HTMLElement>(".js-forum-preview");
		previews.forEach((wrap) => {
			const trigger = wrap.querySelector<HTMLButtonElement>(
				".about__forum-trigger",
			);
			const preview = wrap.querySelector<HTMLElement>(".about__forum-preview");
			const image = wrap.querySelector<HTMLElement>(".about__forum-image");
			if (!trigger || !preview || !image) return;

			const originalParent = preview.parentNode;
			const originalNextSibling = preview.nextSibling;
			let isOpen = false;

			document.body.appendChild(preview);
			gsap.set(preview, { autoAlpha: 0 });
			gsap.set(image, {
				autoAlpha: 0,
				scale: reduced.matches ? 1 : 0.97,
				y: reduced.matches ? 0 : 6,
				filter: reduced.matches ? "none" : "blur(2px)",
				transformOrigin: "18% 100%",
			});

			const showPreview = () => {
				isOpen = true;
				trigger.setAttribute("aria-expanded", "true");

				const linkRect = trigger.getBoundingClientRect();
				const previewWidth = preview.offsetWidth;
				const previewHeight = preview.offsetHeight;
				const margin = 16;
				const gap = 14;
				const preferredX = linkRect.left - previewWidth * 0.18;
				const preferredY =
					linkRect.top >= previewHeight + margin + gap
						? linkRect.top - previewHeight - gap
						: linkRect.bottom + gap;
				const x = Math.min(
					Math.max(preferredX, margin),
					window.innerWidth - previewWidth - margin,
				);
				const y = Math.min(
					Math.max(preferredY, margin),
					window.innerHeight - previewHeight - margin,
				);
				const opensAbove = y < linkRect.top;

				preview.style.setProperty("--preview-x", `${x}px`);
				preview.style.setProperty("--preview-y", `${y}px`);
				gsap.set(image, {
					transformOrigin: opensAbove ? "18% 100%" : "18% 0%",
				});

				gsap.killTweensOf([preview, image]);

				if (reduced.matches) {
					gsap.set(preview, { autoAlpha: 1 });
					gsap.set(image, { autoAlpha: 1, scale: 1, y: 0, filter: "none" });
					return;
				}

				gsap.set(preview, { autoAlpha: 1 });
				gsap.fromTo(
					image,
					{
						autoAlpha: 0,
						scale: 0.97,
						y: 6,
						filter: "blur(2px)",
					},
					{
						autoAlpha: 1,
						scale: 1,
						y: 0,
						filter: "blur(0px)",
						duration: 0.2,
						ease: "power3.out",
						overwrite: true,
					},
				);
			};

			const hidePreview = () => {
				isOpen = false;
				trigger.setAttribute("aria-expanded", "false");

				if (reduced.matches) {
					gsap.set(preview, { autoAlpha: 0 });
					return;
				}

				gsap.killTweensOf([preview, image]);
				gsap.to(image, {
					autoAlpha: 0,
					scale: 0.97,
					y: 6,
					filter: "blur(3px)",
					duration: 0.16,
					ease: "power2.in",
					overwrite: true,
					onComplete: () => {
						if (!isOpen) gsap.set(preview, { autoAlpha: 0 });
					},
				});
			};

			const showOnHover = (event: PointerEvent) => {
				if (event.pointerType === "touch" || !finePointer.matches) return;
				showPreview();
			};

			const hideOnHover = (event: PointerEvent) => {
				if (event.pointerType === "touch" || !finePointer.matches) return;
				hidePreview();
			};

			const showOnFocus = () => {
				if (!finePointer.matches) return;
				showPreview();
			};

			const hideOnBlur = () => {
				if (!finePointer.matches) return;
				hidePreview();
			};

			const togglePreview = (event: MouseEvent) => {
				if (finePointer.matches) return;
				event.preventDefault();
				if (isOpen) hidePreview();
				else showPreview();
			};

			const handleDocumentPointerDown = (event: PointerEvent) => {
				if (!isOpen || wrap.contains(event.target as Node)) return;
				hidePreview();
			};

			const handleKeyDown = (event: KeyboardEvent) => {
				if (event.key !== "Escape" || !isOpen) return;
				hidePreview();
				trigger.focus();
			};

			trigger.addEventListener("pointerenter", showOnHover);
			trigger.addEventListener("focus", showOnFocus);
			trigger.addEventListener("pointerleave", hideOnHover);
			trigger.addEventListener("blur", hideOnBlur);
			trigger.addEventListener("click", togglePreview);
			document.addEventListener("pointerdown", handleDocumentPointerDown);
			document.addEventListener("keydown", handleKeyDown);

			previewCleanups.push(() => {
				trigger.removeEventListener("pointerenter", showOnHover);
				trigger.removeEventListener("focus", showOnFocus);
				trigger.removeEventListener("pointerleave", hideOnHover);
				trigger.removeEventListener("blur", hideOnBlur);
				trigger.removeEventListener("click", togglePreview);
				document.removeEventListener("pointerdown", handleDocumentPointerDown);
				document.removeEventListener("keydown", handleKeyDown);
				gsap.killTweensOf([preview, image]);
				if (originalParent?.isConnected) {
					originalParent.insertBefore(preview, originalNextSibling);
				} else {
					preview.remove();
				}
			});
		});
	}

	// Direct dev-server loads can evaluate this page module after
	// `astro:page-load` has already fired. Run once immediately so reveal items
	// never remain parked at visibility:hidden; retain the listener for later
	// ClientRouter navigations.
	setup();
	document.addEventListener("astro:page-load", setup);
	document.addEventListener("astro:before-swap", () => {
		killTriggers();
		killForumPreviews();
		killTimeline();
	});
</script>
