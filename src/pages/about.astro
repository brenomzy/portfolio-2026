---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Button from "../components/Button.astro";
import AboutGallery from "../components/AboutGallery.astro";
import { SITE_NAME } from "../lib/site";
import { ABOUT } from "../lib/about";

const DESIGN_FORUMS_PHRASE = "design forums";
---

<Base
	title={`About — ${SITE_NAME}`}
	description="About Breno — background, approach, the tools I build with, and what I'm listening to."
>
	<SiteHeader slot="header" />

	<article class="about">
		<!-- Intro + hero gallery --------------------------------------------- -->
		<header class="about__hero">
			<div class="about__intro">
			<p class="about__eyebrow js-about-reveal" data-reveal>About</p>
			<h1 class="about__title js-about-reveal" data-reveal>{ABOUT.introTitle}</h1>
			<p class="about__intro-body js-about-reveal" data-reveal>{ABOUT.introBody}</p>
			<p class="about__tenure js-about-reveal" data-reveal>{ABOUT.tenure}</p>
			<ul class="about__socials js-about-reveal" data-reveal aria-label="Find me elsewhere">
				{
					ABOUT.socials.map((s) => (
						<li>
							<a
								class="about__social"
								href={s.href}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={s.label}
							>
								{s.icon === "linkedin" ? (
									<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
										<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
									</svg>
								) : (
									<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
										<path d="M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z" />
									</svg>
								)}
							</a>
						</li>
					))
				}
			</ul>
			</div>

			<AboutGallery />
		</header>

		<!-- Background ------------------------------------------------------- -->
		<section class="about__row">
			<p class="about__rowlabel js-about-reveal" data-reveal><span>01</span> Background</p>
			<div class="about__prose">
				{
					ABOUT.background.map((para) => {
						const [before, after] = para.split(DESIGN_FORUMS_PHRASE);

						return (
							<p class="js-about-reveal" data-reveal>
								{after === undefined ? (
									para
								) : (
									<>
										{before}
										<span class="about__forum js-forum-preview">
											<button
												class="about__forum-trigger"
												type="button"
												aria-expanded="false"
												aria-controls="thunder-design-preview"
											>
												{DESIGN_FORUMS_PHRASE}
											</button>
											<span
												class="about__forum-preview"
												id="thunder-design-preview"
												aria-hidden="true"
											>
												<img
													class="about__forum-image"
													src="/about/thunder-design.jpg"
													alt=""
													loading="lazy"
												/>
											</span>
										</span>
										{after}
									</>
								)}
							</p>
						);
					})
				}
			</div>
		</section>

		<!-- The relic: my actual 2004 site, rebuilt from the Internet Archive --->
		<figure class="about__relic js-about-reveal" data-reveal>
			<div class="about__relic-bar" aria-hidden="true">
				<span class="about__relic-dots"><i></i><i></i><i></i></span>
				<span class="about__relic-url">http://www.pokeloukos.cjb.net</span>
			</div>
			<div class="about__relic-screen">
				<iframe
					class="about__relic-frame"
					src="/about/pokeloukos/index.html"
					title="Poké Loukos v2.0 — the Pokémon fan site I built in 2004"
					loading="lazy"
					scrolling="no"
				></iframe>
			</div>
			<figcaption class="about__relic-cap">
				Poké Loukos v2.0, the Pokémon fan site I built in 2004. Rebuilt here
				from the Internet Archive, original pixels and all.
			</figcaption>
		</figure>

		<!-- Approach / values ----------------------------------------------- -->
		<section class="about__row">
			<p class="about__rowlabel js-about-reveal" data-reveal><span>02</span> Approach</p>
			<ol class="about__values">
				{
					ABOUT.values.map((v) => (
						<li class="about__value js-about-reveal" data-reveal>
							<span class="about__value-no">{v.no}</span>
							<h2 class="about__value-title">{v.title}</h2>
							<p class="about__value-body">{v.body}</p>
						</li>
					))
				}
			</ol>
		</section>

		<!-- Fact cards: Now · Résumé · Tools · Jams -------------------------- -->
		<section class="about__cards" aria-label="At a glance">
			<div class="c-card about__now js-about-reveal" data-reveal>
				<p class="c-card__label">{ABOUT.now.label}</p>
				<p class="about__now-body">{ABOUT.now.body}</p>
			</div>

			<div class="c-card about__resume js-about-reveal" data-reveal>
				<p class="c-card__label">Résumé</p>
				<p class="about__resume-body">My experience and background, in detail.</p>
				<Button
					label="Download PDF ↓"
					href={ABOUT.resumeUrl}
					variant="secondary"
					download
				/>
			</div>

			<div class="c-card about__toolstack js-about-reveal" data-reveal>
				<p class="c-card__label">Tool stack</p>
				<ul class="about__tools" aria-label="Tools I build with">
					{
						ABOUT.tools.map((t) => (
							<li class="about__tool" title={t.name}>
								<span class="about__tool-tile" style={`--tile: ${t.color}`}>
									<span
										class="about__tool-glyph"
										style={`--icon: url(/tools/${t.icon}); --glyph: ${t.darkGlyph ? "#10151c" : "#fff"}`}
										aria-hidden="true"
									/>
								</span>
								<span class="about__sr">{t.name}</span>
							</li>
						))
					}
				</ul>
			</div>

			<div class="c-card about__jams js-about-reveal" data-reveal>
				<p class="c-card__label">Some of my favorite songs</p>
				<div class="about__jams-grid">
					{
						ABOUT.jams.map((j) => (
							<iframe
								class="about__jam"
								title={`${j.title} by ${j.artist} on Spotify`}
								src={`https://open.spotify.com/embed/track/${j.trackId}?utm_source=generator`}
								width="100%"
								height="152"
								loading="lazy"
								frameborder="0"
								allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
							/>
						))
					}
				</div>
			</div>
		</section>

		<!-- Experience ------------------------------------------------------- -->
		<section class="about__row">
			<p class="about__rowlabel js-about-reveal" data-reveal><span>03</span> Experience</p>
			<ol class="about__timeline">
				{
					ABOUT.experience.map((e) => (
						<li class="about__exp js-about-reveal" data-reveal>
							<p class="about__exp-period">{e.period}</p>
							<h2 class="about__exp-role">{e.role}</h2>
							<span class="about__exp-note">Remote</span>
						</li>
					))
				}
			</ol>
		</section>

		<!-- Contact ---------------------------------------------------------- -->
		<section class="about__contact js-about-reveal" data-reveal>
			<h2 class="about__contact-title">Let's build something.</h2>
			<p class="about__contact-blurb">{ABOUT.contact.blurb}</p>
			<Button
				label="Get in touch"
				href={`mailto:${ABOUT.contact.email}`}
				variant="primary"
				data-copy-email={ABOUT.contact.email}
			/>
		</section>
	</article>

	<SiteFooter slot="footer" />
</Base>

<style>
	.about {
		max-width: var(--container-content);
		margin-inline: auto;
		padding-inline: var(--spacing-m);
		display: grid;
		/* Cap the single column at the container width (min 0). Without this the
		 * implicit column is max-content-sized by the horizontally-scrolling photo
		 * strip, blowing the whole page out and breaking its overflow-x scroll. */
		grid-template-columns: minmax(0, 1fr);
		gap: var(--spacing-3xl);
	}

	/* ── Intro ─────────────────────────────────────────────────────────── */
	.about__hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: var(--spacing-xl);
		align-items: center;
		padding-top: var(--spacing-2xl);
	}
	.about__intro {
		display: grid;
		gap: var(--spacing-s);
		max-width: 38rem;
	}
	.about__eyebrow {
		font-size: 0.625rem;
		text-transform: uppercase;
		letter-spacing: 0.18em;
		color: var(--accent-ink);
		font-weight: 600;
	}
	.about__title {
		font-size: var(--text-step-3);
		max-width: 22ch;
		text-wrap: balance;
	}
	.about__intro-body {
		font-size: var(--text-step-1);
		color: var(--text-muted);
		max-width: 46ch;
		text-wrap: pretty;
	}
	.about__socials {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		list-style: none;
		padding: 0;
		font-size: var(--text-step--1);
		margin-top: var(--spacing-2xs);
	}
	.about__tenure {
		font-size: var(--text-step--1);
		color: var(--text-muted);
	}
	.about__social {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		color: var(--text-muted);
		transition:
			color 0.25s var(--ease-out-expo),
			border-color 0.25s var(--ease-out-expo),
			background-color 0.25s var(--ease-out-expo);
	}
	.about__social svg {
		width: 1.1rem;
		height: 1.1rem;
	}
	@media (hover: hover) {
		.about__social:is(:hover, :focus-visible) {
			color: var(--text);
			background-color: var(--surface-raised);
			border-color: var(--text-muted);
		}
	}

	/* Photo strip deferred (Osmo component coming) — markup removed for now. */

	/* ── Generic two-column row (label left, content right) ─────────────── */
	.about__row {
		display: grid;
		grid-template-columns: minmax(0, 12rem) minmax(0, 1fr);
		gap: var(--spacing-l) var(--spacing-xl);
		align-items: start;
	}
	.about__rowlabel {
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--text-muted);
		font-weight: 600;
		display: flex;
		align-items: baseline;
		gap: 0.6em;
	}
	.about__rowlabel span {
		color: var(--accent-ink);
	}

	.about__prose {
		display: grid;
		gap: var(--spacing-s);
		max-width: 60ch;
		font-size: var(--text-step-1);
		color: var(--text-muted);
	}
	.about__prose p {
		text-wrap: pretty;
	}
	.about__forum {
		position: relative;
		display: inline-block;
	}
	.about__forum-trigger {
		appearance: none;
		border: 0;
		padding: 0;
		background: none;
		font: inherit;
		color: var(--text);
		cursor: pointer;
		text-decoration: underline;
		text-decoration-thickness: 0.08em;
		text-underline-offset: 0.16em;
		text-decoration-color: color-mix(in srgb, var(--accent-ink) 65%, transparent);
		transition:
			color 0.2s ease,
			text-decoration-color 0.2s ease;
	}
	.about__forum-trigger:is(:hover, :focus-visible),
	.about__forum-trigger[aria-expanded="true"] {
		color: var(--accent-ink);
		text-decoration-color: currentColor;
	}
	.about__forum-preview {
		position: fixed;
		z-index: 20;
		left: 0;
		top: 0;
		width: min(28rem, calc(100vw - 2rem), calc((100vh - 2rem) * 902 / 886));
		pointer-events: none;
		visibility: hidden;
		opacity: 0;
		transform: translate3d(var(--preview-x, 0px), var(--preview-y, 0px), 0);
	}
	.about__forum-image {
		display: block;
		width: 100%;
		aspect-ratio: 902 / 886;
		object-fit: cover;
		border-radius: var(--radius-md);
		outline: 1px solid rgb(0 0 0 / 0.1);
		outline-offset: -1px;
		box-shadow: var(--shadow-5);
	}
	[data-theme="dark"] .about__forum-image {
		outline-color: rgb(255 255 255 / 0.1);
	}
	@media (max-width: 48rem) {
		.about__forum-preview {
			width: min(22rem, calc(100vw - 2rem));
		}
	}

	/* ── The relic: my 2004 site in a little browser window ─────────────── */
	.about__relic {
		margin: 0 auto;
		/* width:100% so the grid item fills the column up to the cap — without it,
		 * margin-inline:auto makes it shrink to its content (the URL-bar text,
		 * since the container-type screen contributes no intrinsic width). */
		width: 100%;
		max-width: min(100%, 60rem);
	}
	.about__relic-bar {
		display: flex;
		align-items: center;
		gap: var(--spacing-xs);
		padding: 0.5rem 0.7rem;
		background: var(--surface-raised);
		border: 1px solid var(--border);
		border-bottom: 0;
		border-radius: var(--radius-md) var(--radius-md) 0 0;
	}
	.about__relic-dots {
		display: inline-flex;
		gap: 0.4rem;
		flex: none;
	}
	.about__relic-dots i {
		width: 0.7rem;
		height: 0.7rem;
		border-radius: 50%;
		background: var(--border);
	}
	.about__relic-url {
		flex: 1;
		min-width: 0;
		font-family: var(--font-mono);
		font-size: var(--text-step--1);
		color: var(--text-muted);
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		padding: 0.15rem 0.6rem;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	/* The screen is a container; the fixed-size iframe scales to fill it. */
	.about__relic-screen {
		container-type: inline-size;
		/* Match the rebuilt page's real rendered height (780×785) so nothing clips. */
		aspect-ratio: 780 / 785;
		overflow: hidden;
		border: 1px solid var(--border);
		border-radius: 0 0 var(--radius-md) var(--radius-md);
		background: #b40000;
	}
	.about__relic-frame {
		display: block;
		width: 780px;
		height: 785px;
		border: 0;
		transform-origin: top left;
		transform: scale(calc(100cqw / 780px));
	}
	.about__relic-cap {
		margin-top: var(--spacing-xs);
		text-align: center;
		font-size: 0.72rem;
		color: var(--text-muted);
		max-width: 62ch;
		margin-inline: auto;
		text-wrap: balance;
	}

	/* ── Values ────────────────────────────────────────────────────────── */
	.about__values {
		list-style: none;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
		gap: var(--spacing-l);
		counter-reset: none;
	}
	.about__value {
		display: grid;
		gap: var(--spacing-2xs);
		align-content: start;
	}
	.about__value-no {
		font-size: var(--text-step-3);
		color: var(--border);
		font-weight: 600;
		line-height: 1;
	}
	.about__value-title {
		font-size: var(--text-step-1);
	}
	.about__value-body {
		color: var(--text-muted);
		font-size: var(--text-step--1);
	}

	/* ── Fact cards ────────────────────────────────────────────────────── */
	.about__cards {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		/* Bento: Now + Résumé share the top row, the Tool stack runs full width as
		 * a centered icon dock, Jams full width below. (A tall tool card left dead
		 * space — 11 small tiles can't fill it; centering reads cleaner.) */
		grid-template-areas:
			"now   resume"
			"tools tools"
			"jams  jams";
		gap: var(--spacing-2xs);
	}
	.about__now {
		grid-area: now;
	}
	.about__resume {
		grid-area: resume;
	}
	.c-card {
		background: var(--surface-raised);
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		padding: var(--spacing-s);
		box-shadow: var(--shadow-1);
		display: grid;
		gap: var(--spacing-xs);
		align-content: start;
	}
	.c-card__label {
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--text-muted);
		font-weight: 600;
	}
	.about__now-body {
		font-size: var(--text-step-1);
		text-wrap: pretty;
	}
	.about__resume {
		justify-items: start;
	}
	.about__resume-body {
		color: var(--text-muted);
	}
	.about__toolstack {
		grid-area: tools;
	}
	/* Jams runs the full width below the bento. */
	.about__jams {
		grid-area: jams;
	}

	/* Icon dock — tiles stretch to fill the full card width (auto-fit collapses
	 * the empty tracks, so 11 tiles share the row edge-to-edge on desktop and
	 * wrap into fewer, larger tiles as the card narrows). */
	.about__tools {
		list-style: none;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(4rem, 1fr));
		gap: var(--spacing-2xs);
		margin-top: var(--spacing-3xs);
	}
	.about__tool {
		display: block;
	}
	/* App-icon tile: brand-colour square, white (or dark) brand glyph masked on.
	 * Fills its grid cell, kept square via aspect-ratio. */
	.about__tool-tile {
		display: grid;
		place-items: center;
		width: 100%;
		aspect-ratio: 1;
		border-radius: var(--radius-md);
		background: var(--tile);
		box-shadow: var(--shadow-1);
		transition: transform 0.25s var(--ease-out-expo);
	}
	.about__tool-glyph {
		width: 56%;
		height: 56%;
		background-color: var(--glyph);
		-webkit-mask: var(--icon) center / contain no-repeat;
		mask: var(--icon) center / contain no-repeat;
	}
	@media (hover: hover) {
		.about__tool:hover .about__tool-tile {
			transform: translateY(-3px);
		}
	}
	/* Visually-hidden tool name (accessible label; the tile is title-tooltipped). */
	.about__sr {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
		border: 0;
	}

	.about__jams-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
		gap: var(--spacing-2xs);
	}
	.about__jam {
		border: 0;
		border-radius: var(--radius-md);
		width: 100%;
	}

	/* ── Experience timeline ───────────────────────────────────────────── */
	.about__timeline {
		list-style: none;
		padding: 0;
		display: grid;
		gap: 0;
		/* Rule the whole column runs down. */
		border-left: 1px solid var(--border);
	}
	.about__exp {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 7rem) minmax(0, 1fr) auto;
		/* Period, role and tag share a baseline so the row reads as one line. */
		align-items: baseline;
		column-gap: var(--spacing-l);
		padding: var(--spacing-m) 0 var(--spacing-m) var(--spacing-l);
	}
	.about__exp:not(:last-child) {
		border-bottom: 1px solid var(--border);
	}
	/* Dot sits on the rule, aligned to the role's first line. */
	.about__exp::before {
		content: "";
		position: absolute;
		left: -5px;
		top: calc(var(--spacing-m) + 0.42em);
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: var(--accent);
	}
	.about__exp-period {
		font-size: var(--text-step--1);
		color: var(--text-muted);
		font-variant-numeric: tabular-nums;
	}
	.about__exp-role {
		font-size: var(--text-step-1);
		line-height: 1.1;
	}
	.about__exp-note {
		align-self: center;
		font-size: 0.625rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--text-muted);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		padding: 0.15em 0.6em;
		white-space: nowrap;
	}

	/* ── Contact ───────────────────────────────────────────────────────── */
	.about__contact {
		display: grid;
		justify-items: center;
		text-align: center;
		gap: var(--spacing-s);
		padding: var(--spacing-xl) 0;
	}
	.about__contact-title {
		font-size: var(--text-step-4);
	}
	.about__contact-blurb {
		color: var(--text-muted);
		max-width: 40ch;
	}

	/* ── Responsive ────────────────────────────────────────────────────── */
	/* Stack the hero (gallery drops below the intro) before the columns cramp. */
	@media (max-width: 60rem) {
		.about__hero {
			grid-template-columns: 1fr;
			gap: var(--spacing-l);
		}
		.about__intro {
			max-width: 46ch;
		}
	}
	@media (max-width: 48rem) {
		.about {
			gap: var(--spacing-2xl);
		}
		.about__row {
			grid-template-columns: 1fr;
			gap: var(--spacing-s);
		}
		.about__cards {
			grid-template-columns: 1fr;
			grid-template-areas:
				"now"
				"resume"
				"tools"
				"jams";
		}
		.about__title {
			font-size: var(--text-step-2);
		}
		/* Period on its own line, then role + tag share a row. */
		.about__exp {
			grid-template-columns: 1fr auto;
			column-gap: var(--spacing-s);
			row-gap: var(--spacing-3xs);
		}
		.about__exp-period {
			grid-column: 1 / -1;
		}
	}
</style>

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";
	import { CustomEase } from "gsap/CustomEase";
	import { whenRevealable } from "../lib/page-reveal";

	gsap.registerPlugin(ScrollTrigger, CustomEase);

	const reduced = matchMedia("(prefers-reduced-motion: reduce)");
	const finePointer = matchMedia("(hover: hover) and (pointer: fine)");
	const EASE_OUT =
		CustomEase.get("brand-out") ?? CustomEase.create("brand-out", "0.16,1,0.3,1");

	let triggers: ScrollTrigger[] = [];
	let previewCleanups: (() => void)[] = [];

	function killTriggers() {
		triggers.forEach((t) => t.kill());
		triggers = [];
	}
	function killForumPreviews() {
		previewCleanups.forEach((cleanup) => cleanup());
		previewCleanups = [];
	}

	const reveal = (els: HTMLElement | HTMLElement[]) =>
		gsap.to(els, {
			autoAlpha: 1,
			y: 0,
			duration: 0.8,
			ease: EASE_OUT,
			stagger: 0.08,
			overwrite: true,
			clearProps: "transform",
		});

	function setup() {
		const items = gsap.utils.toArray<HTMLElement>(".js-about-reveal");
		if (!items.length) return;
		killTriggers();
		setupForumPreviews();

		if (reduced.matches) {
			gsap.set(items, { autoAlpha: 1, y: 0, clearProps: "transform" });
			return;
		}

		gsap.set(items, { autoAlpha: 0, y: 40 });

		// ScrollTrigger.batch won't fire onEnter for items ALREADY above the start
		// line at load (the page's intro is in view immediately) — so split the
		// work: reveal what's on-screen now, scroll-reveal the rest per item.
		const threshold = window.innerHeight * 0.9;
		const onLoad: HTMLElement[] = [];
		items.forEach((el) => {
			if (el.getBoundingClientRect().top < threshold) onLoad.push(el);
			else
				triggers.push(
					ScrollTrigger.create({
						trigger: el,
						start: "top 88%",
						once: true,
						onEnter: () => reveal(el),
					}),
				);
		});
		// Hold the in-view reveals AND the layout-heavy ScrollTrigger.refresh until
		// the cross-fade has settled, so neither competes with the transition (the
		// navigation freeze). Below-fold items keep their own scroll triggers (set up
		// above). Resolves immediately on a fresh load, so that path is unchanged.
		whenRevealable().then(() => {
			if (onLoad.length) reveal(onLoad);
			ScrollTrigger.refresh();
		});
	}

	function setupForumPreviews() {
		killForumPreviews();

		const previews = gsap.utils.toArray<HTMLElement>(".js-forum-preview");
		previews.forEach((wrap) => {
			const trigger = wrap.querySelector<HTMLButtonElement>(
				".about__forum-trigger",
			);
			const preview = wrap.querySelector<HTMLElement>(".about__forum-preview");
			const image = wrap.querySelector<HTMLElement>(".about__forum-image");
			if (!trigger || !preview || !image) return;

			const originalParent = preview.parentNode;
			const originalNextSibling = preview.nextSibling;
			let isOpen = false;

			document.body.appendChild(preview);
			gsap.set(preview, { autoAlpha: 0 });
			gsap.set(image, {
				autoAlpha: 0,
				scale: reduced.matches ? 1 : 0.94,
				y: reduced.matches ? 0 : 10,
				filter: reduced.matches ? "none" : "blur(4px)",
				transformOrigin: "18% 100%",
			});

			const showPreview = () => {
				isOpen = true;
				trigger.setAttribute("aria-expanded", "true");

				const linkRect = trigger.getBoundingClientRect();
				const previewWidth = preview.offsetWidth;
				const previewHeight = preview.offsetHeight;
				const margin = 16;
				const gap = 14;
				const preferredX = linkRect.left - previewWidth * 0.18;
				const preferredY =
					linkRect.top >= previewHeight + margin + gap
						? linkRect.top - previewHeight - gap
						: linkRect.bottom + gap;
				const x = Math.min(
					Math.max(preferredX, margin),
					window.innerWidth - previewWidth - margin,
				);
				const y = Math.min(
					Math.max(preferredY, margin),
					window.innerHeight - previewHeight - margin,
				);
				const opensAbove = y < linkRect.top;

				preview.style.setProperty("--preview-x", `${x}px`);
				preview.style.setProperty("--preview-y", `${y}px`);
				gsap.set(image, {
					transformOrigin: opensAbove ? "18% 100%" : "18% 0%",
				});

				gsap.killTweensOf([preview, image]);

				if (reduced.matches) {
					gsap.set(preview, { autoAlpha: 1 });
					gsap.set(image, { autoAlpha: 1, scale: 1, y: 0, filter: "none" });
					return;
				}

				gsap.set(preview, { autoAlpha: 1 });
				gsap.fromTo(
					image,
					{
						autoAlpha: 0,
						scale: 0.94,
						y: 10,
						filter: "blur(4px)",
					},
					{
						autoAlpha: 1,
						scale: 1,
						y: 0,
						filter: "blur(0px)",
						duration: 0.42,
						ease: "power3.out",
						overwrite: true,
					},
				);
			};

			const hidePreview = () => {
				isOpen = false;
				trigger.setAttribute("aria-expanded", "false");

				if (reduced.matches) {
					gsap.set(preview, { autoAlpha: 0 });
					return;
				}

				gsap.killTweensOf([preview, image]);
				gsap.to(image, {
					autoAlpha: 0,
					scale: 0.97,
					y: 6,
					filter: "blur(3px)",
					duration: 0.16,
					ease: "power2.in",
					overwrite: true,
					onComplete: () => {
						if (!isOpen) gsap.set(preview, { autoAlpha: 0 });
					},
				});
			};

			const showOnHover = (event: PointerEvent) => {
				if (event.pointerType === "touch" || !finePointer.matches) return;
				showPreview();
			};

			const hideOnHover = (event: PointerEvent) => {
				if (event.pointerType === "touch" || !finePointer.matches) return;
				hidePreview();
			};

			const showOnFocus = () => {
				if (!finePointer.matches) return;
				showPreview();
			};

			const hideOnBlur = () => {
				if (!finePointer.matches) return;
				hidePreview();
			};

			const togglePreview = (event: MouseEvent) => {
				if (finePointer.matches) return;
				event.preventDefault();
				if (isOpen) hidePreview();
				else showPreview();
			};

			const handleDocumentPointerDown = (event: PointerEvent) => {
				if (!isOpen || wrap.contains(event.target as Node)) return;
				hidePreview();
			};

			const handleKeyDown = (event: KeyboardEvent) => {
				if (event.key !== "Escape" || !isOpen) return;
				hidePreview();
				trigger.focus();
			};

			trigger.addEventListener("pointerenter", showOnHover);
			trigger.addEventListener("focus", showOnFocus);
			trigger.addEventListener("pointerleave", hideOnHover);
			trigger.addEventListener("blur", hideOnBlur);
			trigger.addEventListener("click", togglePreview);
			document.addEventListener("pointerdown", handleDocumentPointerDown);
			document.addEventListener("keydown", handleKeyDown);

			previewCleanups.push(() => {
				trigger.removeEventListener("pointerenter", showOnHover);
				trigger.removeEventListener("focus", showOnFocus);
				trigger.removeEventListener("pointerleave", hideOnHover);
				trigger.removeEventListener("blur", hideOnBlur);
				trigger.removeEventListener("click", togglePreview);
				document.removeEventListener("pointerdown", handleDocumentPointerDown);
				document.removeEventListener("keydown", handleKeyDown);
				gsap.killTweensOf([preview, image]);
				if (originalParent?.isConnected) {
					originalParent.insertBefore(preview, originalNextSibling);
				} else {
					preview.remove();
				}
			});
		});
	}

	document.addEventListener("astro:page-load", setup);
	document.addEventListener("astro:before-swap", () => {
		killTriggers();
		killForumPreviews();
	});
</script>
