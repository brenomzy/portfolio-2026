---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Button from "../components/Button.astro";
import AboutGallery from "../components/AboutGallery.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { SITE_NAME } from "../lib/site";
import { ABOUT } from "../lib/about";

const DESIGN_FORUMS_PHRASE = "design forums";
---

<Base
	title={`About — ${SITE_NAME}`}
	description="About Breno — background, approach, the tools I build with, and what I'm listening to."
>
	<SiteHeader slot="header" />

	<article class="about">
		<!-- Intro + hero gallery --------------------------------------------- -->
		<header class="about__hero">
			<div class="about__intro">
			<h1 class="about__title js-about-reveal" data-reveal>{ABOUT.introTitle}</h1>
			<p class="about__intro-body js-about-reveal" data-reveal>{ABOUT.introBody}</p>
			<p class="about__tenure js-about-reveal" data-reveal>{ABOUT.tenure}</p>
			<SocialLinks class="js-about-reveal" data-reveal />
			</div>

			<AboutGallery />
		</header>

		<!-- Background ------------------------------------------------------- -->
		<section class="about__background">
			<div class="about__background-story">
				<p class="about__background-lead js-about-reveal" data-reveal>
					{ABOUT.background[0]}
				</p>
				<p class="about__background-header-copy js-about-reveal" data-reveal>
					{ABOUT.background[1]}
				</p>

				<figure class="about__relic js-about-reveal" data-reveal>
					<div class="about__relic-bar" aria-hidden="true">
						<span class="about__relic-dots"><i></i><i></i><i></i></span>
						<span class="about__relic-url">http://www.pokeloukos.cjb.net</span>
					</div>
					<div class="about__relic-screen">
						<iframe
							class="about__relic-frame"
							src="/about/pokeloukos/index.html"
							title="Poké Loukos v2.0 — the Pokémon fan site I built in 2004"
							loading="lazy"
							scrolling="no"
						></iframe>
					</div>
					<figcaption class="about__relic-cap">
						My 2004 Pokémon fan site, rebuilt from the Internet Archive.
					</figcaption>
				</figure>
			</div>
			<div class="about__background-chapters">
				{
					ABOUT.background.slice(2).map((para) => {
						const [before, after] = para.split(DESIGN_FORUMS_PHRASE);

						return (
							<p class="about__background-chapter js-about-reveal" data-reveal>
								{after === undefined ? (
									para
								) : (
									<>
										{before}
										<span class="about__forum js-forum-preview">
											<button
												class="about__forum-trigger"
												type="button"
												aria-expanded="false"
												aria-controls="thunder-design-preview"
											>
												{DESIGN_FORUMS_PHRASE}
											</button>
											<span
												class="about__forum-preview"
												id="thunder-design-preview"
												aria-hidden="true"
											>
												<img
													class="about__forum-image"
													src="/about/thunder-design.jpg"
													alt=""
													loading="lazy"
												/>
											</span>
										</span>
										{after}
									</>
								)}
							</p>
						);
					})
				}
				<figure class="about__relics js-about-reveal" data-reveal>
					<div class="about__relics-grid">
						<img
							src="/about/relics/relic1.webp"
							alt="A PixelForge graphic-design community forum layout"
							loading="lazy"
						/>
						<img
							src="/about/relics/relic2.webp"
							alt="A customized digital-art community profile layout"
							loading="lazy"
						/>
						<img
							src="/about/relics/relic3.webp"
							alt="A dark gaming-clan community website layout"
							loading="lazy"
						/>
					</div>
					<figcaption>
						The kinds of community sites, profiles, and clan pages we made for each
						other back then.
					</figcaption>
				</figure>
			</div>
		</section>

		<!-- Experience ------------------------------------------------------- -->
		<section
			class="about__experience"
			aria-labelledby="experience-title"
			data-step-timeline-init
			data-step-timeline-activation="0.5"
		>
			<header class="about__experience-header js-about-reveal" data-reveal>
				<h2 class="about__experience-title" id="experience-title">Where I've been</h2>
				<p class="about__experience-intro">
					A path from product design to specialist Webflow development, with the same
					focus throughout: clear systems, thoughtful details, and work that holds up
					in the real world.
				</p>
			</header>

			<div class="about__timeline-wrap">
				<div class="about__timeline-line" data-step-timeline-line aria-hidden="true">
					<div class="about__timeline-fill" data-step-timeline-fill></div>
				</div>
			<ol class="about__timeline">
				{
					ABOUT.experience.toReversed().map((e, index) => (
						<li class="about__exp" data-step-timeline-item>
							<div class="about__exp-marker" data-step-timeline-marker aria-hidden="true">
								<span>{String(index + 1).padStart(2, "0")}</span>
							</div>
							<div class="about__exp-content">
								<p class="c-meta-label about__exp-period">{e.period}</p>
								<h3 class="about__exp-role">{e.role}</h3>
								<p class="about__exp-org">{e.org}</p>
								<p class="about__exp-description">{e.description}</p>
								{e.note && <p class="about__exp-note">{e.note}</p>}
							</div>
						</li>
					))
				}
			</ol>
			</div>
			<div class="about__experience-cta js-about-reveal" data-reveal>
				<Button
					label="Download résumé"
					href={ABOUT.resumeUrl}
					variant="secondary"
					icon="download"
					download
				/>
			</div>
		</section>

		<!-- A quieter personal-details epilogue ----------------------------- -->
		<section class="about__cards" aria-label="Tools and personal details">
			<div class="c-card about__toolstack js-about-reveal" data-reveal>
				<p class="c-meta-label">Tool stack</p>
				<ul class="about__tools" aria-label="Tools I build with">
					{
						ABOUT.tools.map((t) => (
							<li class="about__tool" title={t.name}>
								<span class="about__tool-tile" style={`--tile: ${t.color}`}>
									<span
										class="about__tool-glyph"
										style={`--icon: url(/tools/${t.icon}); --glyph: ${t.darkGlyph ? "#10151c" : "#fff"}`}
										aria-hidden="true"
									/>
								</span>
								<span class="about__sr">{t.name}</span>
							</li>
						))
					}
				</ul>
			</div>

			<div class="c-card about__jams js-about-reveal" data-reveal>
				<p class="c-meta-label">Some of my favorite songs</p>
				<div class="about__jams-grid">
					{
						ABOUT.jams.map((j) => (
							<div class="about__jam-frame">
								<iframe
									class="about__jam"
									title={`${j.title} by ${j.artist} on Spotify`}
									src={`https://open.spotify.com/embed/track/${j.trackId}?utm_source=generator`}
									width="100%"
									height="152"
									loading="lazy"
									frameborder="0"
									allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
								/>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- Contact ---------------------------------------------------------- -->
		<section class="about__contact js-about-reveal" data-reveal>
			<h2 class="about__contact-title">Let's build something.</h2>
			<p class="about__contact-blurb">{ABOUT.contact.blurb}</p>
			<Button
				label="Get in touch"
				href={`mailto:${ABOUT.contact.email}`}
				variant="primary"
				data-copy-email={ABOUT.contact.email}
			/>
		</section>
	</article>

	<SiteFooter slot="footer" />
</Base>

<style>
	.about {
		--about-section-width: var(--container-content);
		max-width: var(--container-content);
		margin-inline: auto;
		padding-inline: var(--spacing-m);
		display: grid;
		/* Cap the single column at the container width (min 0). Without this the
		 * implicit column is max-content-sized by the horizontally-scrolling photo
		 * strip, blowing the whole page out and breaking its overflow-x scroll. */
		grid-template-columns: minmax(0, 1fr);
		gap: clamp(4.75rem, 4.1rem + 3.2vw, 7rem);
	}

	/* ── Intro ─────────────────────────────────────────────────────────── */
	.about__hero {
		width: 100%;
		max-width: var(--about-section-width);
		margin-inline: auto;
		display: grid;
		grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
		gap: clamp(2.5rem, 1.7rem + 3vw, 4.5rem);
		align-items: center;
		padding-top: var(--spacing-2xl);
	}
	.about__intro {
		display: grid;
		gap: var(--spacing-xs);
		max-width: 42rem;
	}
	.about__title {
		font-size: clamp(2.4rem, 2rem + 1.35vw, 3rem);
		line-height: 1.08;
		letter-spacing: -0.03em;
		max-width: 27ch;
		text-wrap: balance;
	}
	.about__intro-body {
		margin-top: var(--spacing-2xs);
		font-size: clamp(1.125rem, 1.03rem + 0.42vw, 1.35rem);
		line-height: 1.5;
		color: var(--text-muted);
		max-width: 40ch;
		text-wrap: pretty;
	}
	.about__tenure {
		font-size: var(--text-step--1);
		color: var(--text-muted);
	}
	/* Photo strip deferred (Osmo component coming) — markup removed for now. */

	/* ── Content rows ───────────────────────────────────────────────── */
	.about__row {
		width: 100%;
		max-width: var(--about-section-width);
		margin-inline: auto;
	}

	.about__background {
		width: 100%;
		max-width: var(--about-section-width);
		margin-inline: auto;
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
		column-gap: var(--spacing-2xl);
		row-gap: var(--spacing-xl);
		align-items: stretch;
	}
	.about__background-story {
		display: contents;
	}
	.about__background-lead {
		grid-column: 1;
		grid-row: 1;
		font-family: var(--font-heading);
		font-size: clamp(2.25rem, 1.95rem + 1.1vw, 3rem);
		font-weight: 560;
		line-height: 1.08;
		letter-spacing: -0.035em;
		color: var(--text);
		max-width: 20ch;
		text-wrap: balance;
	}
	.about__background-header-copy {
		grid-column: 2;
		grid-row: 1;
		align-self: end;
		max-width: 62ch;
		font-size: clamp(1.0625rem, 1rem + 0.25vw, 1.2rem);
		line-height: 1.65;
		color: var(--text-muted);
		text-wrap: pretty;
	}
	.about__background-chapters {
		grid-column: 2;
		grid-row: 2;
		display: grid;
		grid-template-rows: auto 1fr auto;
		gap: var(--spacing-l);
		min-width: 0;
	}
	.about__background-chapter {
		font-size: clamp(1.0625rem, 1rem + 0.25vw, 1.2rem);
		line-height: 1.65;
		color: var(--text-muted);
		text-wrap: pretty;
	}
	.about__background-chapter:nth-child(2) {
		grid-row: 3;
		align-self: end;
	}
	.about__relics {
		grid-row: 2;
		align-self: center;
		margin: 0;
		padding: var(--spacing-s);
		background: color-mix(in srgb, var(--bg), var(--text) 5%);
		border-radius: var(--radius-lg);
	}
	.about__relics-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--spacing-2xs);
	}
	.about__relics-grid img {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		object-position: top;
		border-radius: var(--radius-md);
		outline: 1px solid rgb(0 0 0 / 0.1);
		outline-offset: -1px;
	}
	:global([data-theme="dark"]) .about__relics-grid img {
		outline-color: rgb(255 255 255 / 0.1);
	}
	.about__relics figcaption {
		margin-top: var(--spacing-xs);
		max-width: 68ch;
		font-size: 0.75rem;
		line-height: 1.45;
		color: var(--text-muted);
		text-wrap: pretty;
	}
	.about__forum {
		position: relative;
		display: inline-block;
	}
	.about__forum-trigger {
		appearance: none;
		border: 0;
		padding: 0;
		background: none;
		font: inherit;
		color: var(--text);
		cursor: pointer;
		text-decoration: underline;
		text-decoration-thickness: 0.08em;
		text-underline-offset: 0.16em;
		text-decoration-color: color-mix(in srgb, var(--accent-ink) 65%, transparent);
		transition:
			color 0.2s ease,
			text-decoration-color 0.2s ease;
	}
	.about__forum-trigger:is(:hover, :focus-visible),
	.about__forum-trigger[aria-expanded="true"] {
		color: var(--accent-ink);
		text-decoration-color: currentColor;
	}
	.about__forum-preview {
		position: fixed;
		z-index: 20;
		left: 0;
		top: 0;
		width: min(28rem, calc(100vw - 2rem), calc((100vh - 2rem) * 902 / 886));
		pointer-events: none;
		visibility: hidden;
		opacity: 0;
		transform: translate3d(var(--preview-x, 0px), var(--preview-y, 0px), 0);
	}
	.about__forum-image {
		display: block;
		width: 100%;
		aspect-ratio: 902 / 886;
		object-fit: cover;
		border-radius: var(--radius-md);
		outline: 1px solid rgb(0 0 0 / 0.1);
		outline-offset: -1px;
		box-shadow: var(--shadow-5);
	}
	[data-theme="dark"] .about__forum-image {
		outline-color: rgb(255 255 255 / 0.1);
	}
	@media (max-width: 48rem) {
		.about__forum-preview {
			width: min(22rem, calc(100vw - 2rem));
		}
	}

	/* ── The relic: an editorial artifact inside the origin story ──────── */
	.about__relic {
		grid-column: 1;
		grid-row: 2;
		margin: 0;
		width: 100%;
		min-width: 0;
	}
	.about__relic-bar {
		display: flex;
		align-items: center;
		gap: var(--spacing-xs);
		padding: 0.5rem 0.7rem;
		background: var(--surface-raised);
		border: 1px solid var(--border);
		border-bottom: 0;
		border-radius: var(--radius-md) var(--radius-md) 0 0;
	}
	.about__relic-dots {
		display: inline-flex;
		gap: 0.4rem;
		flex: none;
	}
	.about__relic-dots i {
		width: 0.7rem;
		height: 0.7rem;
		border-radius: 50%;
		background: var(--border);
	}
	.about__relic-url {
		flex: 1;
		min-width: 0;
		font-family: var(--font-mono);
		font-size: var(--text-step--1);
		color: var(--text-muted);
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		padding: 0.15rem 0.6rem;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	/* The screen is a container; the fixed-size iframe scales to fill it. */
	.about__relic-screen {
		container-type: inline-size;
		/* Match the rebuilt page's complete 780×785 canvas so the artifact is fully
		 * visible without an internal scroll or a separate destination. */
		aspect-ratio: 780 / 785;
		overflow: hidden;
		border: 1px solid var(--border);
		border-radius: 0 0 var(--radius-md) var(--radius-md);
		background: #b40000;
	}
	.about__relic-frame {
		display: block;
		width: 780px;
		height: 785px;
		border: 0;
		transform-origin: top left;
		transform: scale(calc(100cqw / 780px));
	}
	.about__relic-cap {
		margin-top: var(--spacing-xs);
		text-align: left;
		font-size: 0.72rem;
		color: var(--text-muted);
		max-width: none;
		white-space: nowrap;
	}

	/* ── Fact cards ────────────────────────────────────────────────────── */
	.about__cards {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--spacing-l);
		width: 100%;
		max-width: var(--about-section-width);
		margin-inline: auto;
		padding-block: var(--spacing-l);
		border-block: 1px solid var(--border);
	}
	.c-card {
		display: grid;
		gap: var(--spacing-xs);
		align-content: start;
	}
	/* Icon dock — tiles stretch to fill the full card width (auto-fit collapses
	 * the empty tracks, so 11 tiles share the row edge-to-edge on desktop and
	 * wrap into fewer, larger tiles as the card narrows). */
	.about__tools {
		list-style: none;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-2xs);
		margin-top: var(--spacing-3xs);
	}
	.about__tool {
		display: block;
	}
	/* App-icon tile: brand-colour square, white (or dark) brand glyph masked on.
	 * Fills its grid cell, kept square via aspect-ratio. */
	.about__tool-tile {
		display: grid;
		place-items: center;
		width: 3.75rem;
		aspect-ratio: 1;
		border-radius: var(--radius-md);
		background: var(--tile);
		box-shadow: var(--shadow-1);
		transition: transform 0.25s var(--ease-out-expo);
	}
	.about__tool-glyph {
		width: 56%;
		height: 56%;
		background-color: var(--glyph);
		-webkit-mask: var(--icon) center / contain no-repeat;
		mask: var(--icon) center / contain no-repeat;
	}
	@media (hover: hover) and (pointer: fine) {
		.about__tool:hover .about__tool-tile {
			transform: translateY(-3px);
		}
	}
	/* Visually-hidden tool name (accessible label; the tile is title-tooltipped). */
	.about__sr {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
		border: 0;
	}

	.about__jams-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
		gap: var(--spacing-2xs);
	}
	.about__jam-frame {
		position: relative;
		height: 152px;
		border-radius: var(--radius-md);
		overflow: hidden;
	}
	/* Cover only Spotify's light perimeter in dark mode. Unlike oversizing the
	 * iframe, this leaves the full player—including its bottom controls—intact. */
	:global([data-theme="dark"]) .about__jam-frame::after {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: inherit;
		box-shadow: inset 0 0 0 1px var(--bg);
		pointer-events: none;
	}
	.about__jam {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}

	/* ── Experience timeline ───────────────────────────────────────────── */
	.about__experience {
		width: 100%;
		max-width: var(--about-section-width);
		margin-inline: auto;
		display: grid;
		grid-template-columns: minmax(18rem, 4fr) minmax(0, 8fr);
		column-gap: var(--spacing-xl);
		align-items: start;
	}
	.about__experience-header {
		position: sticky;
		top: 7rem;
		display: grid;
		grid-template-columns: 1fr;
		align-items: start;
		gap: var(--spacing-s);
		max-width: none;
		margin-bottom: 0;
	}
	.about__experience-title {
		font-size: clamp(2.25rem, 1.95rem + 1vw, 3rem);
		line-height: 1.08;
		letter-spacing: -0.035em;
		text-wrap: balance;
		white-space: nowrap;
	}
	.about__experience-intro {
		max-width: 40ch;
		color: var(--text-muted);
		font-size: clamp(1rem, 0.97rem + 0.12vw, 1.0625rem);
		line-height: 1.6;
		text-wrap: pretty;
	}
	.about__timeline-wrap {
		position: relative;
		grid-column: 2;
	}
	.about__experience-cta {
		grid-column: 2;
		display: flex;
		justify-content: flex-start;
		margin-top: var(--spacing-xl);
		padding-left: calc(3rem + var(--spacing-l));
	}
	.about__timeline {
		list-style: none;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-xl);
	}
	.about__exp {
		position: relative;
		display: flex;
		align-items: flex-start;
		gap: var(--spacing-l);
	}
	.about__timeline-line {
		pointer-events: none;
		position: absolute;
		left: calc(1.5rem - 1px);
		width: 2px;
		background: var(--border);
	}
	.about__timeline-fill {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		transform-origin: 50% 0;
		background: var(--accent);
	}
	.about__exp-marker {
		position: relative;
		z-index: 1;
		display: grid;
		place-items: center;
		flex: 0 0 auto;
		width: 3rem;
		height: 3rem;
		border: 1px solid var(--border);
		border-radius: 50%;
		background: var(--surface);
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-variant-numeric: tabular-nums;
		transition-property: color, background-color, border-color, box-shadow;
		transition-duration: 0.24s;
		transition-timing-function: var(--ease-out-expo);
	}
	[data-step-timeline-item][data-status="active"] .about__exp-marker {
		color: var(--surface);
		background: var(--accent);
		border-color: var(--accent);
	}
