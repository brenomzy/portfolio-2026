---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Hero from "../components/Hero.astro";
import WorkSection from "../components/WorkSection.astro";
import ProjectModal from "../components/ProjectModal.astro";
import { WORK_PROJECTS } from "../lib/work-projects";
import { SITE_TITLE, SITE_DESCRIPTION } from "../lib/site";
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<SiteHeader slot="header" />

	<Hero />

	<WorkSection projects={WORK_PROJECTS} />

	<SiteFooter slot="footer" />
	<!-- Outside #main (slot=footer) so the modal isn't trapped in #main's
	     stacking context — and so scaling #main on open doesn't scale it. -->
	<ProjectModal slot="footer" projects={WORK_PROJECTS} />
</Base>
