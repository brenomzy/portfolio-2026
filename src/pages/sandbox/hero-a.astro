---
import Base from "../../layouts/Base.astro";
import ThemeToggle from "../../components/ThemeToggle.astro";
---

<Base title="Hero A — Editorial">
	<header class="bar" slot="header">
		<a class="bar__brand" href="/sandbox">breno daroz</a>
		<div class="bar__meta">
			<span class="bar__status"><span class="bar__dot"></span>Available for work</span>
			<time class="bar__clock js-clock">—</time>
		</div>
		<nav class="bar__nav" aria-label="Primary">
			<a href="#">Work</a>
			<a href="#">About</a>
			<a href="#">Contact</a>
			<ThemeToggle />
		</nav>
	</header>

	<section class="heroA">
		<p class="heroA__eyebrow">Webflow Developer — Brazil</p>
		<h1 class="heroA__title">
			Bridging design and code to craft
			<span class="heroA__accent">high-quality</span> websites.
		</h1>
		<p class="heroA__lead">
			I'm Breno — I turn design into fast, accessible, hand-built websites.
			Currently at BX Studio, and open to select freelance work.
		</p>
		<div class="heroA__actions">
			<a class="btn btn--solid" href="#">Get in touch</a>
			<a class="btn btn--ghost" href="#">View work ↗</a>
		</div>
	</section>
</Base>

<style>
	.bar {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: var(--spacing-m);
		max-width: var(--container-content);
		margin-inline: auto;
		padding: var(--spacing-s) var(--spacing-m);
		font-size: var(--text-step--1);
	}
	.bar__brand {
		font-weight: 600;
		text-decoration: none;
		justify-self: start;
	}
	.bar__meta {
		display: flex;
		gap: var(--spacing-m);
		color: var(--text-muted);
		font-family: var(--font-mono);
		white-space: nowrap;
	}
	.bar__status {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
	}
	.bar__dot {
		width: 0.5em;
		height: 0.5em;
		border-radius: 50%;
		background: #22c55e;
		box-shadow: 0 0 0 0 #22c55e80;
		animation: pulse 2s infinite;
	}
	@keyframes pulse {
		0% { box-shadow: 0 0 0 0 #22c55e80; }
		70% { box-shadow: 0 0 0 0.5em #22c55e00; }
		100% { box-shadow: 0 0 0 0 #22c55e00; }
	}
	.bar__nav {
		display: flex;
		align-items: center;
		gap: var(--spacing-s);
		justify-self: end;
	}
	.bar__nav a {
		text-decoration: none;
		color: var(--text-muted);
	}
	.bar__nav a:hover {
		color: var(--text);
	}

	.heroA {
		max-width: var(--container-content);
		margin-inline: auto;
		padding: clamp(3rem, 12vh, 9rem) var(--spacing-m);
		display: grid;
		gap: var(--spacing-m);
	}
	.heroA__eyebrow {
		font-family: var(--font-mono);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: var(--text-step--1);
		color: var(--accent-ink);
	}
	.heroA__title {
		font-size: var(--text-step-6);
		font-weight: 540;
		letter-spacing: -0.02em;
		max-width: 18ch;
	}
	.heroA__accent {
		font-family: var(--font-serif);
		font-weight: 400;
		font-style: italic;
		color: var(--accent-ink);
		letter-spacing: 0;
	}
	.heroA__lead {
		font-size: var(--text-step-1);
		color: var(--text-muted);
		max-width: 46ch;
	}
	.heroA__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-s);
		margin-top: var(--spacing-s);
	}

	.btn {
		display: inline-flex;
		align-items: center;
		padding: 0.7em 1.4em;
		border-radius: 100px;
		text-decoration: none;
		font-weight: 500;
		transition: transform 0.2s var(--ease-out-expo);
	}
	.btn:hover {
		transform: translateY(-2px);
	}
	.btn--solid {
		background: var(--text);
		color: var(--bg);
	}
	.btn--ghost {
		border: 1px solid var(--border);
		color: var(--text);
	}
</style>

<script>
	function tick() {
		const el = document.querySelector(".js-clock");
		if (!el) return;
		const time = new Intl.DateTimeFormat("en-GB", {
			hour: "2-digit",
			minute: "2-digit",
			timeZone: "America/Sao_Paulo",
		}).format(new Date());
		el.textContent = `São Paulo — ${time}`;
	}
	document.addEventListener("astro:page-load", () => {
		tick();
		setInterval(tick, 30000);
	});
</script>
