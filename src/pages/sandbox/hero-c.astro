---
import Base from "../../layouts/Base.astro";
import ThemeToggle from "../../components/ThemeToggle.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { sanityClient } from "../../lib/sanity/client";
import { PROJECTS_QUERY } from "../../lib/sanity/queries";

const projects = await sanityClient.fetch(PROJECTS_QUERY);
const featured = (projects.filter((p) => p.featured).length
	? projects.filter((p) => p.featured)
	: projects
).slice(0, 2);
---

<Base title="Hero C — Work-forward">
	<header class="barC" slot="header">
		<a class="barC__brand" href="/sandbox">breno daroz</a>
		<nav class="barC__nav" aria-label="Primary">
			<a href="#">Work</a>
			<a href="#">About</a>
			<a href="#">Contact</a>
			<ThemeToggle />
		</nav>
	</header>

	<section class="heroC">
		<div class="heroC__intro">
			<h1 class="heroC__title">
				Bridging design and code into websites that
				<span class="heroC__accent">grow with you.</span>
			</h1>
			<p class="heroC__lead">
				Webflow developer from Brazil. I design and build fast, accessible,
				high-craft sites — here's a few of them.
			</p>
		</div>

		{
			featured.length > 0 ? (
				<ul class="heroC__grid">
					{featured.map((project) => (
						<li>
							<ProjectCard project={project} />
						</li>
					))}
				</ul>
			) : (
				<p class="heroC__empty">Add projects in the Studio to see them here.</p>
			)
		}
	</section>
</Base>

<style>
	.barC {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: var(--container-content);
		margin-inline: auto;
		padding: var(--spacing-s) var(--spacing-m);
	}
	.barC__brand {
		font-weight: 600;
		text-decoration: none;
	}
	.barC__nav {
		display: flex;
		align-items: center;
		gap: var(--spacing-s);
	}
	.barC__nav a {
		text-decoration: none;
		color: var(--text-muted);
	}

	.heroC {
		max-width: var(--container-content);
		margin-inline: auto;
		padding: var(--spacing-xl) var(--spacing-m);
		display: grid;
		gap: var(--spacing-xl);
	}
	.heroC__title {
		font-size: var(--text-step-5);
		font-weight: 540;
		letter-spacing: -0.02em;
		max-width: 20ch;
	}
	.heroC__accent {
		font-family: var(--font-serif);
		font-style: italic;
		font-weight: 400;
		color: var(--accent-ink);
	}
	.heroC__lead {
		margin-top: var(--spacing-s);
		font-size: var(--text-step-1);
		color: var(--text-muted);
		max-width: 48ch;
	}
	.heroC__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(22rem, 100%), 1fr));
		gap: var(--spacing-l);
		list-style: none;
		padding: 0;
	}
	.heroC__empty {
		color: var(--text-muted);
	}
</style>
