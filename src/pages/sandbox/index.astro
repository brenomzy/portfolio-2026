---
import Base from "../../layouts/Base.astro";
import ThemeToggle from "../../components/ThemeToggle.astro";

const variants = [
	{ href: "/sandbox/hero-a", name: "Hero A — Editorial", note: "Mono eyebrow, big grotesk + serif-italic accent, metadata bar with live time. Light-first, lots of whitespace." },
	{ href: "/sandbox/hero-b", name: "Hero B — Bold", note: "Always-dark, bright orange, condensed headline, ASCII-art visual. The GOOD direction." },
	{ href: "/sandbox/hero-c", name: "Hero C — Work-forward", note: "Headline + your selected work cards right in the hero. Shows the work immediately." },
];
---

<Base title="Hero sandbox">
	<header class="s-bar" slot="header">
		<span class="s-bar__brand">Hero sandbox</span>
		<ThemeToggle />
	</header>
	<section class="s-list">
		<p class="s-list__intro">Three hero directions to compare. Toggle light/dark on each.</p>
		<ul>
			{variants.map((v) => (
				<li class="s-card">
					<a href={v.href}>{v.name} →</a>
					<p>{v.note}</p>
				</li>
			))}
		</ul>
	</section>
</Base>

<style>
	.s-bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		max-width: 60rem;
		margin-inline: auto;
		padding: var(--spacing-s) var(--spacing-m);
	}
	.s-bar__brand { font-family: var(--font-mono); }
	.s-list {
		max-width: 60rem;
		margin-inline: auto;
		padding: var(--spacing-xl) var(--spacing-m);
		display: grid;
		gap: var(--spacing-m);
	}
	.s-list__intro { color: var(--text-muted); }
	.s-list ul { list-style: none; padding: 0; display: grid; gap: var(--spacing-m); }
	.s-card {
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		padding: var(--spacing-m);
	}
	.s-card a {
		font-size: var(--text-step-2);
		font-weight: 600;
		text-decoration: none;
		color: var(--accent-ink);
	}
	.s-card p { color: var(--text-muted); margin-top: var(--spacing-2xs); }
</style>
