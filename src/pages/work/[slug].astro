---
/*
 * Project deep link. Renders the FULL home shell (hero + work grid + footer)
 * with ProjectModal server-rendered already OPEN and filled with this project.
 *
 * Why the whole home behind it: closing the modal then just reveals the page
 * that's already there (URL rewritten to "/" in JS — no reload), so a shared
 * link feels identical to opening the modal from the grid. The project's content
 * lives in the modal markup, so crawlers / no-JS visitors get real content + a
 * working close link to home. Source of truth: local WORK_PROJECTS (no CMS).
 */
import Base from "../../layouts/Base.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import Hero from "../../components/Hero.astro";
import WorkSection from "../../components/WorkSection.astro";
import ProjectModal from "../../components/ProjectModal.astro";
import { WORK_PROJECTS, getProjectBySlug } from "../../lib/work-projects";

export function getStaticPaths() {
	return WORK_PROJECTS.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const project = getProjectBySlug(slug!);

if (!project) {
	return Astro.rewrite("/404");
}
---

<Base
	title={`${project.title} — Work`}
	description={project.description}
>
	<SiteHeader slot="header" />

	<Hero />

	<WorkSection projects={WORK_PROJECTS} />

	<SiteFooter slot="footer" />
	<ProjectModal
		slot="footer"
		projects={WORK_PROJECTS}
		initialProject={project}
	/>
</Base>
