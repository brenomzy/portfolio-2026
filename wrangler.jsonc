{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Cloudflare Workers (Static Assets) config. The site is a STATIC Astro build
	// (output: "static"), so there's no Worker script and no SSR adapter — Wrangler
	// just uploads the build output and serves it. `name` matches the existing
	// Workers project so `wrangler deploy` publishes to the same app + domain.
	"name": "portfolio-2026",
	"compatibility_date": "2026-06-24",
	"assets": {
		"directory": "./dist"
	}
}
